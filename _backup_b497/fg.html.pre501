<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0F172A">
<title>FG Stock</title>
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="/fnbar.js"></script>
<style>
:root{--ink:#202020;--ink2:#475569;--line:#E2E8F0;--soft:#F1F5F9;--bg:#F1F5F9;--card:#fff;--blue:#1B75BC;--blue2:#D9E6F2;--orange:#F97316;--navy:#1E293B;
  --ok:#166534;--okbg:#DCFCE7;--okc:#16A34A;--warn:#92400E;--warnbg:#FEF3C7;--bad:#991B1B;--badbg:#FEE2E2;--badc:#DC2626;--pur:#7C3AED}
*{box-sizing:border-box}
body{margin:0;background:linear-gradient(180deg,#E4E9F1 0%,#F1F5F9 360px) no-repeat #F1F5F9;color:var(--navy);font:15px/1.45 "Sarabun",system-ui,-apple-system,"Segoe UI",Tahoma,sans-serif}
button,input,select,textarea{font:inherit;color:inherit}
a{color:var(--blue)}
.hidden{display:none!important}
header.top{position:sticky;top:0;z-index:5;background:var(--ink);color:#fff;display:flex;align-items:center;gap:10px;padding:8px 14px;min-height:56px}
header.top .brand{font-weight:700;font-size:17px;display:flex;align-items:center;gap:8px}
header.top .sp{flex:1}
header.top .who{font-size:13px;color:#CBD5E1;text-align:right;line-height:1.2}
.rchip{font-size:12px;font-weight:700;padding:4px 10px;border-radius:99px;color:#fff;white-space:nowrap}
.tbtn{background:#333;border:0;color:#fff;border-radius:8px;padding:8px 10px;min-height:40px;cursor:pointer;font-size:13px}
.layout{display:flex;min-height:calc(100vh - 56px)}
nav.side{width:220px;flex:none;background:#202020;color:#E2E8F0;padding:10px;display:flex;flex-direction:column;gap:2px}
nav.side .grp{padding:14px 12px 4px;font-size:11px;letter-spacing:.06em;color:#94A3B8}
nav.side button{display:flex;align-items:center;gap:10px;text-align:left;background:none;border:0;border-radius:9px;padding:10px 12px;cursor:pointer;color:#9AA0A6;font-weight:500;position:relative;font-size:14px;white-space:nowrap;min-height:42px}
nav.side button>span:not(.bdg){flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis}
nav.side button.on{background:#2a2a2a;color:var(--orange);font-weight:600}
nav.side button.on::before{content:'';position:absolute;left:0;top:7px;bottom:7px;width:3px;border-radius:0 3px 3px 0;background:var(--orange)}
nav.side button:hover{background:#2a2a2a;color:#E3E6EA}
nav.side .bdg{margin-left:auto;background:#F59E0B;color:#0F172A;border-radius:99px;padding:0 8px;font-size:12px;font-weight:700}
main{flex:1;min-width:0;padding:20px 24px 28px}
nav.bot{display:none}
.ic{width:20px;height:20px;flex:none}
h1{font-size:22px;font-weight:600;margin:0 0 4px;line-height:1.3}
.sub{color:var(--ink2);font-size:14px;margin:0 0 14px}
h2{font-size:16px;margin:0 0 10px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px}
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:16px}
.tile{border-radius:12px;padding:14px 16px;color:#fff;cursor:pointer;border:0;text-align:left}
.tile .l{font-size:13px}.tile .v{font-size:28px;font-weight:700}.tile .s{font-size:12px;opacity:.92}
table{width:100%;border-collapse:collapse;font-size:13.5px}
th{text-align:left;color:#475569;font-weight:600;font-size:12.5px;padding:9px 8px;background:#F8FAFC;border-bottom:1px solid var(--line);white-space:nowrap;position:sticky;top:0;z-index:1}
td{padding:9px 10px;border-top:1px solid var(--line);vertical-align:middle}
tr.sel td{background:#EFF6FF}
tr.click{cursor:pointer}tr.click:hover td{background:#F8FAFC}
.tw{overflow:auto;max-height:70vh;border:1px solid var(--line);border-radius:12px;background:#fff}
.r{text-align:right;white-space:nowrap}.nw{white-space:nowrap}
.mono{font-family:ui-monospace,Consolas,monospace}
.muted{color:var(--ink2);font-size:12.5px}
.pill{display:inline-block;padding:2px 9px;border-radius:6px;font-size:12px;font-weight:700;white-space:nowrap}
.p-waiting{background:var(--warnbg);color:var(--warn)}.p-confirmed{background:var(--okbg);color:var(--ok)}.p-rejected,.p-sentback{background:var(--badbg);color:var(--bad)}
.p-packed{background:var(--blue2);color:#1E3A8A}.p-cancelled{background:#E2E8F0;color:#475569}.p-moved_to_fg{background:var(--okbg);color:var(--ok)}.p-rejected_by_fg{background:var(--badbg);color:var(--bad)}
.btn{border:1px solid #CBD5E1;background:#fff;border-radius:8px;padding:0 16px;min-height:40px;cursor:pointer;font-weight:500;font-size:14px;display:inline-flex;align-items:center;justify-content:center;gap:6px;white-space:nowrap;color:#1E293B}
.btn:hover:not(:disabled){border-color:var(--blue);color:var(--blue)}.btn.pri:hover:not(:disabled),.btn.ok:hover:not(:disabled),.btn.bad:hover:not(:disabled){color:#fff;filter:brightness(1.06)}
.btn.pri{background:var(--blue);border-color:var(--blue);color:#fff}
.btn.ok{background:var(--okc);border-color:var(--okc);color:#fff}
.btn.bad{background:var(--badc);border-color:var(--badc);color:#fff}
.btn.badl{border-color:var(--badc);color:#B91C1C}
.btn.big{width:100%;min-height:56px;font-size:17px}
.btn:disabled{background:#E2E8F0;border-color:#E2E8F0;color:#64748B;cursor:not-allowed}
.btns{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end}
.bar{display:flex;flex-wrap:wrap;gap:10px 12px;align-items:flex-end;margin-bottom:14px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:12px 14px}
label.f{display:flex;flex-direction:column;gap:4px;font-size:12.5px;font-weight:500;color:#475569}
.in{border:1px solid #CBD5E1;border-radius:8px;padding:0 10px;height:40px;min-height:40px;background:#fff;font-size:14.5px;color:var(--navy)}
textarea.in{height:auto;padding:8px 10px}.in:focus{outline:2px solid #BFDBFE;border-color:var(--blue)}
.in.sm{height:34px;min-height:34px;font-size:13.5px}
input.in,select.in{width:100%}
.bar .in{width:auto}
.msg{border-radius:10px;padding:10px 12px;font-weight:600;margin:10px 0}
.m-ok{background:var(--okbg);color:var(--ok)}.m-bad{background:var(--badbg);color:var(--bad)}.m-warn{background:var(--warnbg);color:var(--warn)}.m-info{background:var(--blue2);color:#1E3A8A}
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.tab{border:1px solid #CBD5E1;background:#fff;border-radius:8px;padding:8px 16px;min-height:42px;cursor:pointer;font-weight:600}
.tab.on{background:var(--blue);border-color:var(--blue);color:#fff}
/* phone */
.ph{max-width:560px;margin:0 auto}
.scanbig{width:100%;min-height:120px;border:0;border-radius:16px;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;font-size:20px;font-weight:700;cursor:pointer}
.scanbig svg{width:42px;height:42px}
/* b497 packing checker: USB scanner box + verify card */
.usbw{border:2px dashed #CBD5E1;border-radius:16px;padding:18px;background:#fff;margin:10px 0 14px;text-align:center}
.usbw.on{border-color:#16A34A;background:#F0FDF4}
.usbw .st{font-weight:700;font-size:15px;margin-bottom:10px;color:#64748B;display:flex;align-items:center;justify-content:center;gap:8px}
.usbw.on .st{color:#15803D}.usbw .st i{width:12px;height:12px;border-radius:6px;background:#94A3B8;display:inline-block}
.usbw.on .st i{background:#22C55E;box-shadow:0 0 0 4px #BBF7D0;animation:usbp 1.4s infinite}
@keyframes usbp{50%{box-shadow:0 0 0 7px #DCFCE7}}
.usbw input{width:100%;height:52px;font-size:17px;text-align:center;border:1px solid #CBD5E1;border-radius:10px;font-family:inherit}
.vgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:8px;margin:10px 0}
.vgrid div{background:#fff;border:1px solid var(--line);border-radius:10px;padding:8px 12px}.vgrid small{display:block;color:var(--ink2);font-size:12px}
.vgrid b{font-size:16px;font-weight:600;word-break:break-word}.vgrid .big b{font-size:20px}
.st3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:14px}
.st3>div{border-radius:12px;padding:12px;color:#fff}.st3 b{display:block;font-size:26px}.st3 span{font-size:12px}
.li{background:#fff;border:1px solid var(--line);border-radius:12px;padding:12px 14px;display:flex;align-items:center;gap:10px;margin-bottom:8px}
.li .t{flex:1;min-width:0}.li .t b{display:block}.li .t span{font-size:13px;color:var(--ink2);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hd{background:#fff;border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin-bottom:10px}
.hd .a{font-size:18px;font-weight:700}
.ck{background:#fff;border:2px solid var(--line);border-radius:12px;padding:10px 12px;margin-bottom:8px}
.ck.ok{border-color:#86EFAC}.ck.ng{border-color:#FCA5A5}
.ck .rw{display:flex;align-items:center;gap:8px}
.ck .t{flex:1;min-width:0}.ck .t small{display:block;color:#64748B;font-size:12px}.ck .t b{font-size:16px;word-break:break-word}
.ckb{width:58px;height:46px;border-radius:10px;border:1px solid #CBD5E1;background:#F8FAFC;font-weight:700;cursor:pointer;color:#334155}
.ck.ok .ckb.o{background:var(--okc);border-color:var(--okc);color:#fff}
.ck.ng .ckb.n{background:var(--badc);border-color:var(--badc);color:#fff}
.ck input{margin-top:8px;width:100%;border:1px solid #FCA5A5;background:#FEF2F2;border-radius:8px;padding:9px 10px;font-size:14px}
.foot{position:sticky;bottom:0;background:#fff;border-top:1px solid var(--line);padding:12px 0 calc(12px + env(safe-area-inset-bottom));display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.foot .btn{min-height:54px;font-size:17px}
.done{text-align:center;padding:30px 10px}
.done .c{width:88px;height:88px;border-radius:44px;margin:0 auto 14px;display:flex;align-items:center;justify-content:center}
/* modal + scanner */
.ov{position:fixed;inset:0;background:rgba(10,15,20,.55);z-index:20;display:flex;align-items:center;justify-content:center;padding:16px}
.modal{background:#fff;border-radius:14px;max-width:720px;width:100%;max-height:90vh;overflow:auto;padding:18px}
.scan{position:fixed;inset:0;background:#000;z-index:30;display:flex;flex-direction:column}
.scan video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.scan .fr{position:absolute;left:50%;top:42%;width:min(70vw,320px);height:min(70vw,320px);transform:translate(-50%,-50%);border:3px solid #7FD1F5;border-radius:16px;box-shadow:0 0 0 2000px rgba(0,0,0,.35)}
.scan .fr.lock{border-color:#4ADE80}
.scan .hint{position:absolute;left:0;right:0;top:calc(42% + min(35vw,160px) + 16px);text-align:center;color:#fff;font-weight:600;padding:0 16px}
.scan .bt{position:absolute;left:0;right:0;bottom:0;padding:16px;display:flex;flex-direction:column;gap:8px;background:linear-gradient(transparent,rgba(0,0,0,.7))}
.scan .bt .btn{background:#fff}
.kv{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid #EEF2F6;font-size:14px}.kv:last-child{border-bottom:0}.kv span{color:var(--ink2)}.kv b{text-align:right;font-weight:600}
.card.ro{padding:6px 14px}
.tl{list-style:none;margin:0;padding:0 0 0 14px;border-left:2px solid #CFE2F5}.tl li{position:relative;padding:0 0 12px 10px;display:flex;flex-direction:column;gap:1px}
.tl li:before{content:"";position:absolute;left:-21px;top:4px;width:10px;height:10px;border-radius:5px;background:#1B75BC;border:2px solid #fff}
.tl b{font-size:14px;font-weight:600}.tl span{font-size:12px;color:var(--ink2)}.tl em{font-style:normal;font-size:13px;color:#334155}
.stp{display:flex;gap:6px;margin:0 0 10px}.stp span{flex:1;text-align:center;font-size:12px;padding:6px 4px;border-radius:8px;background:#EEF2F6;color:#64748B;font-weight:600}
.stp span.on{background:#EDE9FE;color:#5B21B6}.stp span.cur{background:#7C3AED;color:#fff}
/* pager (b485) */
.xpg{display:flex;align-items:center;gap:4px;padding:10px 14px;font-size:12.5px;color:var(--ink2)}
.xpg button{min-width:32px;height:32px;border:1px solid #CBD5E1;background:#fff;border-radius:7px;font:inherit;font-size:13px;cursor:pointer;color:#334155}
.xpg button.on{background:var(--blue);border-color:var(--blue);color:#fff;font-weight:600}.xpg button:disabled{opacity:.4;cursor:default}.xpg em{font-style:normal;padding:0 2px}
/* loading placeholder (b481) */
.skel{display:grid;gap:10px}.skel i{display:block;height:14px;border-radius:6px;background:linear-gradient(90deg,#EEF2F6 25%,#F8FAFC 50%,#EEF2F6 75%);background-size:400% 100%;animation:sk 1.2s infinite}
.skel i:nth-child(2){width:85%}.skel i:nth-child(3){width:92%}.skel i:nth-child(4){width:60%}
@keyframes sk{0%{background-position:100% 0}100%{background-position:0 0}}
/* Excel-style table + type-ahead (b480) */
.xbar{display:flex;align-items:center;gap:10px;font-size:12.5px;color:var(--ink2);margin:0 2px 6px}
.xt table{border-collapse:collapse;font-size:13px}
.xt th,.xt td{border:1px solid #DCE3EB;padding:5px 8px;line-height:1.3;white-space:nowrap}
.xt td .muted{display:block;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px}
.pc .xbar{padding:8px 16px 0}.pc .xt{border:0;border-radius:0;border-top:1px solid var(--line)}.pc .xt table{min-width:0}.pc .xt td,.pc .xt th{padding:5px 8px}
.xt th{background:#EEF2F6;color:#334155;font-weight:600;font-size:12.5px;padding:0;border-top:0}
.xt th:first-child,.xt td:first-child{border-left:0}.xt th:last-child,.xt td:last-child{border-right:0}
.xt tbody tr:nth-child(even) td{background:#FAFCFE}.xt tbody tr:hover td{background:#EEF6FD}
.xt tr.sel td{background:#E3F0FB!important}
.xt tfoot td{background:#F1F5F9;font-weight:600;position:sticky;bottom:0}
.xh{display:flex;align-items:center;gap:2px;padding:7px 6px 7px 8px}.xt th.r .xh{justify-content:flex-end}
.xl{cursor:pointer;flex:1;user-select:none;white-space:nowrap}.xt th.r .xl{text-align:right}
.xf{border:1px solid transparent;background:none;border-radius:4px;width:22px;height:22px;cursor:pointer;color:#64748B;font-size:12px;padding:0;flex:none}
.xf:hover{border-color:#CBD5E1;background:#fff}.xf.on{background:var(--blue);color:#fff}
.xfp{position:fixed;z-index:60;width:284px;background:#fff;border:1px solid #CBD5E1;border-radius:10px;box-shadow:0 10px 30px rgba(15,23,42,.18);padding:10px}
.xfl{max-height:260px;overflow:auto;border:1px solid var(--line);border-radius:8px;margin-top:6px;padding:4px 0}
.xfl label{display:flex;gap:8px;align-items:center;padding:4px 10px;font-size:13px;cursor:pointer}.xfl label:hover{background:#F1F5F9}
.xfl label span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.xfl em{font-style:normal;color:#94A3B8;font-size:11.5px}
.btn.sm{min-height:30px;height:30px;padding:0 10px;font-size:12.5px}
.tadd{position:fixed;z-index:70;background:#fff;border:1px solid #CBD5E1;border-radius:8px;box-shadow:0 10px 28px rgba(15,23,42,.16);max-height:320px;overflow:auto;padding:4px 0}
.tadi{padding:7px 12px;cursor:pointer;display:flex;flex-direction:column;gap:1px}.tadi b{font-weight:600;font-size:13.5px;color:#0F172A}.tadi span{font-size:12px;color:#64748B;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tadi.on,.tadi:hover{background:#EEF6FD}
/* paper form print */
.paper{display:none}
@media print{
  header.top,nav.side,nav.bot,#fnbar,main>*:not(.paper),.noprint{display:none!important}
  main{padding:0;max-width:none}body{background:#fff}.layout{display:block;min-height:0}
  .paper{display:block!important;font-size:10.5px}
  body>*:not(.layout),.layout>*:not(main){display:none!important}html,body{height:auto!important;min-height:0!important}main{margin:0!important;min-height:0!important;padding:0!important}
  .paper .pg{page-break-after:always;break-after:page;height:180mm;display:flex;flex-direction:column;overflow:hidden}
  .paper .pg:last-child{page-break-after:auto;break-after:auto}
  .paper table{font-size:10px;table-layout:fixed;width:100%}
  .paper th,.paper td{border:1px solid #000;padding:1px 3px;background:#fff;position:static;height:6.2mm;line-height:1.15;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
  .paper th{height:auto;white-space:normal;color:#000;font-weight:600}
  .paper .sg{margin-top:auto;display:flex;justify-content:space-around;padding-top:6mm;break-inside:avoid}
  @page{size:A4 landscape;margin:8mm 10mm}
}
@media (max-width:820px){
  nav.side{display:none}
  main{padding:12px 12px 90px}
  nav.bot{display:flex;position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid var(--line);z-index:6;padding-bottom:env(safe-area-inset-bottom)}
  nav.bot button{flex:1;background:none;border:0;padding:8px 2px 10px;font-size:11px;display:flex;flex-direction:column;align-items:center;gap:2px;color:var(--ink2);min-height:56px;cursor:pointer}
  nav.bot button.on{color:var(--blue);font-weight:700}
  header.top .who{display:none}
  .hide-m{display:none}
  .tiles{grid-template-columns:repeat(2,1fr)}
  .foot{bottom:calc(56px + env(safe-area-inset-bottom));padding-bottom:12px}
  .btn{min-height:44px}.in{height:44px;min-height:44px}main{padding:12px 12px 90px}
}
</style>
</head>
<body>
<header class="top">
  <div class="brand"><span style="background:#fff;border-radius:9px;padding:4px 7px;display:flex"><img src="/logo.png?v=2" alt="Bluefalo" style="height:24px;display:block"></span><span id="appName">FG Stock</span> <span id="fac" style="color:var(--orange)"></span></div>
  <div class="sp"></div>
  <span class="rchip hidden" id="rchip"></span>
  <div class="who" id="who"></div>
  <button class="tbtn" id="langBtn" onclick="toggleLang()">EN</button>
  <button class="tbtn hidden" id="appsBtn" onclick="location.href='/?apps=1'" aria-label="Apps"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></button>
  <button class="tbtn" id="outBtn" onclick="logout()" aria-label="Sign out"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg></button>
</header>
<div class="layout">
  <nav class="side" id="side"></nav>
  <main id="app"><div class="card">Loading…</div></main>
</div>
<nav class="bot" id="bot"></nav>

<script>
/* ════════ FG Stock — receive / issue / checker, inside the CMMS login ════════
   One file, no build. Talks to /api/fg/*. Session = the CMMS cookie.
   Replaces the FG team's Access database and paper form F-WI04-WHD01-04. */
let LANG=(()=>{try{return localStorage.getItem('bflfp_lang')||'TH'}catch(e){return 'TH'}})();
const TH=()=>LANG==='TH';
const L=(th,en)=>TH()?th:en;
let ME=null,PAGE='home',CNT={};
// which app this tab is: 'fg' = FG Stock (floor), 'wh' = Warehouse (checker office). Set by the launcher tile.
// b471: the function this tab is in (FnBar) decides the menu. One person may hold several.
let FN='';
const FN_PAGES={packing:['slip'],packcheck:['pscan','papproved'],receiver:['recv','myrecv'],issuer:['issue','myissue'],
  checker:['home','queue','hrecv','hrel','stock','card','daily'],
  admin:['paudit','packing','lists','prod','cust','people','users','accimp']};      // admin's setup pages live in the Warehouse function
const isAdmin=()=>!!(ME&&(ME.fg_roles||[]).includes('admin'));
function fnPages(){return (FN_PAGES[FN]||[]).concat(FN==='checker'&&isAdmin()?FN_PAGES.admin:[]);}
const $=s=>document.querySelector(s);
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const can=k=>!!(ME&&ME.can.includes(k));
const n0=v=>(+v||0).toLocaleString('en-US',{maximumFractionDigits:2});
const fmtD=s=>s&&s.length>=10?s.slice(8,10)+'/'+s.slice(5,7)+'/'+s.slice(0,4):'-';
const fmtT=s=>s?fmtD(s.slice(0,10))+' '+s.slice(11,16):'-';
const today=()=>new Date(Date.now()-new Date().getTimezoneOffset()*6e4).toISOString().slice(0,10);
const daysAgo=n=>new Date(Date.now()-n*864e5-new Date().getTimezoneOffset()*6e4).toISOString().slice(0,10);
function toggleLang(){LANG=TH()?'EN':'TH';try{localStorage.setItem('bflfp_lang',LANG)}catch(e){}hdr();buildNav();go(PAGE,true);}

async function api(url,opt){
  const r=await fetch(url,Object.assign({credentials:'same-origin',headers:{'Content-Type':'application/json'}},opt||{}));
  let d=null;try{d=await r.json()}catch(e){}
  if(!r.ok){const det=d&&d.detail;const e=new Error((det&&det.msg)||(typeof det==='string'?det:'')||('HTTP '+r.status));e.status=r.status;e.detail=det;throw e;}
  return d;
}
const post=(u,b)=>{MEMO.clear();return api(u,{method:'POST',body:JSON.stringify(b||{})});};
/* b481 — show-then-refresh cache. Opening a page again shows the last answer at once (no "Loading…"),
   asks the server in the background, and redraws only if something changed. Any save clears it. */
const MEMO=new Map();
const LOADH='<div class="card skel"><i></i><i></i><i></i><i></i></div>';
function loading(B,url){if(B&&!MEMO.has(url))B.innerHTML=LOADH;}
async function apiC(url,again,ttl){
  const c=MEMO.get(url),pg=PAGE;
  if(c){
    if(Date.now()-c.t>(ttl==null?3000:ttl)&&!c.p){
      c.p=api(url).then(d=>{c.p=null;c.t=Date.now();const j=JSON.stringify(d);
        if(j!==c.j){c.j=j;c.d=d;if(again&&PAGE===pg&&!$('#dlg')&&!$('#xfp')&&!document.querySelector('.tadd'))again();}}).catch(()=>{c.p=null;});
    }
    return c.d;
  }
  const d=await api(url);
  if(MEMO.size>40)MEMO.delete(MEMO.keys().next().value);
  MEMO.set(url,{d,j:JSON.stringify(d),t:Date.now()});return d;
}
function err(e){return `<div class="msg m-bad">${esc(e.message||e)}</div>`;}
async function logout(){try{await post('/api/logout');}catch(e){}location.href='/';}

const ROLE={admin:['ผู้ดูแล','Admin','#0F172A'],packing:['แพคกิ้ง','Packing','#0D9488'],packcheck:['Checker แพคกิ้ง','Packing checker','#B45309'],receiver:['ตรวจรับพาเลท (รับเข้า FG)','Pallet Checker (FG receiver)','#1B75BC'],issuer:['โหลดพาเลท (จ่ายออก FG)','Pallet Loader (FG issuer)','#7C3AED'],checker:['ผู้ตรวจสอบ','Checker','#D97706']};
const STL={waiting:['รอตรวจสอบ','At checker'],confirmed:['ยืนยันแล้ว','Confirmed'],rejected:['ไม่อนุมัติ','Rejected'],sentback:['ส่งกลับ','Sent back'],
  packed:['แพคแล้ว','Packed'],cancelled:['ยกเลิก','Cancelled'],moved_to_fg:['ย้ายเข้า FG แล้ว','Moved to FG'],rejected_by_fg:['FG ไม่รับ','Rejected by FG']};
const stPill=s=>`<span class="pill p-${s}">${esc(L(...(STL[s]||[s,s])))}</span>`;

/* ---------- icons ---------- */
const I=p=>`<svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${p}</svg>`;
const IC={home:I('<path d="M3 11l9-7 9 7v9H3z"/>'),recv:I('<path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M4 21h16"/>'),
  issue:I('<path d="M12 21V9"/><path d="M7 14l5-5 5 5"/><path d="M4 3h16"/>'),check:I('<path d="M9 12l2 2 4-4"/><rect x="4" y="3" width="16" height="18" rx="2"/>'),
  hist:I('<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l3 2"/>'),stock:I('<rect x="3" y="4" width="18" height="6" rx="1"/><rect x="3" y="14" width="18" height="6" rx="1"/>'),
  card:I('<path d="M4 4h16v16H4z"/><path d="M4 9h16M9 9v11"/>'),rep:I('<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>'),
  pack:I('<path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/>'),master:I('<path d="M4 6h16M4 12h16M4 18h10"/>'),
  user:I('<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>'),
  scan:I('<path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M7 12h10"/>')};

/* ---------- navigation ---------- */
function pages(){return [
  ['home',IC.rep,L('แดชบอร์ด','Dashboard'),'home',''],
  ['slip',IC.pack,L('ใบพาเลท (QR)','Pallet slips (QR)'),'pack',''],
  ['slips',IC.hist,L('รายการใบพาเลท','Pallet slips'),'pack',''],
  ['slipchk',IC.check,L('Checker แพคกิ้ง','Packing check'),'packcheck',''],
  ['pscan',IC.scan,L('สแกนตรวจใบพาเลท','Scan & verify slip'),'packcheck',''],
  ['papproved',IC.check,L('รายการที่ตรวจแล้ว','Checked list'),'packcheck',''],
  ['recv',IC.recv,L('ตรวจรับ (สแกน)','Check pallet (scan)'),'receive',''],
  ['myrecv',IC.hist,L('งานรับเข้าของฉัน','My receive jobs'),'receive',''],
  ['issue',IC.issue,L('โหลด (สแกน)','Load pallet (scan)'),'issue',''],
  ['myissue',IC.hist,L('งานจ่ายออกของฉัน','My issue jobs'),'issue',''],
  ['queue',IC.check,L('คิวตรวจสอบ','Checker queue'),'check','q'],
  ['hrecv',IC.hist,L('ประวัติรับเข้า','Receive history'),'check',''],
  ['hrel',IC.hist,L('ประวัติจ่ายออก','Release history'),'check',''],
  ['stock',IC.stock,L('สต็อกคงเหลือ','Stock balance'),'check',''],
  ['card',IC.card,L('สต็อกการ์ด','Stock card'),'check',''],
  ['daily',IC.rep,L('รายงานประจำวัน','Daily report'),'check',''],
  ['paudit',IC.hist,L('ประวัติพิมพ์ / ตรวจใบพาเลท','Slip print & check audit'),'admin','M'],
  ['packing',IC.pack,L('ข้อมูลแพคกิ้ง','Packing records'),'admin','M'],
  ['lists',IC.master,L('เครื่องแพค / ไลน์','Machines & lines'),'admin','M'],
  ['prod',IC.master,L('สินค้า','Products'),'admin','M'],
  ['cust',IC.master,L('ลูกค้า','Customers'),'admin','M'],
  ['people',IC.master,L('ผู้ตรวจสอบ / หัวหน้ากะ','Checkers & leaders'),'admin','M'],
  ['users',IC.user,L('ผู้ใช้งาน','Users & roles'),'admin','M'],
  ['accimp',IC.master,L('นำเข้า Access','Import Access'),'admin','M']].filter(p=>fnPages().includes(p[0])&&(p[3]==='home'||can(p[3])))
    .sort((a,b)=>fnPages().indexOf(a[0])-fnPages().indexOf(b[0]));}
function buildNav(){
  let h='',g=false;
  for(const p of pages()){
    if(p[4]==='M'&&!g){h+=`<div class="grp">${L('ข้อมูลหลัก','MASTERS')}</div>`;g=true;}
    const b=p[4]==='q'?`<span class="bdg" id="qbdg">${(CNT.recv_waiting||0)+(CNT.issue_waiting||0)}</span>`:'';
    h+=`<button id="nv-${p[0]}" onclick="go('${p[0]}')">${p[1]}<span>${esc(p[2])}</span>${b}</button>`;
  }
  $('#side').innerHTML=h;
  const bot=pages().filter(p=>['home','slip','slips','slipchk','pscan','papproved','recv','myrecv','issue','myissue','queue','stock'].includes(p[0])).slice(0,5);
  $('#bot').innerHTML=bot.map(p=>`<button id="nb-${p[0]}" onclick="go('${p[0]}')">${p[1]}<span>${esc(p[2])}</span></button>`).join('');
}
function go(p,keep){
  if(!pages().some(x=>x[0]===p))p=(pages()[0]||['home'])[0];
  PAGE=p;if(!keep)history.replaceState(null,'','#'+p);
  document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('on',b.id==='nv-'+p||b.id==='nb-'+p));
  stopScan();closeDlg();
  ({home:pgHome,myrecv:pgMyRecv,myissue:pgMyIssue,slip:pgSlip,slips:pgSlips,slipchk:pgSlipChk,pscan:pgPScan,papproved:pgPApproved,paudit:pgPAudit,lists:pgLists,recv:pgRecv,issue:pgIssue,queue:pgQueue,hrecv:()=>pgHist('recv'),hrel:()=>pgHist('issue'),stock:pgStock,card:pgCard,
    daily:pgDaily,packing:pgPacking,prod:pgProd,cust:pgCust,people:pgPeople,users:pgUsers,accimp:pgAccImp}[p])();
  window.scrollTo(0,0);
}
function dlg(html){closeDlg();const o=document.createElement('div');o.className='ov';o.id='dlg';o.onclick=e=>{if(e.target===o)closeDlg();};o.innerHTML=`<div class="modal">${html}</div>`;document.body.appendChild(o);}
function closeDlg(){const o=$('#dlg');if(o)o.remove();}
async function refreshCounts(){try{CNT=await api('/api/fg/summary');const b=$('#qbdg');if(b)b.textContent=(CNT.recv_waiting||0)+(CNT.issue_waiting||0);
  const fb=document.querySelector('#fnbar button[data-fn=checker] .b'),n=(CNT.recv_waiting||0)+(CNT.issue_waiting||0);if(fb)fb.textContent=n||'';}catch(e){}}
function csv(name,head,rows){
  const q=v=>{v=v==null?'':String(v);return /[",\n]/.test(v)?'"'+v.replace(/"/g,'""')+'"':v;};
  const s='﻿'+[head.map(q).join(','),...rows.map(r=>r.map(q).join(','))].join('\r\n');
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([s],{type:'text/csv'}));a.download=name;a.click();
}

/* A4 report print (checker) — opens a print window, landscape A4 */
function printA4(title,sub,head,rows,foot,right){
  right=right||[];
  const w=window.open('','_blank');if(!w){alert(L('อนุญาต pop-up เพื่อพิมพ์','Allow pop-ups to print'));return;}
  const th=head.map((h,i)=>`<th${right.includes(i)?' class="r"':''}>${esc(h)}</th>`).join('');
  const tr=rows.map(r=>'<tr>'+r.map((v,i)=>`<td${right.includes(i)?' class="r"':''}>${esc(v==null?'':v)}</td>`).join('')+'</tr>').join('');
  w.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>${esc(title)}</title><style>@page{size:A4 landscape;margin:10mm}
   body{font-family:"Sarabun",Tahoma,sans-serif;font-size:9.5pt;color:#000;margin:0}h1{font-size:14pt;margin:0}.s{font-size:9pt;margin:2px 0 8px}
   table{border-collapse:collapse;width:100%}th,td{border:.2mm solid #000;padding:2px 4px;text-align:left;vertical-align:top}th{background:#e5e7eb}thead{display:table-header-group}tr{page-break-inside:avoid}
   .r{text-align:right;white-space:nowrap}.f{margin-top:4px;font-weight:700;break-inside:avoid}.sg{display:flex;justify-content:space-around;margin-top:16px;break-inside:avoid;page-break-inside:avoid}
   .end{break-inside:avoid;page-break-inside:avoid}</style></head><body>
   <h1>${esc(title)}</h1><div class="s">FG ${esc(ME.factory_code)} · ${esc(sub||'')} · ${L('พิมพ์โดย','printed by')} ${esc(ME.name)} ${fmtT(new Date(Date.now()-new Date().getTimezoneOffset()*6e4).toISOString().replace('T',' '))}</div>
   <table><thead><tr>${th}</tr></thead><tbody>${tr}</tbody></table><div class="end">${foot?`<div class="f">${esc(foot)}</div>`:''}
   <div class="sg"><div>..............................<br>Checker</div><div>..............................<br>ผู้ตรวจสอบ / Approved by</div></div></div>
   <script>window.onload=function(){setTimeout(function(){window.print()},200)}<\/script></body></html>`);
  w.document.close();
}

/* ════════ Excel-style table (b480) ════════
   xTable(el, id, cols, rows, opts): grid lines, sticky header, click a header to sort,
   ▾ opens an Excel-like filter (search + tick values). XT[id].view = rows after filter/sort
   (used by CSV / A4 / Print selected).
   col: {k, label, r:right-align, fmt:(row)=>html, val:(row)=>text for filter/sort, num:true, nf:true (no filter), w} */
const XT={};
const XC=(k,label,o)=>Object.assign({k,label},o||{});
const xSum=(k,f)=>(c,v)=>c.k===k?n0(v.reduce((a,r)=>a+(+(f?f(r):r[k])||0),0)):'';
const xFoot=(...ks)=>(c,v,i)=>ks.includes(c.k)?n0(v.reduce((a,r)=>a+(+r[c.k]||0),0)):(i===0?L('รวม','Total'):'');
const xView=(id,rows)=>XT[id]&&XT[id].view?XT[id].view:rows;
const pName=r=>`${esc(r.product_id||r.product_code)}<div class="muted">${esc(r.product_name||'')}</div>`;
const pVal=r=>(r.product_id||r.product_code||'')+' · '+(r.product_name||'');
function xVal(c,r){const v=c.val?c.val(r):r[c.k];return v==null?'':v;}
function xTable(el,id,cols,rows,opts){
  opts=opts||{};const st=XT[id]||(XT[id]={sort:null,f:{}});st.cols=cols;st.rows=rows;st.opts=opts;st.el=el;xRender(id);return st;
}
function xApply(id){
  const st=XT[id];let v=st.rows.filter(r=>st.cols.every(c=>!st.f[c.k]||st.f[c.k].has(String(xVal(c,r)))));
  if(st.sort){const c=st.cols.find(x=>x.k===st.sort.k);if(c){const d=st.sort.dir;v=v.slice().sort((a,b)=>{const x=xVal(c,a),y=xVal(c,b);
    return (c.num?((+x||0)-(+y||0)):String(x).localeCompare(String(y),'th',{numeric:true}))*d;});}}
  st.view=v;return v;
}
function xRender(id){
  const st=XT[id],o=st.opts,v=xApply(id),nf=Object.keys(st.f).length,lim=o.limit||3000;
  const ps=o.pageSize||0,np=ps?Math.max(1,Math.ceil(v.length/ps)):1;st.pg=Math.min(st.pg||0,np-1);const off=ps?st.pg*ps:0,vv=ps?v.slice(off,off+ps):v.slice(0,lim);
  const th=st.cols.map(c=>{const on=!!st.f[c.k],s=st.sort&&st.sort.k===c.k?(st.sort.dir>0?' ▲':' ▼'):'';
    return `<th class="${c.r?'r':''}" style="${c.w?'width:'+c.w:''}"><div class="xh"><span class="xl" onclick="xSort('${id}','${c.k}')">${esc(c.label)}${s}</span>${c.nf?'':`<button class="xf ${on?'on':''}" onclick="xFilter(event,'${id}','${c.k}')" aria-label="Filter ${esc(c.label)}">▾</button>`}</div></th>`;}).join('');
  const sel=o.select?`<th style="width:34px"><input type="checkbox" ${v.length&&v.every(r=>o.select[r.id])?'checked':''} onchange="xSelAll('${id}',this.checked)" aria-label="Select all"></th>`:'';
  const body=vv.map((r,i)=>`<tr class="${o.select&&o.select[r.id]?'sel':''}${o.onRow?' click':''}" ${o.onRow?`onclick="if(!event.target.closest('button,input,a'))XT['${id}'].opts.onRow(XT['${id}'].view[${off+i}])"`:''}>
    ${o.select?`<td><input type="checkbox" ${o.select[r.id]?'checked':''} onchange="xSel('${id}',${r.id},this.checked)" aria-label="Select"></td>`:''}
    ${st.cols.map(c=>`<td class="${c.r?'r':''}${c.cls?' '+c.cls:''}">${c.fmt?c.fmt(r):esc(r[c.k]==null?'':r[c.k])}</td>`).join('')}</tr>`).join('');
  const pager=ps&&v.length?`<div class="xpg"><span>${v.length?off+1:0}–${Math.min(off+ps,v.length)} ${L('จาก','of')} ${v.length.toLocaleString()} ${L('รายการ','items')}</span><span style="flex:1"></span>
    <button ${st.pg?'':'disabled'} onclick="XT['${id}'].pg--;xRender('${id}')" aria-label="Previous page">‹</button>${Array.from({length:np},(x,i)=>i).filter(i=>np<=7||Math.abs(i-st.pg)<=2||i===0||i===np-1).map((i,k,a)=>(k&&i-a[k-1]>1?'<em>…</em>':'')+`<button class="${i===st.pg?'on':''}" onclick="XT['${id}'].pg=${i};xRender('${id}')">${i+1}</button>`).join('')}
    <button ${st.pg<np-1?'':'disabled'} onclick="XT['${id}'].pg++;xRender('${id}')" aria-label="Next page">›</button></div>`:'';
  st.el.innerHTML=`<div class="xbar"><span>${v.length.toLocaleString()} ${L('รายการ','rows')}${v.length!==st.rows.length?` ${L('จาก','of')} ${st.rows.length.toLocaleString()}`:''}${v.length>lim?` · ${L('แสดง','showing')} ${lim}`:''}</span>
    ${nf?`<button class="plink" onclick="XT['${id}'].f={};xRender('${id}')">${L('ล้างตัวกรอง','Clear filters')} (${nf})</button>`:''}${o.extra||''}</div>
   <div class="tw xt" style="${o.maxH?'max-height:'+o.maxH:''}"><table><thead><tr>${sel}${th}</tr></thead><tbody>${body||`<tr><td colspan="${st.cols.length+(o.select?1:0)}" class="muted" style="padding:28px;text-align:center">${o.empty||L('ไม่มีข้อมูล','No rows')}</td></tr>`}</tbody>
   ${o.foot&&v.length&&!ps?`<tfoot><tr>${o.select?'<td></td>':''}${st.cols.map((c,i)=>`<td class="${c.r?'r':''}">${o.foot(c,v,i)||''}</td>`).join('')}</tr></tfoot>`:''}</table></div>${pager}`;
  if(o.after)o.after(v);
}
function xSort(id,k){const st=XT[id];st.sort=st.sort&&st.sort.k===k?(st.sort.dir>0?{k,dir:-1}:null):{k,dir:1};xRender(id);}
function xSel(id,rid,on){const o=XT[id].opts;o.select[rid]=on;xRender(id);}
function xSelAll(id,on){const st=XT[id];st.view.forEach(r=>st.opts.select[r.id]=on);xRender(id);}
function xFilter(ev,id,k){
  ev.stopPropagation();xClose();
  const st=XT[id],c=st.cols.find(x=>x.k===k);
  // values from rows that pass the OTHER filters (Excel behaviour)
  const base=st.rows.filter(r=>st.cols.every(cc=>cc.k===k||!st.f[cc.k]||st.f[cc.k].has(String(xVal(cc,r)))));
  const cnt=new Map();base.forEach(r=>{const v=String(xVal(c,r));cnt.set(v,(cnt.get(v)||0)+1);});
  const vals=[...cnt.keys()].sort((a,b)=>c.num?(+a)-(+b):a.localeCompare(b,'th',{numeric:true}));
  const cur=st.f[k];XF={id,k,vals,cnt,sel:new Set(cur?[...cur]:vals)};
  const box=document.createElement('div');box.id='xfp';box.className='xfp';
  const r=ev.currentTarget.getBoundingClientRect();box.style.left=Math.max(8,Math.min(r.left-200,innerWidth-292))+'px';box.style.top=(r.bottom+4)+'px';
  box.innerHTML=`<div class="btns" style="gap:6px;margin-bottom:8px"><button class="btn sm" onclick="XT['${id}'].sort={k:'${k}',dir:1};xClose();xRender('${id}')">A→Z ▲</button><button class="btn sm" onclick="XT['${id}'].sort={k:'${k}',dir:-1};xClose();xRender('${id}')">Z→A ▼</button></div>
   <input class="in sm" id="xfq" placeholder="${L('ค้นหา','Search')}" oninput="xfList()" autocomplete="off">
   <div class="xfl" id="xfl"></div>
   <div class="btns" style="justify-content:flex-end;margin-top:8px;gap:6px"><button class="btn sm" onclick="delete XT['${id}'].f['${k}'];xClose();xRender('${id}')">${L('ล้าง','Clear')}</button><button class="btn sm pri" onclick="xfOk()">OK</button></div>`;
  document.body.appendChild(box);xfList();setTimeout(()=>$('#xfq').focus(),10);
}
let XF=null;
function xfList(){
  const q=($('#xfq').value||'').toLowerCase(),vs=XF.vals.filter(v=>!q||v.toLowerCase().includes(q)).slice(0,800);
  const all=vs.length&&vs.every(v=>XF.sel.has(v));
  $('#xfl').innerHTML=`<label><input type="checkbox" ${all?'checked':''} onchange="xfAll(this.checked)"> <b>${L('(เลือกทั้งหมด)','(Select all)')}</b></label>`+
    vs.map((v,i)=>`<label><input type="checkbox" data-i="${XF.vals.indexOf(v)}" ${XF.sel.has(v)?'checked':''} onchange="xfOne(this)"> <span>${esc(v===''?L('(ว่าง)','(blank)'):v)}</span><em>${XF.cnt.get(v)}</em></label>`).join('');
}
function xfAll(on){const q=($('#xfq').value||'').toLowerCase();XF.vals.filter(v=>!q||v.toLowerCase().includes(q)).forEach(v=>on?XF.sel.add(v):XF.sel.delete(v));xfList();}
function xfOne(cb){const v=XF.vals[+cb.dataset.i];cb.checked?XF.sel.add(v):XF.sel.delete(v);}
function xfOk(){const st=XT[XF.id];if(XF.sel.size===XF.vals.length)delete st.f[XF.k];else st.f[XF.k]=new Set(XF.sel);xClose();xRender(XF.id);}
function xClose(){const b=$('#xfp');if(b)b.remove();}
document.addEventListener('click',e=>{if(!e.target.closest('#xfp'))xClose();});
document.addEventListener('keydown',e=>{if(e.key==='Escape')xClose();});

/* ════════ Type-ahead: a drop-down of matches while typing ════════
   ta(input, source, onPick) — source(q) returns [{v,t,s}] (value, title, sub), sync or async. */
function ta(inp,source,onPick,min){
  if(!inp||inp._ta)return;inp._ta=1;inp.setAttribute('autocomplete','off');min=min==null?1:min;
  let box=null,items=[],hi=-1,tm=null;
  const close=()=>{if(box){box.remove();box=null;}hi=-1;};
  const pick=i=>{const it=items[i];if(!it)return;inp.value=it.v;close();if(onPick)onPick(it);inp.dispatchEvent(new Event('input'));inp.dispatchEvent(new Event('change'));};
  const draw=()=>{
    if(!items.length){close();return;}
    if(!box){box=document.createElement('div');box.className='tadd';document.body.appendChild(box);}
    const r=inp.getBoundingClientRect();box.style.left=r.left+'px';box.style.top=(r.bottom+2)+'px';box.style.width=Math.max(r.width,280)+'px';
    box.innerHTML=items.map((it,i)=>`<div class="tadi ${i===hi?'on':''}" data-i="${i}"><b>${esc(it.t)}</b>${it.s?`<span>${esc(it.s)}</span>`:''}</div>`).join('');
    box.querySelectorAll('.tadi').forEach(d=>d.onmousedown=e=>{e.preventDefault();pick(+d.dataset.i);});
  };
  const run=async()=>{const q=inp.value.trim();if(q.length<min){close();return;}
    let r=source(q);if(r&&r.then)r=await r;if(inp.value.trim()!==q)return;items=(r||[]).slice(0,14);hi=-1;draw();};
  inp.addEventListener('input',e=>{if(e.isTrusted===false&&!box)return;clearTimeout(tm);tm=setTimeout(run,150);});
  inp.addEventListener('focus',()=>{if(inp.value.trim().length>=min)run();});
  inp.addEventListener('blur',()=>setTimeout(close,120));
  inp.addEventListener('keydown',e=>{if(!box)return;
    if(e.key==='ArrowDown'){hi=Math.min(items.length-1,hi+1);draw();e.preventDefault();}
    else if(e.key==='ArrowUp'){hi=Math.max(0,hi-1);draw();e.preventDefault();}
    else if(e.key==='Enter'&&hi>=0){pick(hi);e.preventDefault();e.stopPropagation();}
    else if(e.key==='Escape')close();});
  window.addEventListener('scroll',close,true);
}
const taProd=q=>{q=q.toLowerCase();return (PRODS||[]).filter(p=>(p.code+' '+p.name).toLowerCase().includes(q))
  .sort((a,b)=>(a.code.toLowerCase().startsWith(q)?0:1)-(b.code.toLowerCase().startsWith(q)?0:1)).slice(0,12).map(p=>({v:p.code,t:p.code,s:p.name}));};
const taSrv=(kind,prodSel)=>async q=>{try{return (await api(`/api/fg/suggest?kind=${kind}&q=${encodeURIComponent(q)}${prodSel?'&product='+encodeURIComponent(prodSel()||''):''}`)).items;}catch(e){return [];}};
const taRows=(rows,keys)=>q=>{q=q.toLowerCase();const seen=new Set(),out=[];
  for(const r of rows()){for(const k of keys){const v=String(r[k]||'');if(v&&v.toLowerCase().includes(q)&&!seen.has(v)){seen.add(v);out.push({v,t:v,s:k==='product_id'||k==='product_code'?(r.product_name||''):(k==='lot_no'?(r.product_id||r.product_code||''):'')});if(out.length>=12)return out;}}}return out;};

/* ════════ QR scanner: camera (BarcodeDetector → jsQR), photo, or typed/handheld ════════ */
let SC={stream:null,t:null,det:null,cv:null,cand:null,cb:null,busy:false};
function loadJs(src,test){return new Promise((res,rej)=>{if(test())return res();const s=document.createElement('script');s.src=src;s.onload=()=>res();s.onerror=()=>rej(new Error('load '+src));document.head.appendChild(s);});}
async function detector(){
  if(!('BarcodeDetector' in window))return null;
  try{const f=BarcodeDetector.getSupportedFormats?await BarcodeDetector.getSupportedFormats():['qr_code'];
    return f.includes('qr_code')?new BarcodeDetector({formats:['qr_code']}):null;}catch(e){return null;}
}
async function readQR(cv){
  if(SC.det){try{const c=await SC.det.detect(cv);return c&&c.length?c[0].rawValue:null;}catch(e){SC.det=null;}}
  try{await loadJs('/vendor/jsqr.js',()=>window.jsQR);}catch(e){return null;}
  const im=cv.getContext('2d',{willReadFrequently:true}).getImageData(0,0,cv.width,cv.height);
  const r=window.jsQR(im.data,cv.width,cv.height,{inversionAttempts:'attemptBoth'});return r&&r.data?r.data:null;
}
async function openScan(title,cb){
  SC.cb=cb;SC.cand=null;
  const ov=document.createElement('div');ov.className='scan';ov.id='scan';
  ov.innerHTML=`<video id="scv" playsinline autoplay muted></video><div class="fr" id="scf"></div>
   <div class="hint" id="sch">${esc(title)}<br><small>${L('เล็ง QR ให้อยู่ในกรอบ ถือนิ่ง ๆ','Hold the QR inside the frame')}</small></div>
   <div class="bt"><label class="btn" style="text-align:center">${L('ถ่ายรูป QR แทน','Take a photo instead')}<input type="file" accept="image/*" capture="environment" style="display:none" onchange="scanPhoto(this)"></label>
   <button class="btn" onclick="stopScan()">${L('ยกเลิก','Cancel')}</button></div>`;
  document.body.appendChild(ov);
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){$('#sch').textContent=L('เปิดกล้องสดไม่ได้ — ใช้ถ่ายรูปแทน','No live camera here — use the photo button');return;}
  try{SC.stream=await navigator.mediaDevices.getUserMedia({audio:false,video:{facingMode:{ideal:'environment'},width:{ideal:1280},height:{ideal:720}}});}
  catch(e){$('#sch').textContent=L('เปิดกล้องไม่ได้ — อนุญาตกล้อง หรือใช้ถ่ายรูปแทน','Cannot open the camera — allow it, or use the photo button');return;}
  if(!$('#scan')){stopScan();return;}
  const v=$('#scv');v.srcObject=SC.stream;try{await v.play()}catch(e){}
  SC.det=await detector();SC.cv=document.createElement('canvas');tick();
}
async function tick(){
  const v=$('#scv');if(!v||!$('#scan'))return;
  if(!SC.busy&&v.videoWidth){SC.busy=true;
    try{const vw=v.videoWidth,vh=v.videoHeight,s=Math.min(vw,vh)*.75,k=Math.min(1,560/s);
      SC.cv.width=SC.cv.height=Math.round(s*k);
      SC.cv.getContext('2d',{willReadFrequently:true}).drawImage(v,(vw-s)/2,(vh-s)/2,s,s,0,0,SC.cv.width,SC.cv.height);
      const raw=await readQR(SC.cv);
      if(raw){if(!SC.cand||SC.cand.raw!==raw)SC.cand={raw,t:Date.now()};$('#scf')&&$('#scf').classList.add('lock');
        if(Date.now()-SC.cand.t>350){SC.busy=false;return scanned(raw);}}
    }catch(e){}
    SC.busy=false;}
  SC.t=setTimeout(tick,140);
}
async function scanPhoto(inp){
  const f=inp.files&&inp.files[0];inp.value='';if(!f)return;
  try{const img=new Image();img.src=URL.createObjectURL(f);await img.decode();
    for(const z of [.5,.8,1]){const W=img.width,H=img.height,sw=W*z,sh=H*z,k=Math.min(1,1600/Math.max(sw,sh));
      const cv=document.createElement('canvas');cv.width=Math.round(sw*k);cv.height=Math.round(sh*k);
      cv.getContext('2d').drawImage(img,(W-sw)/2,(H-sh)/2,sw,sh,0,0,cv.width,cv.height);
      if(!SC.det&&!window.jsQR)SC.det=await detector();
      const raw=await readQR(cv);if(raw)return scanned(raw);}
    $('#sch').textContent=L('อ่าน QR จากรูปไม่ได้ ลองใหม่','No QR found in the photo — try again');
  }catch(e){}
}
function scanned(raw){const cb=SC.cb;stopScan();if(navigator.vibrate)try{navigator.vibrate(80)}catch(e){};if(cb)cb(raw);}
function stopScan(){clearTimeout(SC.t);if(SC.stream){SC.stream.getTracks().forEach(t=>t.stop());SC.stream=null;}const o=$('#scan');if(o)o.remove();}
function scanBox(label,fn,color,typeHint){
  return `<button class="scanbig" style="background:${color}" onclick="openScan('${esc(label)}',${fn})">${IC.scan}<span>${esc(label)}</span></button>
   <div style="display:flex;gap:8px;margin:10px 0 14px"><input class="in" id="typed" placeholder="${esc(typeHint||L('หรือยิงด้วยเครื่องสแกน / พิมพ์ แล้วกด Enter','or use a handheld scanner / type, then Enter'))}"
     onkeydown="if(event.key==='Enter'){const v=this.value;this.value='';${fn}(v)}"></div>`;
}

/* ════════ Home ════════ */
async function pgHome(){
  const A=$('#app');
  await refreshCounts();const d=CNT;
  const role=FN;
  if(role==='packing'||role==='packcheck'){
    let c={};try{c=(await api('/api/fg/slips?d1='+today()+'&d2='+today()+'&limit=1')).counts;}catch(e){}
    const t=(bg,l,v,pg)=>`<button class="tile" style="background:${bg}" onclick="go('${pg}')"><div class="l">${l}</div><div class="v">${v}</div></button>`;
    A.innerHTML=`<h1>${L('แพคกิ้ง','Packing')}</h1><p class="sub">${esc(ME.factory_code)} · ${fmtD(today())}</p><div class="tiles">
      ${t('#D97706',L('รอ Checker แพคกิ้ง','Waiting packing check'),c.pending||0,role==='packcheck'?'slipchk':'slips')}
      ${t('#DC2626',L('Checker ไม่ผ่าน','Packing rejected'),c.rejected||0,'slips')}
      ${t('#16A34A',L('ผ่านแล้ว รอ FG รับ','Approved, waiting FG'),c.approved||0,'slips')}
      <button class="tile" style="background:#7F1D1D" onclick="SLF.st='rejected_by_fg';go('slips')"><div class="l">${L('FG ไม่รับ — ต้องแก้ + พิมพ์ใหม่','Rejected by FG — fix + reprint')}</div><div class="v">${c.fg_rejected||0}</div></button></div>
     <div class="btns"><button class="btn pri" onclick="go('slip')">+ ${L('ใบพาเลทใหม่','New pallet slip')}</button>${role==='packcheck'?`<button class="btn" onclick="go('slipchk')">${L('Checker แพคกิ้ง','Packing check')}</button>`:''}</div>`;
    return;
  }
  if(role==='receiver'||role==='issuer'){
    const recv=role==='receiver',col=recv?'#1B75BC':'#7C3AED';
    A.innerHTML=`<div class="ph">
     <div class="st3">${recv?`<div style="background:#16A34A"><b>${d.recv_today}</b><span>${L('รับวันนี้','Received today')}</span></div>
       <div style="background:#D97706"><b>${d.recv_waiting}</b><span>${L('รอ Checker','At checker')}</span></div>
       <div style="background:#DC2626"><b>${d.rejected_today}</b><span>${L('ไม่อนุมัติวันนี้','Rejected today')}</span></div>`
      :`<div style="background:#7C3AED"><b>${d.issue_today}</b><span>${L('จ่ายวันนี้','Issued today')}</span></div>
       <div style="background:#D97706"><b>${d.issue_waiting}</b><span>${L('รอ Checker','At checker')}</span></div>
       <div style="background:#1B75BC"><b>${d.stock_lots}</b><span>${L('ล็อตในสต็อก','Lots in stock')}</span></div>`}</div>
     <button class="scanbig" style="background:${col}" onclick="go('${recv?'recv':'issue'}')">${IC.scan}<span>${recv?L('สแกน QR ใบพาเลท','Scan pallet slip QR'):L('สแกนพาเลทเพื่อจ่าย','Scan pallet to issue')}</span></button>
     <h2 style="margin:16px 0 8px">${L('วันนี้ของฉัน','My work today')}</h2>${mineList(d.mine)}</div>`;
    return;
  }
  const t=(bg,l,v,s,pg)=>`<button class="tile" style="background:${bg}" onclick="go('${pg}')"><div class="l">${l}</div><div class="v">${v}</div><div class="s">${s}</div></button>`;
  const imp=!d.access_rows?`<div class="msg m-warn" style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between"><span>${L('ยังไม่ได้นำเข้าข้อมูลเก่าจาก Access — ประวัติและสต็อกยังว่าง','The old Access data has not been imported yet — history and stock are empty')}</span>
    ${isAdmin()?`<button class="btn pri" id="impBtn" onclick="impAccess()">${L('นำเข้าข้อมูล Access ตอนนี้','Import Access data now')}</button>`:`<span>${L('แจ้ง admin ให้นำเข้า','ask the admin to import it')}</span>`}</div>`:'';
  return pgDash(imp);
}
/* ════════ Warehouse dashboard (checker / admin home) ════════ */
let DASHD=30,DASH=null;
const kgT=v=>{v=+v||0;return v>=1000?(v/1000).toLocaleString('en-US',{maximumFractionDigits:v>=100000?0:1})+' t':n0(v)+' kg';};
const VZ={in:'#2a78d6',out:'#eb6834',seq:['#bfd7f5','#8db8ec','#5a97e0','#2a78d6','#1c5aa8'],grid:'#E2E8F0',ink2:'#475569'};
function tipOn(root){
  let t=$('#vtip');if(!t){t=document.createElement('div');t.id='vtip';t.style.cssText='position:fixed;z-index:40;pointer-events:none;background:#202020;color:#fff;font-size:12.5px;padding:6px 9px;border-radius:8px;box-shadow:0 4px 14px rgba(0,0,0,.25);display:none;max-width:260px;line-height:1.35';document.body.appendChild(t);}
  root.addEventListener('mousemove',e=>{const m=e.target.closest('[data-tip]');if(!m){t.style.display='none';return;}t.innerHTML=m.getAttribute('data-tip');t.style.display='block';
    const x=Math.min(e.clientX+14,innerWidth-t.offsetWidth-8),y=Math.max(8,e.clientY-t.offsetHeight-12);t.style.left=x+'px';t.style.top=y+'px';});
  root.addEventListener('mouseleave',()=>t.style.display='none');
  root.addEventListener('click',e=>{const m=e.target.closest('[data-tip]');if(m&&matchMedia('(hover:none)').matches){t.innerHTML=m.getAttribute('data-tip');t.style.display='block';t.style.left='12px';t.style.top=(e.clientY-60)+'px';}});
}
function niceMax(v){if(v<=0)return 1;const p=Math.pow(10,Math.floor(Math.log10(v))),n=v/p;return (n<=1?1:n<=2?2:n<=2.5?2.5:n<=5?5:10)*p;}
/* grouped columns: receive vs release per day / month */
function colChart(el,rows,monthly){
  const W=Math.max(300,el.clientWidth),H=250,P={l:52,r:8,t:10,b:34},iw=W-P.l-P.r,ih=H-P.t-P.b;
  const mx=niceMax(Math.max(...rows.map(r=>Math.max(r.in,r.out)),1)),n=rows.length,slot=iw/n,bw=Math.max(1.5,Math.min(18,(slot-2)/2-1));
  const y=v=>P.t+ih-(v/mx)*ih,ticks=[0,.25,.5,.75,1].map(f=>f*mx);
  const lab=r=>monthly?['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'][+r.k.slice(5,7)-1]+' '+r.k.slice(2,4):r.k.slice(8,10)+'/'+r.k.slice(5,7);
  const every=Math.ceil(n/(W<560?6:12));
  const bar=(x,v,c)=>{const h=Math.max(0,P.t+ih-y(v));if(h<=0)return '';const r=Math.min(3,bw/2,h);return `<path d="M${x},${P.t+ih}V${P.t+ih-h+r}q0,-${r} ${r},-${r}h${bw-2*r}q${r},0 ${r},${r}V${P.t+ih}Z" fill="${c}"/>`;};
  let s=`<svg width="${W}" height="${H}" role="img" aria-label="${L('รับเข้าและจ่ายออกต่อช่วงเวลา','receive and release over time')}" style="display:block">`;
  ticks.forEach(t=>{s+=`<line x1="${P.l}" x2="${W-P.r}" y1="${y(t)}" y2="${y(t)}" stroke="${VZ.grid}" stroke-width="1"/><text x="${P.l-6}" y="${y(t)+4}" text-anchor="end" font-size="11" fill="${VZ.ink2}">${kgT(t)}</text>`;});
  rows.forEach((r,i)=>{const x0=P.l+i*slot+(slot-(2*bw+2))/2;
    s+=`<g data-tip="<b>${monthly?esc(lab(r)):fmtD(r.k)}</b><br><span style='color:#93c5fd'>■</span> ${L('รับเข้า','Received')} ${kgT(r.in)}<br><span style='color:#fdba74'>■</span> ${L('จ่ายออก','Released')} ${kgT(r.out)}">
      <rect x="${P.l+i*slot}" y="${P.t}" width="${slot}" height="${ih}" fill="transparent"/>${bar(x0,r.in,VZ.in)}${bar(x0+bw+2,r.out,VZ.out)}</g>`;
    if(i%every===0||i===n-1)s+=`<text x="${P.l+i*slot+slot/2}" y="${H-P.b+16}" text-anchor="middle" font-size="11" fill="${VZ.ink2}">${esc(lab(r))}</text>`;});
  s+=`<line x1="${P.l}" x2="${W-P.r}" y1="${P.t+ih}" y2="${P.t+ih}" stroke="#94A3B8"/></svg>`;
  el.innerHTML=s;
}
/* horizontal bars (single hue, or sequential steps when ordered) */
function hBars(el,rows,opt){
  opt=opt||{};const tot=rows.reduce((a,r)=>a+r[1],0)||1,mx=Math.max(...rows.map(r=>r[1]),1);
  el.innerHTML=rows.length?rows.map((r,i)=>{const c=opt.seq?VZ.seq[Math.min(i,VZ.seq.length-1)]:(opt.color||VZ.in),pc=Math.round(100*r[1]/tot);
    return `<div data-tip="<b>${esc(r[0])}</b><br>${kgT(r[1])} · ${pc}%" style="display:grid;grid-template-columns:minmax(70px,34%) 1fr auto;gap:8px;align-items:center;padding:4px 0">
     <span style="font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(r[0])}</span>
     <span style="height:14px;background:#F1F5F9;border-radius:4px;overflow:hidden"><span style="display:block;height:14px;width:${Math.max(1,100*r[1]/mx)}%;background:${c};border-radius:0 4px 4px 0"></span></span>
     <span style="font-size:12.5px;color:#0F172A;font-weight:600;min-width:64px;text-align:right">${kgT(r[1])}</span></div>`;}).join(''):`<div class="muted">${L('ไม่มีข้อมูล','No data')}</div>`;
}
async function pgDash(banner){
  const A=$('#app');
  A.innerHTML=(banner||'')+`<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:10px;margin-bottom:12px">
    <div><h1>${L('แดชบอร์ดคลังสินค้า FG','FG warehouse dashboard')}</h1><p class="sub" style="margin:0" id="dsub">${esc(ME.factory_code)}</p></div>
    <div class="tabs" style="margin:0">${[[7,L('7 วัน','7 days')],[30,L('30 วัน','30 days')],[90,L('90 วัน','90 days')],[365,L('12 เดือน','12 months')]].map(([v,t])=>`<button class="tab ${DASHD===v?'on':''}" onclick="DASHD=${v};pgHome()">${t}</button>`).join('')}</div></div>
   <div id="dbody">${MEMO.has('/api/fg/dashboard?days='+DASHD)?'':LOADH}</div>`;
  let d;try{d=DASH=await apiC('/api/fg/dashboard?days='+DASHD,()=>pgDash(banner));}catch(e){$('#dbody').innerHTML=err(e);return;}
  $('#dsub').textContent=`${ME.factory_code} · ${fmtD(d.d1)} – ${fmtD(d.d2)}${d.last_receive?' · '+L('รับเข้าล่าสุด','last receive')+' '+fmtD(d.last_receive):''}`;
  const tile=(bg,l,v,s,pg)=>`<button class="tile" style="background:${bg}" ${pg?`onclick="go('${pg}')"`:''}><div class="l">${l}</div><div class="v">${v}</div><div class="s">${s}</div></button>`;
  const w=d.waiting,net=d.period.in_kg-d.period.out_kg;
  $('#dbody').innerHTML=`<div class="tiles">
    ${tile('#1E3A8A',L('สต็อกคงเหลือ','Stock on hand'),kgT(d.stock.kg),`${n0(d.stock.bags)} ${L('ถุง','bags')} · ${n0(d.stock.lots)} ${L('ล็อต','lots')}`,'stock')}
    ${tile('#1B75BC',L('รับเข้าในช่วงนี้','Received in period'),kgT(d.period.in_kg),L('ยืนยันแล้ว','confirmed'),'hrecv')}
    ${tile('#C2410C',L('จ่ายออกในช่วงนี้','Released in period'),kgT(d.period.out_kg),`${L('สุทธิ','net')} ${net>=0?'+':'−'}${kgT(Math.abs(net))}`,'hrel')}
    ${tile('#D97706',L('รอ Checker','Waiting checker'),w.recv+w.issue,`${L('รับ','in')} ${w.recv} · ${L('จ่าย','out')} ${w.issue}`,'queue')}
    ${tile('#0F766E',L('รอ Checker แพคกิ้ง','Waiting packing check'),w.pack,L('ใบพาเลท','pallet slips'),'')}
   </div>
   <div class="card" style="margin-bottom:14px"><div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px"><h2 style="margin:0">${L('รับเข้า vs จ่ายออก','Received vs released')} (${d.monthly?L('ต่อเดือน','per month'):L('ต่อวัน','per day')})</h2>
     <div style="display:flex;gap:14px;font-size:13px"><span><i style="display:inline-block;width:10px;height:10px;border-radius:2px;background:${VZ.in}"></i> ${L('รับเข้า','Received')} ${kgT(d.period.in_kg)}</span><span><i style="display:inline-block;width:10px;height:10px;border-radius:2px;background:${VZ.out}"></i> ${L('จ่ายออก','Released')} ${kgT(d.period.out_kg)}</span></div></div>
     <div id="dcol" style="margin-top:8px;overflow:hidden"></div></div>
   <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:14px">
    <div class="card"><h2>${L('สต็อกตามชนิดสินค้า','Stock by product type')}</h2><div id="dtype"></div></div>
    <div class="card"><h2>${L('อายุสต็อก (วันนับจากวันผลิต)','Stock age (days since MFG)')}</h2><div id="dage"></div><p class="muted" style="margin:6px 0 0">${L('สีเข้ม = เก่ากว่า','darker = older')}</p></div>
    <div class="card"><h2>${L('สต็อกตามกลุ่ม','Stock by group')}</h2><div id="dgrp"></div></div>
    <div class="card"><h2>${L('จ่ายออกตามประเภท (ช่วงนี้)','Released by type (period)')}</h2><div id="drt"></div></div>
   </div>
   <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:14px;margin-top:14px">
    <div class="card"><h2>${L('สินค้าคงเหลือมากสุด 10 อันดับ','Top 10 products in stock')}</h2><div class="tw" style="max-height:none"><table><thead><tr><th>${L('เบอร์อาหาร','Product')}</th><th class="r">${L('ล็อต','Lots')}</th><th class="r">${L('ถุง','Bags')}</th><th class="r">kg</th></tr></thead><tbody>
     ${d.top_products.map(p=>`<tr class="click" onclick="CARD={p:'${esc(p.code)}',l:''};go('card')"><td>${esc(p.code)}<div class="muted">${esc(p.name)}</div></td><td class="r">${p.lots}</td><td class="r">${n0(p.bags)}</td><td class="r"><b>${kgT(p.kg)}</b></td></tr>`).join('')}</tbody></table></div></div>
    <div class="card"><h2>${L('ลูกค้า 10 อันดับ (จ่ายออกช่วงนี้)','Top 10 customers (released in period)')}</h2><div class="tw" style="max-height:none"><table><thead><tr><th>${L('ลูกค้า','Customer')}</th><th class="r">kg</th></tr></thead><tbody>
     ${d.top_customers.map(x=>`<tr><td>${esc(x.code)}<div class="muted">${esc(x.name)}</div></td><td class="r"><b>${kgT(x.kg)}</b></td></tr>`).join('')||`<tr><td colspan="2" class="muted">${L('ไม่มีการจ่ายในช่วงนี้','No releases in this period')}</td></tr>`}</tbody></table></div></div>
   </div>`;
  colChart($('#dcol'),d.series,d.monthly);hBars($('#dtype'),d.by_type);hBars($('#dage'),d.ages,{seq:true});hBars($('#dgrp'),d.by_group);hBars($('#drt'),d.release_types,{color:VZ.out});
  tipOn($('#dbody'));
  window.onresize=()=>{if(PAGE==='home'&&DASH&&$('#dcol'))colChart($('#dcol'),DASH.series,DASH.monthly);};
}
async function impAccess(){
  const b=$('#impBtn');b.disabled=true;b.textContent=L('กำลังนำเข้า… (ประมาณ 1 นาที)','Importing… (about 1 minute)');
  try{const r=await post('/api/fg/import-access');alert(L('นำเข้าแล้ว','Imported')+': '+Object.entries(r.added).map(([k,v])=>k+' +'+v).join(', '));pgHome();}
  catch(e){alert(e.message);b.disabled=false;b.textContent=L('นำเข้าข้อมูล Access ตอนนี้','Import Access data now');}
}
function mineList(rows){
  if(!rows||!rows.length)return `<div class="muted">${L('ยังไม่มีรายการวันนี้','Nothing yet today')}</div>`;
  return rows.map(r=>`<div class="li"><div class="t"><b>${esc(r.lot_no)}${r.pallet_no?' · P'+esc(r.pallet_no):''}</b><span>${esc(r.product_name)} · ${n0(r.qty)}${r.customer_id?' · '+esc(r.customer_id):''}</span></div>${stPill(r.status)}</div>`).join('');
}

/* ════════ Checklist (shared by receive + issue) ════════ */
let CK={};          // id -> {v:'ok'|'ng', note}
function ckHtml(items){
  return items.map(it=>{const c=CK[it.id]||{};return `<div class="ck ${c.v||''}" id="ck-${it.id}"><div class="rw">
   <div class="t"><small>${esc(TH()?it.th+' · '+it.en:it.en+' · '+it.th)}</small><b>${esc(it.value)}</b></div>
   <button class="ckb o" onclick="ckSet('${it.id}','ok')">OK</button><button class="ckb n" onclick="ckSet('${it.id}','ng')">NG</button></div>
   ${c.v==='ng'?`<input placeholder="${L('เหตุผล (ต้องใส่เมื่อ NG)','Comment (required for NG)')}" value="${esc(c.note||'')}" oninput="CK['${it.id}'].note=this.value;ckFoot()" aria-label="Comment">`:''}</div>`;}).join('');
}
let CKITEMS=[],CKRENDER=null;
function ckSet(id,v){CK[id]=Object.assign(CK[id]||{},{v});if(v==='ok')CK[id].note='';CKRENDER();if(v==='ng')setTimeout(()=>{const i=$('#ck-'+id+' input');if(i)i.focus();},10);}
function ckState(){
  const vs=CKITEMS.map(it=>CK[it.id]||{});
  const all=vs.every(c=>c.v==='ok'),ng=vs.some(c=>c.v==='ng'),miss=vs.some(c=>c.v==='ng'&&!(c.note||'').trim());
  return {all,ng,miss,done:vs.filter(c=>c.v).length};
}
function ckFoot(){const s=ckState();const a=$('#bAp'),r=$('#bRj'),c=$('#ckCnt');
  if(a)a.disabled=!s.all;if(r)r.disabled=!(s.ng&&!s.miss);if(c)c.textContent=`${s.done} / ${CKITEMS.length}`;}

/* ════════ Receive (FG Receiver, phone) ════════ */
let RV=null;
function pgRecv(){
  RV=null;CK={};
  $('#app').innerHTML=`<div class="ph"><h1>${L('ตรวจรับพาเลท','Pallet Checker')}</h1><p class="sub">${L('สแกน QR บนใบพาเลทจากแพคกิ้ง','Scan the QR on the pallet slip from packing')}</p>
   ${scanBox(L('สแกน QR ใบพาเลท','Scan pallet slip QR'),'onRecvScan','#1B75BC')}<div id="rvBody"></div></div>`;
}
async function onRecvScan(text){
  const B=$('#rvBody');B.innerHTML=`<div class="card">${L('กำลังค้นหา…','Looking up…')}</div>`;
  try{RV=await post('/api/fg/scan/receive',{text});}catch(e){B.innerHTML=err(e);return;}
  if(RV.already){rvRead();return;}
  CK={};CKITEMS=RV.items;CKRENDER=rvRender;rvRender();
}
/* b483 — the pallet is already in FG (approved on a phone, or received in the old Access system):
   show what was accepted, read only. */
const LOGL={approved_on_phone:['อนุมัติบนมือถือ','Approved on phone'],rejected_on_phone:['ไม่อนุมัติบนมือถือ','Rejected on phone'],confirmed:['Checker ยืนยันลงสต็อก','Checker confirmed to stock'],
  sendback:['Checker ส่งกลับ','Checker sent back'],sentback:['Checker ส่งกลับ','Checker sent back'],scanned:['สแกนพาเลท','Pallet scanned'],pallet_correct:['ยืนยันว่าพาเลทถูกต้อง','Confirmed: correct pallet'],
  pallet_not_correct:['แจ้งว่าพาเลทไม่ถูกต้อง','Reported: not the right pallet'],chose_full_pallet:['เลือกทั้งพาเลท','Chose full pallet'],chose_part_pallet:['เลือกบางส่วน','Chose part pallet'],
  photo_taken:['ถ่ายรูป','Photo taken'],went_back:['ย้อนกลับ','Went back'],cancelled:['ยกเลิก','Cancelled'],issued_on_phone:['บันทึกจ่ายออก (ตัดสต็อก)','Issue saved (stock reduced)']};
function logList(rows){
  if(!rows||!rows.length)return `<div class="muted">${L('ไม่มีบันทึก','No steps recorded')}</div>`;
  return `<ol class="tl">${rows.map(x=>`<li><b>${esc(L(...(LOGL[x.action]||[x.action,x.action])))}</b><span>${esc(fmtT(x.created_at))} · ${esc(x.user_name||'')}</span>${x.note?`<em>${esc(x.note)}</em>`:''}</li>`).join('')}</ol>`;
}
async function logDlg(kind,id,title){
  let d;try{d=await api(`/api/fg/log?kind=${kind}&ref=${id}`);}catch(e){alert(e.message);return;}
  dlg(`<h2>${esc(title||L('ประวัติขั้นตอน','Audit trail'))}</h2>${logList(d.rows)}<div class="btns" style="justify-content:flex-end;margin-top:12px"><button class="btn" onclick="closeDlg()">${L('ปิด','Close')}</button></div>`);
}
function rvRead(){
  const p=RV.packing,a=RV.already,r=a.rows[0]||{},app=a.src==='app';
  const row=(k,v)=>v===''||v==null?'':`<div class="kv"><span>${k}</span><b>${v}</b></div>`;
  $('#app').innerHTML=`<div class="ph">
   <div class="msg m-ok" style="font-weight:600;display:flex;gap:8px;align-items:center"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
    ${app?L('พาเลทนี้รับเข้า FG แล้ว — ดูอย่างเดียว','Already received into FG — read only'):L('ล็อตนี้รับเข้าแล้วในระบบเดิม (Access) — ดูอย่างเดียว','Already received in the old system (Access) — read only')}</div>
   <div class="hd"><div style="display:flex;justify-content:space-between;gap:8px;align-items:center"><span class="a mono">${esc(p.lot_no)}${p.pallet_no?' · P'+esc(p.pallet_no):''}</span>${app?stPill(r.status):'<span class="pill p-confirmed">Access</span>'}</div>
    <div>${esc(p.product_code)} · ${esc(p.product_name)}</div></div>
   ${app?`<div class="card ro">
     ${row(L('จำนวน','Quantity'),n0(r.qty)+' '+esc(r.unit||''))}${row(L('น้ำหนักรวม','Total weight'),n0(r.total_kg)+' kg')}
     ${row('MFG',r.mfg?fmtD(r.mfg):'')}${row('EXP',r.exp?fmtD(r.exp):'')}
     ${row(L('อนุมัติโดย','Approved by'),esc(r.recv_by)+' · '+esc(fmtT(r.recv_at)))}
     ${row(L('Checker ยืนยัน','Checker confirmed'),r.status==='confirmed'?esc(r.checker||r.checked_by)+' · '+esc(fmtT(r.checked_at)):L('รอ Checker','waiting for the checker'))}
     ${row(L('หมายเหตุ','Comment'),esc(r.note||''))}</div>
    <div style="font-size:13px;color:var(--ink2);margin:12px 2px 6px">${L('เช็คลิสต์ที่บันทึกไว้','Checklist as accepted')}</div>
    ${(r.checklist||[]).map(c=>`<div class="ck ${c.v}"><div class="rw"><div class="t"><small>${esc(TH()?c.th+' · '+c.en:c.en+' · '+c.th)}</small><b>${esc(c.value)}</b>${c.note?`<div class="muted">${esc(c.note)}</div>`:''}</div>
      <span class="pill ${c.v==='ok'?'p-confirmed':'p-rejected'}" style="font-size:13px;padding:4px 12px">${esc((c.v||'-').toUpperCase())}</span></div></div>`).join('')}
    <div style="font-size:13px;color:var(--ink2);margin:12px 2px 6px">${L('ประวัติขั้นตอน','Audit trail')}</div><div class="card">${logList(r.log)}</div>`
   :`<div class="tw xt"><table><thead><tr><th>${L('วันที่','Date')}</th><th class="r">${L('จำนวน','Qty')}</th><th class="r">kg</th><th>${L('ผู้รับ','Receive man')}</th><th>Checker</th></tr></thead><tbody>
     ${a.rows.map(x=>`<tr><td class="nw">${fmtD(x.receive_date)} ${esc(x.receive_time||'')}</td><td class="r">${n0(x.qty)}</td><td class="r">${n0(x.total_kg)}</td><td>${esc(x.receive_man||'')}</td><td>${esc(x.checker||'')}</td></tr>`).join('')}</tbody></table></div>`}
   <button class="btn big" style="background:#1B75BC;border-color:#1B75BC;color:#fff;margin-top:14px" onclick="go('recv')">${L('สแกนพาเลทถัดไป','Scan next pallet')}</button></div>`;
}
function rvRender(){
  const p=RV.packing;
  $('#app').innerHTML=`<div class="ph">
   <div class="hd"><div style="display:flex;justify-content:space-between;gap:8px;align-items:center"><span class="a mono">${esc(p.lot_no)} · P${esc(p.pallet_no)}</span>${stPill(p.status)}</div>
    <div>${esc(p.product_code)} · ${esc(p.product_name)}</div>
    <div class="muted">${L('จากข้อมูลแพคกิ้ง','From packing record')} · ${esc(p.station||'-')} · ${fmtT(p.packed_at)}</div></div>
   ${RV.previous_reject?`<div class="msg m-warn">${L('เคยไม่อนุมัติ:','Rejected before:')} ${esc(RV.previous_reject)}</div>`:''}
   <div style="display:flex;justify-content:space-between;font-size:13px;color:var(--ink2);margin:0 2px 6px"><span>${L('เช็คลิสต์','Checklist')}</span><b id="ckCnt"></b></div>
   ${ckHtml(CKITEMS)}
   <label class="f">${L('หมายเหตุทั่วไป','General comment')}<input class="in" id="rvNote" placeholder="${L('ไม่บังคับ','Optional')}"></label>
   <div class="foot"><button class="btn bad" id="bRj" onclick="rvSend('reject')">${L('ไม่อนุมัติ','Reject')}</button>
    <button class="btn ok" id="bAp" onclick="rvSend('approve')">${L('อนุมัติ','Approve')}</button></div>
   <button class="btn" style="width:100%;margin-top:4px" onclick="go('recv')">${L('ยกเลิก / สแกนใหม่','Cancel / scan again')}</button></div>`;
  ckFoot();
}
async function rvSend(decision){
  const s=ckState();if(decision==='approve'&&!s.all)return;if(decision==='reject'&&!(s.ng&&!s.miss))return;
  const note=$('#rvNote').value;
  $('#bAp').disabled=$('#bRj').disabled=true;
  try{await post('/api/fg/receive',{packing_id:RV.packing.id,decision,checks:CK,note});}catch(e){alert(e.message);ckFoot();return;}
  const ok=decision==='approve';
  doneScreen(ok,ok?L('อนุมัติแล้ว — ย้ายเข้า FG','Approved — moved to FG'):L('ไม่อนุมัติ','Rejected'),
    ok?[L('บันทึกเข้าตารางคลังสินค้า (รับเข้า)','Saved to the Warehouse receive table.'),L('ข้อมูลแพคกิ้งถูกบันทึกว่า “ย้ายเข้า FG แล้ว”','Packing record marked “Moved to FG”.'),L('รอ Checker ยืนยันบน PC','Now waiting for the Checker PC.')]
      :[L('ไม่ย้ายเข้า FG — ข้อมูลแพคกิ้งถูกบันทึกว่า “FG ไม่รับ” พร้อมเหตุผล','Not moved. Packing record marked “Rejected by FG” with your comments.')],'recv','#1B75BC');
}
function doneScreen(ok,title,lines,back,col){
  $('#app').innerHTML=`<div class="ph done"><div class="c" style="background:${ok?'#16A34A':'#DC2626'}"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${ok?'M5 13l4 4L19 7':'M6 6l12 12M18 6L6 18'}"/></svg></div>
   <h2 style="font-size:22px">${esc(title)}</h2>${lines.map(l=>`<p style="margin:4px 0">${esc(l)}</p>`).join('')}
   <button class="btn big" style="background:${col};border-color:${col};color:#fff;margin-top:18px" onclick="go('${back}')">${L('สแกนพาเลทถัดไป','Scan next pallet')}</button>
   <button class="btn" style="width:100%;margin-top:8px" onclick="go(pages().some(p=>p[0]==='${back==='recv'?'myrecv':'myissue'}')?'${back==='recv'?'myrecv':'myissue'}':'home')">${L('งานของฉัน','My jobs')}</button></div>`;
  refreshCounts();
}

/* ════════ Issue (FG Issuer, phone) ════════ */
let IS=null;
function pgIssue(){
  IS=null;CK={};
  $('#app').innerHTML=`<div class="ph"><h1>${L('โหลดพาเลท','Pallet Loader')}</h1><p class="sub">${L('สแกน QR ใบพาเลท หรือพิมพ์เลขล็อต','Scan the pallet-slip QR, or type a lot number')}</p>
   ${scanBox(L('สแกนพาเลทเพื่อจ่าย','Scan pallet to issue'),'onIssueScan','#7C3AED',L('หรือพิมพ์เลขล็อต แล้วกด Enter','or type a lot number, then Enter'))}<div id="isBody"></div></div>`;
}
async function onIssueScan(text){
  const B=$('#isBody');B.innerHTML=`<div class="card">${L('กำลังค้นหา…','Looking up…')}</div>`;
  try{IS=await post('/api/fg/scan/issue',{text});}catch(e){B.innerHTML=err(e);return;}
  IS.form={qty:IS.qty_default,customer_id:'',release_type:IS.release_types[0],plate:'',release_no:'',memo:''};IS.mode='';ISPH=null;
  isConfirm();
}
/* b483 loader flow: scan → "is this the pallet you are loading?" → full / part → load details → save.
   Every tap is written to the audit trail (issue-step), and copied onto the release when it is saved. */
const isStep=(step,note)=>{post('/api/fg/issue-step',{flow:IS.flow,step,note:note||''}).catch(()=>{});};
const isAvail=()=>{const s=IS.stock;return s.avail||(s.pallet_left!=null?s.pallet_left:(s.slip_qty||s.lot_left));};
function isHead(){const s=IS.stock;return `<div class="hd"><span class="a mono">${esc(s.lot_no)}${s.pallet_no?' · P'+esc(s.pallet_no):''}</span><div>${esc(s.product_id)} · ${esc(s.product_name)}</div></div>`;}
function isSteps(n){const t=[L('ตรวจพาเลท','Check'),L('ทั้ง/บางส่วน','Full / part'),L('ข้อมูลโหลด','Load details')];
  return `<div class="stp">${t.map((x,i)=>`<span class="${i<n?'on':''}${i===n-1?' cur':''}">${i+1}. ${x}</span>`).join('')}</div>`;}
function isConfirm(){
  const s=IS.stock,av=isAvail();
  const row=(k,v)=>v===''||v==null?'':`<div class="kv"><span>${k}</span><b>${v}</b></div>`;
  $('#app').innerHTML=`<div class="ph">${isSteps(1)}
   <h2 style="margin:4px 2px 10px">${L('พาเลทที่กำลังจะโหลด ถูกต้องไหม?','Is this the pallet you are about to load?')}</h2>
   <div class="card ro" style="border:2px solid #7C3AED">
    ${row(L('เบอร์อาหาร','Product'),esc(s.product_id))}${row(L('ชื่อสินค้า','Name'),esc(s.product_name))}
    ${row(L('เลขล็อต','Lot no.'),`<span class="mono">${esc(s.lot_no)}</span>`)}${row(L('พาเลท','Pallet'),s.pallet_no?'P'+esc(s.pallet_no):'')}
    ${row(L('จำนวนบนพาเลท','Bags on pallet'),`<span style="font-size:20px">${n0(av)}</span> ${esc(s.unit)}`)}${row(L('น้ำหนัก','Weight'),s.weight_unit?n0(av*s.weight_unit)+' kg ('+n0(s.weight_unit)+' kg/'+L('ถุง','bag')+')':'')}
    ${row('MFG',s.mfg?fmtD(s.mfg):'')}${row('EXP',s.exp?fmtD(s.exp):'')}${row(L('คงเหลือทั้งล็อต','Lot balance'),n0(s.lot_left)+' '+esc(s.unit))}
    ${row(L('ที่มา','Source'),s.src==='app'?L('รับเข้าผ่านแอป','Received in the app'):L('รับเข้าในระบบเดิม (Access)','Received in the old system (Access)'))}</div>
   ${IS.fefo_older.length?`<div class="msg m-warn">FEFO: ${L('มีล็อตเก่ากว่าของสินค้านี้ในสต็อก — ควรโหลดก่อน','older lots of this product are in stock — load those first')}: <b>${IS.fefo_older.map(esc).join(', ')}</b></div>`:''}
   <div class="foot"><button class="btn bad big" onclick="isWrong()">✗ ${L('ไม่ถูกต้อง','Not correct')}</button><button class="btn ok big" onclick="isStep('correct');isMode()">✓ ${L('ถูกต้อง','Correct')}</button></div>
   <button class="btn" style="width:100%;margin-top:4px" onclick="isStep('cancel','before confirm');go('issue')">${L('ยกเลิก / สแกนใหม่','Cancel / scan again')}</button></div>`;
}
function isWrong(){
  const rs=[L('สินค้าผิด','Wrong product'),L('ล็อตผิด','Wrong lot'),L('พาเลทผิด','Wrong pallet'),L('จำนวนไม่ตรง','Bag count does not match'),L('สินค้าเสียหาย','Damaged')];
  dlg(`<h2>${L('พาเลทไม่ถูกต้อง — เพราะอะไร?','Not the right pallet — why?')}</h2><div style="display:grid;gap:8px">
   ${rs.map(r=>`<button class="btn" style="justify-content:flex-start" onclick="$('#isWr').value=${esc(JSON.stringify(r))}">${esc(r)}</button>`).join('')}
   <label class="f">${L('เหตุผล','Reason')} *<input class="in" id="isWr" placeholder="${L('พิมพ์เหตุผล','type a reason')}"></label><div id="isWe"></div>
   <div class="btns" style="justify-content:flex-end"><button class="btn" onclick="closeDlg()">${L('กลับ','Back')}</button><button class="btn bad" onclick="isWrongSave()">${L('บันทึก แล้วสแกนใหม่','Save and scan again')}</button></div></div>`);
}
function isWrongSave(){const r=$('#isWr').value.trim();if(!r){$('#isWe').innerHTML=err(L('ใส่เหตุผล','Enter a reason'));return;}
  isStep('not_correct',r);closeDlg();go('issue');setTimeout(()=>{const b=$('#isBody');if(b)b.innerHTML=`<div class="msg m-warn">${L('บันทึกแล้ว: พาเลทไม่ถูกต้อง','Recorded: not the right pallet')} — ${esc(r)}. ${L('ไม่ได้ตัดสต็อก สแกนพาเลทที่ถูกต้อง','Stock not changed. Scan the right pallet.')}</div>`;},30);}
function isMode(){
  const s=IS.stock,av=isAvail();
  $('#app').innerHTML=`<div class="ph">${isSteps(2)}${isHead()}
   <h2 style="margin:4px 2px 10px">${L('ใช้ทั้งพาเลท หรือ บางส่วน?','Full pallet or part of it?')}</h2>
   <div style="display:grid;gap:10px">
    <button class="btn ok big" style="min-height:76px" onclick="IS.mode='full';IS.form.qty=${av};isStep('full','${n0(av)} ${esc(s.unit)}');isLoad()">${L('ทั้งพาเลท','Full pallet')}<br><small style="font-weight:500">${n0(av)} ${esc(s.unit)}</small></button>
    <button class="btn big" style="min-height:76px;border-color:#D97706;color:#92400E" onclick="isPartOpen()">${L('บางส่วน','Part of the pallet')}<br><small style="font-weight:500">${L('ใส่จำนวนถุง + ถ่ายรูป','enter bags + take a photo')}</small></button>
    <div id="isPart" class="hidden card" style="display:grid;gap:10px">
     <label class="f">${L('จำนวนถุงที่โหลด','Bags to load')} (1–${n0(av-1)})<input class="in" id="isPq" type="number" inputmode="numeric" min="1" max="${av-1}" style="font-size:22px;font-weight:700" value="${IS.mode==='part'?IS.form.qty:''}"></label>
     <div class="btns"><label class="btn pri" style="flex:1;text-align:center">${L('ถ่ายรูป','Take picture')}<input type="file" accept="image/*" capture="environment" style="display:none" onchange="isPhoto(this)"></label>
      <label class="btn" style="flex:1;text-align:center">${L('อัปโหลดรูป','Upload picture')}<input type="file" accept="image/*" style="display:none" onchange="isPhoto(this)"></label></div>
     <div id="isPv" class="muted">${ISPH?`<img src="${ISPH.data}" alt="photo" style="max-width:100%;border-radius:8px">`:L('ต้องมีรูปพาเลทที่เหลือ / ถุงที่เอาไป','A photo is required')}</div><div id="isE"></div>
     <button class="btn ok big" onclick="isPartNext()">${L('ถัดไป','Next')}</button></div>
   </div>
   <div class="foot"><button class="btn" onclick="isStep('back','to pallet check');isConfirm()">${L('ย้อนกลับ','Back')}</button><button class="btn" onclick="isStep('cancel','at full/part');go('issue')">${L('ยกเลิก','Cancel')}</button></div></div>`;
  if(IS.mode==='part')isPartOpen(true);
}
function isPartOpen(){$('#isPart').classList.remove('hidden');}
function isPartNext(){
  const av=isAvail(),q=+$('#isPq').value||0;
  if(q<=0||q>=av){$('#isE').innerHTML=err(L(`ใส่จำนวน 1–${n0(av-1)} ถุง`,`Enter 1–${n0(av-1)} bags`));return;}
  if(!ISPH){$('#isE').innerHTML=err(L('ต้องถ่ายรูปหรืออัปโหลดรูป','Take or upload a picture first'));return;}
  IS.mode='part';IS.form.qty=q;isStep('part',`${n0(q)} of ${n0(av)} ${IS.stock.unit}`);isLoad();
}
function isLoad(){
  const s=IS.stock,f=IS.form,av=isAvail();
  $('#app').innerHTML=`<div class="ph">${isSteps(3)}${isHead()}
   <div class="msg ${IS.mode==='full'?'m-ok':'m-warn'}" style="font-weight:600">${IS.mode==='full'?L('ทั้งพาเลท','Full pallet'):L('บางส่วน','Part')} · ${n0(f.qty)} ${esc(s.unit)}${IS.mode==='part'?` ${L('จาก','of')} ${n0(av)}`:''}${s.weight_unit?` · ${n0(f.qty*s.weight_unit)} kg`:''}</div>
   <div class="card" style="display:grid;gap:10px">
    <label class="f">${L('ลูกค้า','Customer')} *<input class="in" id="isC" value="${esc(f.customer_id)}" placeholder="${L('พิมพ์รหัสหรือชื่อลูกค้า','type customer code or name')}" autocomplete="off"></label><div id="isCn" class="muted" style="margin-top:-6px"></div>
    <label class="f">${L('ประเภทจ่าย','Release type')} *<select class="in" id="isT">${IS.release_types.map(t=>`<option ${t===f.release_type?'selected':''}>${esc(t)}</option>`).join('')}</select></label>
    <label class="f">${L('ทะเบียนรถ','Truck plate')}<input class="in" id="isP" value="${esc(f.plate)}"></label>
    <label class="f">${L('เลขที่ใบจ่าย / แผน','Release no. / plan')}<input class="in" id="isN" value="${esc(f.release_no)}"></label>
    <label class="f">${L('หมายเหตุ','Memo')}<input class="in" id="isM" value="${esc(f.memo)}"></label></div><div id="isE"></div>
   <div class="foot"><button class="btn" onclick="isKeep();isStep('back','to full/part');isMode()">${L('ย้อนกลับ','Back')}</button><button class="btn ok" id="isGo" onclick="isSave()">${L('ยืนยันโหลด → ตัดสต็อก','Confirm load → reduce stock')}</button></div></div>`;
  const cn=()=>{const c=IS.customers.find(x=>x.code===$('#isC').value.trim());$('#isCn').textContent=c?c.name:'';};
  ta($('#isC'),q=>{q=q.toLowerCase();return IS.customers.filter(c=>(c.code+' '+c.name).toLowerCase().includes(q)).slice(0,12).map(c=>({v:c.code,t:c.code,s:c.name}));},cn);
  $('#isC').addEventListener('input',cn);cn();
}
function isKeep(){const f=IS.form;f.customer_id=$('#isC').value.trim();f.release_type=$('#isT').value;f.plate=$('#isP').value;f.release_no=$('#isN').value;f.memo=$('#isM').value;}
async function isSave(){
  isKeep();const f=IS.form,s=IS.stock;
  if(!IS.customers.some(c=>c.code===f.customer_id)){$('#isE').innerHTML=err(L('เลือกลูกค้าจากรายการ','Pick a customer from the list'));return;}
  const checks={};['product','lot','qty','customer','type','plate'].forEach(k=>checks[k]={v:'ok'});   // confirmed on the "correct?" screen + this summary
  const b=Object.assign({decision:'approve',stock:s,checks,mode:IS.mode,flow:IS.flow},f);
  if(IS.mode==='part'){b.photo=ISPH.data;b.photo_at=ISPH.at;}
  $('#isGo').disabled=true;
  let r;try{r=await post('/api/fg/issue',b);}catch(e){$('#isGo').disabled=false;$('#isE').innerHTML=err(e);return;}
  doneScreen(true,L('โหลดแล้ว — ตัดสต็อก','Loaded — stock reduced'),[(r.mode==='full'?L('ทั้งพาเลท','Full pallet'):L('บางส่วน','Part'))+` · ${n0(r.qty)} ${s.unit} · ${f.customer_id}`,
    L('บันทึกทุกขั้นตอนไว้ในประวัติแล้ว','Every step is saved in the audit trail.'),L('รอ Checker ยืนยันบน PC','Now waiting for the Checker PC.')],'issue','#7C3AED');
}

/* ════════ My jobs — FG receiver ════════ */
const FIX={waiting_packing:['รอแพคกิ้งแก้ไข','Waiting for packing to fix','p-waiting'],fixed_not_printed:['แพคกิ้งแก้แล้ว ยังไม่พิมพ์ใหม่','Fixed, not reprinted yet','p-waiting'],
  reprinted_pending:['พิมพ์ใหม่แล้ว · รอ Checker แพคกิ้ง','Reprinted · waiting packing check','p-packed'],reprinted_approved:['พิมพ์ใหม่แล้ว · พร้อมรับ','Reprinted · ready to receive','p-confirmed'],
  reprinted_rejected:['พิมพ์ใหม่ · Checker แพคกิ้งไม่ผ่าน','Reprinted · packing check rejected','p-rejected'],received_again:['รับเข้าใหม่แล้ว','Received again','p-confirmed'],cancelled:['แพคกิ้งยกเลิกใบนี้','Slip cancelled by packing','p-cancelled']};
let MYF={d1:daysAgo(6),d2:today(),st:''};
function myBar(kind){
  const sts=kind==='recv'?['','waiting','confirmed','rejected','sentback']:['','waiting','confirmed','sentback'];
  return `<div class="bar"><label class="f">${L('จาก','From')}<input class="in" type="date" id="m1" value="${MYF.d1}"></label><label class="f">${L('ถึง','To')}<input class="in" type="date" id="m2" value="${MYF.d2}"></label>
   <button class="btn pri" onclick="MYF.d1=$('#m1').value;MYF.d2=$('#m2').value;${kind==='recv'?'myRecvLoad':'myIssueLoad'}()">${L('แสดง','Show')}</button></div>
   <div class="tabs">${sts.map(s=>`<button class="tab ${MYF.st===s?'on':''}" onclick="MYF.st='${s}';${kind==='recv'?'myRecvLoad':'myIssueLoad'}()">${s?esc(L(...STL[s])):L('ทั้งหมด','All')}</button>`).join('')}</div>`;
}
async function pgMyRecv(){$('#app').innerHTML=`<div class="ph"><h1>${L('งานรับเข้าของฉัน','My receive jobs')}</h1><p class="sub">${L('พาเลทที่ฉันอนุมัติ / ไม่อนุมัติ และสถานะการแก้ไขของแพคกิ้ง','pallets I approved / rejected, and what packing did about the rejected ones')}</p><div id="myBar"></div><div id="myBody"></div></div>`;myRecvLoad();}
let MYR=[];
/* group rows by day — newest day first, newest job first inside each day */
function byDay(rows,key){
  const g={};rows.slice().sort((a,b)=>(b[key]||'').localeCompare(a[key]||'')||b.id-a.id).forEach(r=>{const d=(r[key]||'').slice(0,10);(g[d]=g[d]||[]).push(r);});
  return Object.keys(g).sort().reverse().map(d=>({d,rows:g[d]}));
}
function dayHead(d,n){const t=d===today()?L('วันนี้','Today'):d===daysAgo(1)?L('เมื่อวาน','Yesterday'):'';
  return `<div style="display:flex;justify-content:space-between;align-items:center;margin:14px 2px 6px;font-weight:700;color:#334155"><span>${fmtD(d)}${t?' · '+t:''}</span><span class="muted">${n} ${L('พาเลท','pallets')}</span></div>`;}
async function myRecvLoad(){
  $('#myBar').innerHTML=myBar('recv');
  let d;try{d=await api(`/api/fg/my?kind=recv&d1=${MYF.d1}&d2=${MYF.d2}&status=${MYF.st}`);}catch(e){$('#myBody').innerHTML=err(e);return;}
  MYR=d.rows;const n=s=>MYR.filter(r=>r.status===s).length;
  $('#myBody').innerHTML=`<p class="muted">${MYR.length} ${L('พาเลท','pallets')} · ${L('อนุมัติ','approved')} ${n('waiting')+n('confirmed')} · ${L('ไม่อนุมัติ','rejected')} ${n('rejected')}</p>`+
   (byDay(MYR,'recv_at').map(g=>dayHead(g.d,g.rows.length)+g.rows.map(r=>{const f=FIX[r.fix],ng=(r.checklist||[]).filter(c=>c.v==='ng');
    return `<button class="li" style="flex-wrap:wrap;width:100%;text-align:left;cursor:pointer;font:inherit" onclick="myRecvDlg(${r.id})"><div class="t"><b class="mono">${esc(r.lot_no)} · P${esc(r.pallet_no)}</b><span>${esc(r.product_name)} · ${n0(r.qty)} · ${esc((r.recv_at||'').slice(11,16))}</span>
     ${r.status==='rejected'?`<span style="white-space:normal;color:var(--bad)">${ng.map(c=>esc((TH()?c.th:c.en)+': '+c.note)).join(' · ')||esc(r.note||'')}</span>`:''}</div>
    <div style="display:flex;flex-direction:column;gap:4px;align-items:flex-end">${stPill(r.status)}${f?`<span class="pill ${f[2]}">${esc(L(f[0],f[1]))}</span>`:''}</div></button>`;}).join('')).join('')
    ||`<div class="muted">${L('ไม่มีรายการ','Nothing in this range')}</div>`);
}
function myRecvDlg(id){
  const r=MYR.find(x=>x.id===id);if(!r)return;const f=FIX[r.fix];
  const kv=(th,en,v)=>`<div style="color:var(--ink2);font-size:13px">${th} · ${en}</div><div style="font-weight:600">${v}</div>`;
  const steps=[[L('แพคกิ้งพิมพ์ใบ','Packed / slip printed'),r.packed_at,r.staff_name],[L('Checker แพคกิ้ง','Packing check'),r.pc_at,r.pc_by],
    [r.status==='rejected'?L('ฉันไม่อนุมัติ','I rejected'):L('ฉันอนุมัติ','I approved'),r.recv_at,''],[L('Checker ยืนยัน','Checker'),r.checked_at,r.checker]].filter(x=>x[1]);
  dlg(`<div style="display:flex;justify-content:space-between;gap:8px;align-items:flex-start"><div><h2 class="mono" style="margin:0">${esc(r.lot_no)} · P${esc(r.pallet_no)}</h2><div class="muted">${esc(r.product_id)} · ${esc(r.product_name)}</div></div>
     <div style="display:flex;flex-direction:column;gap:4px;align-items:flex-end">${stPill(r.status)}${f?`<span class="pill ${f[2]}">${esc(L(f[0],f[1]))}</span>`:''}</div></div>
   <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px 14px;margin:14px 0">
    ${kv('จำนวน','Qty',`${n0(r.qty)} ${esc(r.unit||'')}`)}${kv('น้ำหนักรวม','Total weight',n0(r.total_kg)+' kg')}
    ${kv('วันผลิต','MFG',fmtD(r.mfg))}${kv('หมดอายุ','EXP',fmtD(r.exp))}
    ${kv('เครื่อง / ไลน์','Machine / line',esc((r.pack_machine||'-')+' · '+(r.pd_line||'-')))}${kv('เอกสาร','Doc no.',esc(r.doc_no||'-'))}</div>
   <h2 style="font-size:15px">${L('เช็คลิสต์ที่ฉันตรวจ','My checklist')}</h2>
   ${(r.checklist||[]).map(c=>`<div style="display:flex;gap:8px;align-items:flex-start;padding:6px 0;border-top:1px solid var(--soft)"><span class="pill ${c.v==='ok'?'p-confirmed':'p-rejected'}" style="min-width:36px;text-align:center">${esc((c.v||'-').toUpperCase())}</span>
     <div style="flex:1"><div style="font-size:12px;color:var(--ink2)">${esc(TH()?c.th+' · '+c.en:c.en+' · '+c.th)}</div><div>${esc(c.value)}</div>${c.note?`<div style="color:var(--bad)">${esc(c.note)}</div>`:''}</div></div>`).join('')}
   ${r.note?`<div class="msg m-info">${L('หมายเหตุ','Comment')}: ${esc(r.note)}</div>`:''}
   <h2 style="font-size:15px;margin-top:12px">${L('ลำดับเหตุการณ์','Timeline')}</h2>
   ${steps.map(x=>`<div style="display:flex;justify-content:space-between;padding:5px 0;border-top:1px solid var(--soft)"><span>${esc(x[0])}${x[2]?' · '+esc(x[2]):''}</span><span class="muted">${fmtT(x[1])}</span></div>`).join('')}
   ${r.status==='rejected'&&r.fixed_at?`<div style="display:flex;justify-content:space-between;padding:5px 0;border-top:1px solid var(--soft)"><span>${L('แพคกิ้งแก้ไข','Packing fixed')}</span><span class="muted">${fmtT(r.fixed_at)}</span></div>`:''}
   ${r.status==='rejected'&&r.printed_at&&r.fixed_at&&r.printed_at>=r.fixed_at?`<div style="display:flex;justify-content:space-between;padding:5px 0;border-top:1px solid var(--soft)"><span>${L('พิมพ์ใบใหม่','Reprinted')}</span><span class="muted">${fmtT(r.printed_at)}</span></div>`:''}
   ${r.again?`<div style="display:flex;justify-content:space-between;padding:5px 0;border-top:1px solid var(--soft)"><span>${L('รับเข้าใหม่','Received again')}</span><span class="muted">${fmtT(r.again)}</span></div>`:''}
   <div class="btns" style="justify-content:flex-end;margin-top:12px"><button class="btn" onclick="closeDlg()">${L('ปิด','Close')}</button></div>`);
}

/* ════════ My jobs — FG issuer ════════ */
async function pgMyIssue(){$('#app').innerHTML=`<h1>${L('งานจ่ายออกของฉัน','My issue jobs')}</h1><p class="sub">${L('บันทึกการจ่ายของฉัน สำหรับตรวจย้อนหลัง','my own issue records, for review later')}</p><div id="myBar"></div><div id="myBody"></div>`;myIssueLoad();}
let MYI=[];
async function myIssueLoad(){
  $('#myBar').innerHTML=myBar('issue');
  let d;try{d=await api(`/api/fg/my?kind=issue&d1=${MYF.d1}&d2=${MYF.d2}&status=${MYF.st}`);}catch(e){$('#myBody').innerHTML=err(e);return;}
  MYI=d.rows;const tq=MYI.reduce((a,r)=>a+r.qty,0),tk=MYI.reduce((a,r)=>a+(r.total_kg||0),0);
  $('#myBody').innerHTML=`<p class="muted">${MYI.length} ${L('รายการ','jobs')} · ${n0(tq)} ${L('ถุง','bags')} · ${n0(tk)} kg</p>
   <div class="tw"><table><thead><tr><th>${L('เวลา','Time')}</th><th>${L('เบอร์อาหาร','Product')}</th><th>Lot No.</th><th>${L('แบบ','Mode')}</th><th class="r">${L('จ่าย','Issued')}</th><th class="r">${L('บนพาเลท','On pallet')}</th><th class="r">kg</th><th>${L('ลูกค้า','Customer')}</th><th>${L('ทะเบียน','Plate')}</th><th>${L('รูป','Photo')}</th><th>${L('สถานะ','Status')}</th></tr></thead><tbody>
   ${byDay(MYI,'issue_at').map(g=>`<tr><td colspan="11" style="background:#F1F5F9;font-weight:700">${fmtD(g.d)} · ${g.rows.length} ${L('รายการ','jobs')}</td></tr>`+g.rows.map(r=>`<tr><td class="nw">${esc((r.issue_at||'').slice(11,16))}</td><td>${esc(r.product_id)}<div class="muted">${esc(r.product_name)}</div></td><td class="mono nw">${esc(r.lot_no)}${r.pkey?'<div class="muted">P'+esc(r.pkey.split('|')[2]||'')+'</div>':''}</td>
    <td>${modePill(r.issue_mode)}</td><td class="r"><b>${n0(r.qty)}</b></td><td class="r">${r.pallet_bags?n0(r.pallet_bags):'-'}</td><td class="r">${n0(r.total_kg)}</td>
    <td>${esc(r.customer_id)}<div class="muted">${esc(r.release_type)}</div></td><td>${esc(r.plate||'-')}</td><td>${photoBtn(r)}</td><td>${stPill(r.status)} <button class="btn sm" onclick="logDlg('release',${r.id})">${L('ขั้นตอน','Steps')}</button>${r.checker?`<div class="muted">${esc(r.checker)}</div>`:''}</td></tr>`).join('')).join('')
    ||`<tr><td colspan="11" class="muted" style="padding:20px;text-align:center">${L('ไม่มีรายการ','Nothing in this range')}</td></tr>`}</tbody></table></div>`;
}
const modePill=m=>m==='part'?`<span class="pill p-waiting">${L('บางส่วน','Part')}</span>`:m==='full'?`<span class="pill p-confirmed">${L('ทั้งพาเลท','Full')}</span>`:'-';
const photoBtn=r=>r.photo?`<button class="btn" style="min-height:32px;padding:3px 10px" onclick='photoDlg(${JSON.stringify(r.photo)},${JSON.stringify(r.photo_at||"")})'>${L('ดูรูป','Photo')}</button>`:'-';
function photoDlg(src,at){dlg(`<h2>${L('รูปจ่ายบางส่วน','Part-pallet photo')}</h2><p class="muted">${L('ถ่ายเมื่อ','Taken')} ${esc(fmtT(at))}</p><img src="${esc(src)}" alt="photo" style="max-width:100%;border-radius:8px"><div class="btns" style="justify-content:flex-end;margin-top:10px"><button class="btn" onclick="closeDlg()">${L('ปิด','Close')}</button></div>`);}

/* ════════ Issue: accept → full pallet or part (+ stamped photo) ════════ */
let ISPH=null;
async function isPhoto(inp){
  const f=inp.files&&inp.files[0];inp.value='';if(!f)return;
  try{
    const img=new Image();img.src=URL.createObjectURL(f);await img.decode();
    const k=Math.min(1,1600/Math.max(img.width,img.height)),W=Math.round(img.width*k),H=Math.round(img.height*k);
    const cv=document.createElement('canvas');cv.width=W;cv.height=H;const g=cv.getContext('2d');g.drawImage(img,0,0,W,H);
    const d=new Date(),p=x=>String(x).padStart(2,'0');
    const at=`${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
    const s=IS.stock,txt1=`${p(d.getDate())}/${p(d.getMonth()+1)}/${d.getFullYear()} ${at.slice(11)}`,txt2=`${s.lot_no}${s.pallet_no?' P'+s.pallet_no:''} · ${ME.name}`;
    const fs=Math.max(18,Math.round(W/34)),bh=fs*2.9;
    g.fillStyle='rgba(0,0,0,.62)';g.fillRect(0,H-bh,W,bh);g.fillStyle='#fff';g.font=`bold ${fs}px sans-serif`;g.textBaseline='top';
    g.fillText(txt1,fs*.6,H-bh+fs*.3);g.font=`${Math.round(fs*.8)}px sans-serif`;g.fillText(txt2,fs*.6,H-bh+fs*1.5);
    ISPH={data:cv.toDataURL('image/jpeg',.8),at};isStep('photo',at);
    $('#isPv').innerHTML=`<img src="${ISPH.data}" alt="photo" style="max-width:100%;border-radius:8px"><div>${L('ถ่าย/อัปโหลดเมื่อ','Stamped')} ${esc(fmtT(at))}</div>`;
  }catch(e){$('#isPv').innerHTML=err(L('อ่านรูปไม่ได้','Cannot read that picture'));}
}

/* ════════ Checker queue (PC) ════════ */
let QK='recv',QROWS=[],QSEL={};
async function pgQueue(){
  const A=$('#app');
  A.innerHTML=`<div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;align-items:flex-end;margin-bottom:12px" class="noprint">
    <div><h1>${L('คิวตรวจสอบ','Checker queue')}</h1><p class="sub" style="margin:0">${L('บันทึกการรับเข้า-จ่ายออก FG/WIP/SEMI','Receive / issue record FG/WIP/SEMI')} · F-WI04-WHD01-04 · ${fmtD(today())}</p></div>
    <div class="btns"><label class="f">${L('ผู้ตรวจสอบ','Checker')}<select class="in" id="qChk">${(ME.checkers.length?ME.checkers:[ME.name]).map(n=>`<option ${n===localStorage.getItem('fg_checker')?'selected':''}>${esc(n)}</option>`).join('')}</select></label>
     <button class="btn" onclick="qPrint()">${L('พิมพ์แบบฟอร์มวันนี้','Print today’s form')}</button>
     <button class="btn" onclick="qCsv()">Excel (CSV)</button></div></div>
   <div class="tabs noprint" id="qTabs"></div>
   <div id="qBody">${LOADH}</div>
   <div class="paper" id="qPaper"></div>`;
  $('#qChk').onchange=e=>{try{localStorage.setItem('fg_checker',e.target.value)}catch(x){}};
  await qLoad();
}
async function qLoad(){
  QSEL={};
  try{QROWS=(await api('/api/fg/queue?kind='+QK)).rows;}catch(e){$('#qBody').innerHTML=err(e);return;}
  await refreshCounts();
  $('#qTabs').innerHTML=`<button class="tab ${QK==='recv'?'on':''}" onclick="QK='recv';qLoad()">${L('รับเข้า','Receive')} · ${CNT.recv_waiting||0}</button>
    <button class="tab ${QK==='issue'?'on':''}" onclick="QK='issue';qLoad()">${L('จ่ายออก','Issue')} · ${CNT.issue_waiting||0}</button>`;
  qDraw();
}
function qDraw(){
  const R=QK==='recv',rows=QROWS;
  QROWS.forEach((r,i)=>r._n=i+1);
  const cols=[XC('_n',L('ลำดับ','No.'),{num:1,w:'54px'}),XC('pallet_no',L('พาเลท','Pallet'),{fmt:r=>`<b>${esc(r.pallet_no||'-')}</b>`,cls:'nw'}),
   XC('product_id',L('เบอร์อาหาร','Product'),{fmt:pName,val:pVal}),XC('lot_no','Lot No.',{fmt:r=>`<b>${esc(r.lot_no)}</b>`,cls:'mono nw'}),XC('packaging',L('บรรจุภัณฑ์','Packaging')),
   XC('qty',L('จำนวน','Qty'),{r:1,num:1,fmt:r=>n0(r.qty)}),XC('wu','kg/'+L('หน่วย','unit'),{r:1,num:1,val:r=>R?r.weight_unit:(r.qty?Math.round((r.total_kg||0)/r.qty*100)/100:''),fmt:r=>R?n0(r.weight_unit):(r.qty?n0((r.total_kg||0)/r.qty):'-')}),
   XC('total_kg',L('รวม kg','Total kg'),{r:1,num:1,fmt:r=>`<b>${n0(r.total_kg)}</b>`}),
   R?XC('receive_man',L('ผู้ดำเนินการ','Packed by')):XC('customer_id',L('ลูกค้า / ประเภท','Customer / type'),{val:r=>(r.customer_id||'')+(r.customer_name?' · '+r.customer_name:''),fmt:r=>esc(r.customer_id)+(r.customer_name?'<div class="muted">'+esc(r.customer_name)+'</div>':'')+'<div class="muted">'+esc(r.release_type)+'</div>'}),
   R?XC('location',L('แหล่งจัดเก็บ','Location')):XC('plate',L('ทะเบียนรถ','Plate')),
   XC('by',L('มือถือ','Phone check'),{val:r=>R?r.recv_by:r.issue_by,fmt:r=>`<span class="pill p-confirmed">${esc(R?r.recv_by:r.issue_by)} · ${esc((R?r.recv_at:r.issue_at).slice(11,16))}</span>`,cls:'nw'}),
   XC('note',L('หมายเหตุ','Remark'),{val:r=>R?(r.note||r.memo||''):(r.issue_mode||''),fmt:r=>(R?'':modePill(r.issue_mode)+(r.issue_mode==='part'?`<div class="muted">${n0(r.qty)} / ${n0(r.pallet_bags)}</div>`:'')+' '+photoBtn(r))+esc(r.note||r.memo||'')}),
   XC('_v','',{nf:1,fmt:r=>`<button class="btn sm" onclick="qDetail(${r.id})">${L('ดู','View')}</button>`})];
  $('#qBody').innerHTML=`<div id="qT"></div><div id="qFoot"></div>`;
  xTable($('#qT'),'q'+QK,cols,rows,{select:QSEL,empty:L('ไม่มีรายการรอตรวจสอบ','Nothing waiting — all confirmed'),foot:xFoot('qty','total_kg'),after:qFoot});
}
function qFoot(){
  const rows=QROWS,sum={all:0,Brand:0,B2B:0,BB:0,'':0};rows.forEach(r=>{sum.all+=r.total_kg||0;sum[r.group||'']+=r.total_kg||0;});
  const nsel=rows.filter(r=>QSEL[r.id]).length;
  $('#qFoot').innerHTML=`
   <div class="card noprint" style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;align-items:center;margin-top:12px">
    <div style="display:flex;gap:18px;flex-wrap:wrap"><span>${L('ยอดรวม','Total')}: <b>${n0(sum.all)} kg</b></span>
     <span>Brand <b>${n0(sum.Brand)}</b> · B2B <b>${n0(sum.B2B)}</b> · BB <b>${n0(sum.BB)}</b>${sum['']?` · ${L('อื่นๆ','Other')} <b>${n0(sum[''])}</b>`:''}</span>
     <span class="muted">${nsel} ${L('รายการที่เลือก','selected')}</span></div>
    <div class="btns"><button class="btn badl" ${nsel?'':'disabled'} onclick="qAct('sendback')">${L('ส่งกลับ','Send back')}</button>
     <button class="btn ok" ${nsel?'':'disabled'} onclick="qAct('confirm')">${L('ยืนยันที่เลือก → ลงสต็อก','Confirm selected → stock')}</button></div></div>
   <p class="muted noprint">${L('ยืนยันแล้วจะบันทึกลงตารางรับเข้า/จ่ายออก ปรับยอดสต็อกและสต็อกการ์ด พร้อมชื่อผู้ตรวจสอบและเวลา ไม่มีการลบข้อมูล','Confirm posts the rows to the receive / release tables, updates stock and the stock card, and stamps the checker name and time. Nothing is deleted.')}</p>`;
  qPaper(sum);
}
async function qPrint(){
  let rows=[];
  try{rows=(await api(`/api/fg/history?kind=${QK}&d1=${today()}&d2=${today()}&limit=5000`)).rows.filter(r=>r.src==='app'&&(r.status==='waiting'||r.status==='confirmed'));}catch(e){alert(e.message);return;}
  rows.reverse();
  const sum={all:0,Brand:0,B2B:0,BB:0,'':0};rows.forEach(r=>{sum.all+=r.total_kg||0;sum[r.group||'']+=r.total_kg||0;});
  qPaper(sum,rows);setTimeout(()=>window.print(),50);
}
function qPaper(sum,list){
  const R=QK==='recv',rows=list||QROWS.filter(r=>!Object.values(QSEL).some(Boolean)||QSEL[r.id]);
  // 20 rows per sheet like the paper form; every sheet has its own header and signature lines
  const per=20,sheets=Math.max(1,Math.ceil(rows.length/per)),now=new Date().toTimeString().slice(0,5);
  const col=`<colgroup><col style="width:4%"><col style="width:3%"><col style="width:3%"><col style="width:4%"><col style="width:5%"><col style="width:24%"><col style="width:10%"><col style="width:7%"><col style="width:6%"><col style="width:6%"><col style="width:7%"><col style="width:9%"><col style="width:6%"><col style="width:6%"></colgroup>`;
  let h='';
  for(let p=0;p<sheets;p++){
    const part=rows.slice(p*per,(p+1)*per),pad=per-part.length,last=p===sheets-1;
    h+=`<div class="pg"><div style="display:flex;justify-content:space-between"><span style="font-size:9px">${sheets>1?`หน้า / page ${p+1}/${sheets}`:''}</span><span style="font-size:9px">F-WI04-WHD01-04 Rev.00</span></div>
     <div style="text-align:center;font-weight:700;font-size:13px">FG ${esc(ME.factory_code)} · บันทึกการรับเข้า-จ่ายออก FG/WIP/SEMI</div>
     <div style="display:flex;justify-content:space-between;margin:3px 0">วันที่ ${fmtD(today())}<span>เวลา ${now}</span></div>
     <table>${col}<thead><tr><th>ลำดับ</th><th>รับ</th><th>จ่าย</th><th>Type</th><th>No.พาเลท</th><th>เบอร์อาหาร</th><th>Lot No.</th><th>บรรจุภัณฑ์</th><th>จำนวน/พาเลท</th><th>น้ำหนัก/หน่วย</th><th>รวมน้ำหนัก</th><th>ผู้ดำเนินการ</th><th>แหล่งจัดเก็บ</th><th>หมายเหตุ</th></tr></thead><tbody>
     ${part.map((r,i)=>`<tr><td>${p*per+i+1}</td><td>${R?'/':''}</td><td>${R?'':'/'}</td><td>FG</td><td>${esc(r.pallet_no||'')}</td><td>${esc(r.product_id)} ${esc(r.product_name)}</td><td>${esc(r.lot_no)}</td><td>${esc(r.packaging||'')}</td><td>${n0(r.qty)}</td><td>${R?n0(r.weight_unit):''}</td><td>${n0(r.total_kg)}</td><td>${esc(R?r.receive_man:r.issue_by)}</td><td>${esc(R?r.location:r.customer_id)}</td><td>${esc(r.note||'')}</td></tr>`).join('')}
     ${Array.from({length:pad},(x,i)=>'<tr><td>'+(p*per+part.length+i+1)+'</td>'+'<td></td>'.repeat(13)+'</tr>').join('')}
     </tbody></table>
     ${last?`<div style="margin-top:3px">ยอดรวม / total ${n0(sum.all)} kg (Brand ${n0(sum.Brand)} / B2B ${n0(sum.B2B)} / BB ${n0(sum.BB)})</div>`:''}
     <div class="sg"><div style="text-align:center">..............................................<br>Checker</div><div style="text-align:center">..............................................<br>ผู้ตรวจสอบ</div></div></div>`;
  }
  $('#qPaper').innerHTML=h;
}
function qDetail(id){
  const r=QROWS.find(x=>x.id===id),R=QK==='recv';if(!r)return;
  dlg(`<h2 class="mono">${esc(r.lot_no)}${r.pallet_no?' · P'+esc(r.pallet_no):''} ${stPill(r.status)}</h2><div>${esc(r.product_id)} · ${esc(r.product_name)}</div>
   <p class="muted">${R?L('อนุมัติโดย','Approved by'):L('จ่ายโดย','Issued by')} ${esc(R?r.recv_by:r.issue_by)} · ${fmtT(R?r.recv_at:r.issue_at)}</p>
   <table><thead><tr><th>${L('รายการ','Item')}</th><th>${L('ค่า','Value')}</th><th>${L('ผล','Result')}</th></tr></thead><tbody>
   ${(r.checklist||[]).map(c=>`<tr><td>${esc(TH()?c.th:c.en)}</td><td>${esc(c.value)}</td><td><span class="pill ${c.v==='ok'?'p-confirmed':'p-rejected'}">${esc((c.v||'-').toUpperCase())}</span> ${esc(c.note||'')}</td></tr>`).join('')}
   </tbody></table>${r.photo?`<p class="muted">${L('รูปจ่ายบางส่วน ถ่ายเมื่อ','Part-pallet photo taken')} ${esc(fmtT(r.photo_at))}</p><img src="${esc(r.photo)}" alt="photo" style="max-width:100%;border-radius:8px">`:''}<h3 style="margin:14px 0 8px">${L('ประวัติขั้นตอน','Audit trail')}</h3><div id="qLog" class="muted">…</div><div class="btns" style="margin-top:12px;justify-content:flex-end"><button class="btn" onclick="closeDlg()">${L('ปิด','Close')}</button></div>`);
  api(`/api/fg/log?kind=${R?'receive':'release'}&ref=${r.id}`).then(d=>{const e=$('#qLog');if(e)e.outerHTML=logList(d.rows);}).catch(()=>{});
}
async function qAct(action){
  const ids=Object.keys(QSEL).filter(k=>QSEL[k]).map(Number);if(!ids.length)return;
  let note='';
  if(action==='sendback'){note=prompt(L('เหตุผลที่ส่งกลับ','Reason for sending back'))||'';if(!note.trim())return;}
  else if(!confirm(L(`ยืนยัน ${ids.length} รายการ ลงสต็อก?`,`Confirm ${ids.length} row(s) to stock?`)))return;
  try{await post('/api/fg/confirm',{kind:QK,ids,action,note,checker:$('#qChk').value});}catch(e){alert(e.message);return;}
  qLoad();
}
function qCsv(){
  const R=QK==='recv';
  csv(`fg-queue-${QK}-${today()}.csv`,['No','Pallet','Product','Name','Lot','Packaging','Qty','kg/unit','Total kg',R?'Packed by':'Customer',R?'Location':'Plate','Phone user','Time','Remark'],
    xView('q'+QK,QROWS).map((r,i)=>[i+1,r.pallet_no,r.product_id,r.product_name,r.lot_no,r.packaging,r.qty,r.weight_unit,r.total_kg,R?r.receive_man:r.customer_id,R?r.location:r.plate,R?r.recv_by:r.issue_by,R?r.recv_at:r.issue_at,r.note]));
}

/* ════════ History (receive / release) ════════ */
let HF={d1:daysAgo(6),d2:today(),q:'',status:''},HROWS=[];
async function pgHist(kind){
  const R=kind==='recv';
  $('#app').innerHTML=`<h1>${R?L('ประวัติรับเข้า','Receive history'):L('ประวัติจ่ายออก','Release history')}</h1><p class="sub">${L('รวมข้อมูลเก่าจาก Access','includes the history imported from Access')}</p>
   <div class="bar"><label class="f">${L('จาก','From')}<input class="in" type="date" id="h1" value="${HF.d1}"></label><label class="f">${L('ถึง','To')}<input class="in" type="date" id="h2" value="${HF.d2}"></label>
    <label class="f">${L('สถานะ','Status')}<select class="in" id="hs"><option value="">${L('ทั้งหมด','All')}</option>${['waiting','confirmed','rejected','sentback'].filter(s=>R||s!=='rejected').map(s=>`<option value="${s}" ${HF.status===s?'selected':''}>${esc(L(...STL[s]))}</option>`).join('')}</select></label>
    <label class="f">${L('ค้นหา','Search')}<input class="in" id="hq" value="${esc(HF.q)}" placeholder="${L('ล็อต / สินค้า','lot / product')}" onkeydown="if(event.key==='Enter')hLoad('${kind}')"></label>
    <button class="btn pri" onclick="hLoad('${kind}')">${L('แสดง','Show')}</button><button class="btn" onclick="hCsv('${kind}')">Excel (CSV)</button><button class="btn" onclick="hA4('${kind}')">${L('พิมพ์ A4','Print A4')}</button></div><div id="hBody"></div>`;
  ta($('#hq'),taSrv('all'),()=>hLoad(kind));
  hLoad(kind);
}
async function hLoad(kind){
  HF={d1:$('#h1').value,d2:$('#h2').value,q:$('#hq').value.trim(),status:$('#hs').value};
  const B=$('#hBody'),u=`/api/fg/history?kind=${kind}&d1=${HF.d1}&d2=${HF.d2}&status=${HF.status}&q=${encodeURIComponent(HF.q)}&limit=3000`;loading(B,u);
  let d;try{d=await apiC(u,()=>hLoad(kind));}catch(e){B.innerHTML=err(e);return;}
  HROWS=d.rows;const R=kind==='recv';
  const tq=HROWS.reduce((a,r)=>a+(r.status==='confirmed'?r.qty:0),0),tk=HROWS.reduce((a,r)=>a+(r.status==='confirmed'?r.total_kg||0:0),0);
  B.innerHTML=`<p class="muted">${d.total.toLocaleString()} ${L('รายการ','rows')}${d.total>HROWS.length?` (${L('แสดง','showing')} ${HROWS.length})`:''} · ${L('ยืนยันแล้ว','confirmed')} ${n0(tq)} ${L('หน่วย','units')} · ${n0(tk)} kg</p><div id="hT"></div>`;
  const cols=[XC('d',L('วันที่','Date'),{val:r=>R?r.receive_date:r.release_date,fmt:r=>fmtD(R?r.receive_date:r.release_date),cls:'nw'}),XC('t',L('เวลา','Time'),{val:r=>R?r.receive_time:r.release_time}),
   XC('product_id',L('เบอร์อาหาร','Product'),{fmt:pName,val:pVal}),XC('lot_no','Lot No.',{cls:'mono nw'})]
   .concat(R?[XC('pallet_no',L('พาเลท','Pallet'))]:[])
   .concat([XC('qty',L('จำนวน','Qty'),{r:1,num:1,fmt:r=>n0(r.qty)}),XC('total_kg','kg',{r:1,num:1,fmt:r=>n0(r.total_kg)}),
   XC('man',R?L('ผู้รับ / แพคกิ้ง','Receive man'):L('ผู้จ่าย','Release man'),{val:r=>R?r.receive_man:r.release_man}),
   R?XC('get_type',L('ประเภท','Get type')):XC('customer_id',L('ลูกค้า','Customer'))]).concat(R?[]:[XC('release_type',L('ประเภท','Type')),XC('plate',L('ทะเบียน','Plate'))])
   .concat([XC('status',L('สถานะ','Status'),{val:r=>L(...(STL[r.status]||[r.status,r.status])),fmt:r=>stPill(r.status)+(R?'':' '+modePill(r.issue_mode)+' '+photoBtn(r))}),
   XC('checker','Checker'),XC('src',L('ที่มา','Source'),{val:r=>r.src==='access'?'Access':L('แอป','App'),cls:'muted'}),
   XC('_l','',{nf:1,fmt:r=>r.src==='app'?`<button class="btn sm" onclick="logDlg('${R?'receive':'release'}',${r.id},${esc(JSON.stringify(r.lot_no))})">${L('ขั้นตอน','Steps')}</button>`:''})]);
  xTable($('#hT'),'h'+kind,cols,HROWS,{foot:xFoot('qty','total_kg'),maxH:'calc(100vh - 290px)'});
}
function hA4(kind){const R=kind==='recv',HV=xView('h'+kind,HROWS);
  const tq=HV.reduce((a,r)=>a+(r.status==='confirmed'?r.qty:0),0),tk=HV.reduce((a,r)=>a+(r.status==='confirmed'?r.total_kg||0:0),0);
  printA4(R?'รายงานรับเข้า FG / FG receive report':'รายงานจ่ายออก FG / FG release report',`${fmtD(HF.d1)} – ${fmtD(HF.d2)}${HF.q?' · '+HF.q:''}`,
   ['Date','Time','Product','Name','Lot',R?'Pallet':'Customer','Qty','kg',R?'Receive man':'Release man',R?'Get type':'Type / mode','Status','Checker'],
   HV.map(r=>[fmtD(R?r.receive_date:r.release_date),R?r.receive_time:r.release_time,r.product_id,r.product_name,r.lot_no,R?r.pallet_no||'':r.customer_id,n0(r.qty),n0(r.total_kg),R?r.receive_man:r.release_man,R?r.get_type:r.release_type+(r.issue_mode?' · '+r.issue_mode:''),L(...(STL[r.status]||[r.status,r.status])),r.checker]),
   `${L('รวมที่ยืนยันแล้ว','Confirmed total')}: ${n0(tq)} ${L('หน่วย','units')} · ${n0(tk)} kg · ${HV.length} ${L('รายการ','rows')}`,[6,7]);}
function hCsv(kind){const R=kind==='recv',HV=xView('h'+kind,HROWS);
  csv(`fg-${R?'receive':'release'}-${HF.d1}_${HF.d2}.csv`,['Date','Time','Product','Name','Lot','Pallet','Qty','Unit','kg',R?'ReceiveMan':'ReleaseMan',R?'GetType':'Customer',R?'Location':'ReleaseType','Plate','Status','Checker','Checked at','Source'],
    HV.map(r=>[R?r.receive_date:r.release_date,R?r.receive_time:r.release_time,r.product_id,r.product_name,r.lot_no,r.pallet_no||'',r.qty,r.unit,r.total_kg,R?r.receive_man:r.release_man,R?r.get_type:r.customer_id,R?r.location:r.release_type,r.plate||'',r.status,r.checker,r.checked_at,r.src]));}

/* ════════ Stock balance ════════ */
let SROWS=[];
async function pgStock(){
  $('#app').innerHTML=`<h1>${L('สต็อกคงเหลือ','Stock balance')}</h1><p class="sub">${L('ต่อสินค้า + ล็อต · รับเข้าที่ยืนยัน − จ่ายออก (รวมที่รอตรวจสอบ)','per product + lot · confirmed receive − issues (incl. waiting)')}</p>
   <div class="bar"><input class="in" id="sq" placeholder="${L('ค้นหา สินค้า / ล็อต','search product / lot')}" style="min-width:260px" onkeydown="if(event.key==='Enter')sLoad()">
    <button class="btn pri" onclick="sLoad()">${L('ค้นหา','Search')}</button><button class="btn" onclick="sCsv()">Excel (CSV)</button><button class="btn" onclick="sA4()">${L('พิมพ์ A4','Print A4')}</button></div><div id="sBody"></div>`;
  ta($('#sq'),taSrv('all'),()=>sLoad());
  sLoad();
}
async function sLoad(){
  const B=$('#sBody'),u='/api/fg/stock?q='+encodeURIComponent($('#sq').value.trim());loading(B,u);
  try{SROWS=(await apiC(u,sLoad)).rows;}catch(e){B.innerHTML=err(e);return;}
  const tb=SROWS.reduce((a,r)=>a+r.balance,0),tk=SROWS.reduce((a,r)=>a+r.kg,0);
  B.innerHTML=`<p class="muted">${SROWS.length} ${L('ล็อต','lots')} · ${n0(tb)} ${L('หน่วย','units')} · <b>${n0(tk)} kg</b></p><div id="sT"></div>`;
  xTable($('#sT'),'stock',[XC('product_id',L('เบอร์อาหาร','Product'),{fmt:pName,val:pVal}),XC('type',L('ชนิด','Type')),XC('group',L('กลุ่ม','Group'),{fmt:r=>esc(r.group||'-')}),
   XC('lot_no','Lot No.',{cls:'mono nw'}),XC('mfg','MFG',{fmt:r=>fmtD(r.mfg),cls:'nw'}),XC('age_days',L('อายุ (วัน)','Age (d)'),{r:1,num:1,fmt:r=>r.age_days==null?'-':r.age_days}),
   XC('received',L('รับเข้า','In'),{r:1,num:1,fmt:r=>n0(r.received)}),XC('issued',L('จ่ายออก','Out'),{r:1,num:1,fmt:r=>n0(r.issued)}),
   XC('balance',L('คงเหลือ','Balance'),{r:1,num:1,fmt:r=>`<b>${n0(r.balance)}</b>`}),XC('kg','kg',{r:1,num:1,fmt:r=>n0(r.kg)}),
   XC('_c','',{nf:1,fmt:r=>`<button class="btn sm" onclick='CARD={p:${JSON.stringify(r.product_id)},l:${JSON.stringify(r.lot_no||'')}};go("card")'>${L('การ์ด','Card')}</button>`})],
   SROWS,{foot:xFoot('received','issued','balance','kg'),maxH:'calc(100vh - 270px)'});
}
function sA4(){const SV=xView('stock',SROWS);const tb=SV.reduce((a,r)=>a+r.balance,0),tk=SV.reduce((a,r)=>a+r.kg,0);
  printA4('สต็อกคงเหลือ FG / FG stock balance',fmtD(today()),['Product','Name','Type','Group','Lot','MFG','Age d','In','Out','Balance','kg'],
   SV.map(r=>[r.product_id,r.product_name,r.type,r.group,r.lot_no,fmtD(r.mfg),r.age_days,n0(r.received),n0(r.issued),n0(r.balance),n0(r.kg)]),
   `${SV.length} ${L('ล็อต','lots')} · ${n0(tb)} ${L('หน่วย','units')} · ${n0(tk)} kg`,[6,7,8,9,10]);}
function sCsv(){const SV=xView('stock',SROWS);csv(`fg-stock-${today()}.csv`,['Product','Name','Type','Group','Lot','MFG','Age days','In','Out','Balance','kg'],SV.map(r=>[r.product_id,r.product_name,r.type,r.group,r.lot_no,r.mfg,r.age_days,r.received,r.issued,r.balance,r.kg]));}

/* ════════ Stock card ════════ */
let CARD={p:'',l:''},CARDD=null;
function cA4(){if(!CARDD)return;
  printA4('สต็อกการ์ด / Stock card',`${CARD.p} ${CARDD.product.name||''}${CARD.l?' · lot '+CARD.l:''}`,['Date','Lot','Movement','By / customer','In','Out','Balance'],
   CARDD.rows.map(e=>[fmtD(e.d)+' '+(e.t||''),e.lot_no,e.info||'',e.who||'',e.kind==='in'?n0(e.qty):'',e.kind==='out'?n0(e.qty):'',n0(e.balance)]),'',[4,5,6]);}
/* b498: STOCK CARD สินค้าสำเร็จรูป — the FG team's own form (rpt_StockCard), A4 portrait.
   One card per lot: brought forward (ยกมา), in (รับเข้า), out (จ่ายออก), balance (คงเหลือ),
   remark (หมายเหตุ), Thai Buddhist-year dates, two signature lines. With no lot typed,
   every lot of the product prints on its own page. */
function thDate(s){s=String(s||'').slice(0,10);const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(s);return m?`${+m[3]}/${+m[2]}/${+m[1]+543}`:s;}
function cCardPrint(){
  if(!CARDD||!CARDD.rows.length)return alert(L('ยังไม่มีรายการ — กด แสดง ก่อน','Nothing to print — press Show first'));
  const p=CARDD.product||{},lots={};
  CARDD.rows.forEach(e=>{const k=e.lot_no||'-';(lots[k]=lots[k]||[]).push(e);});
  const keys=Object.keys(lots).sort();
  const page=(lot,rows)=>{let bal=0;
    const tr=rows.map(e=>{const bf=bal,qi=e.kind==='in'?+e.qty||0:0,qo=e.kind==='out'?+e.qty||0:0;bal=bf+qi-qo;
      const rm=e.kind==='in'?('FG - '+(e.info&&e.info!=='-'?e.info:'')).trim():(e.info||'').replace(/^.*·\s*/,'')||'';
      return `<tr><td>${esc(thDate(e.d))}</td><td>${n0(bf)}</td><td>${n0(qi)}</td><td>${n0(qo)}</td><td>${n0(bal)}</td><td>${esc(rm)}${e.status==='waiting'?' (รอยืนยัน)':''}</td></tr>`;}).join('');
    return `<section class="pg"><div class="hd"><img src="/logo.png?v=2" alt=""><h1>STOCK CARD สินค้าสำเร็จรูป</h1></div>
      <div class="mt"><div><span>รหัสสินค้าสำเร็จรูป :</span> <b>${esc(CARD.p)}</b></div><div><span>ชื่อสินค้าสำเร็จรูป :</span> <b>${esc(p.name||'')}</b></div></div>
      <div class="mt"><div><span>Lot No. :</span> <b>${esc(lot)}</b></div></div>
      <div class="mt"><div style="flex:1;display:flex"><span>รายละเอียด :</span><i class="ln">${esc([p.packaging,p.weight?n0(p.weight)+' kg':''].filter(Boolean).join(' · '))}</i></div></div>
      <table><thead><tr><th style="width:15%">วันที่</th><th style="width:12%">ยกมา</th><th style="width:12%">รับเข้า</th><th style="width:12%">จ่ายออก</th><th style="width:12%">คงเหลือ</th><th>หมายเหตุ</th></tr></thead><tbody>${tr}</tbody></table>
      <div class="ft"><div><div class="dot"></div>(&nbsp;${' '.repeat(1)}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;)<br><b>พนักงานหน่วยสินค้าสำเร็จรูป</b></div>
        <div><div class="dot"></div>(&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;)<br><b>หัวหน้าหน่วยสินค้าสำเร็จรูป</b></div></div>
      <div class="pr">FG ${esc(ME.factory_code||'')} · ${L('พิมพ์โดย','printed by')} ${esc(ME.name||'')} ${esc(thDate(today()))}</div></section>`;};
  const w=window.open('','_blank');if(!w){alert(L('อนุญาต pop-up เพื่อพิมพ์','Allow pop-ups to print'));return;}
  w.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>Stock card ${esc(CARD.p)}</title>
   <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;600;700&display=swap" rel="stylesheet">
   <style>@page{size:A4 portrait;margin:12mm 12mm 14mm}*{box-sizing:border-box}
   body{font-family:"Sarabun",Tahoma,sans-serif;font-size:11pt;color:#000;margin:0}
   .pg{position:relative;min-height:268mm;page-break-after:always;padding-bottom:40mm}.pg:last-child{page-break-after:auto}
   .hd{display:flex;align-items:center;gap:18mm;margin-bottom:4mm}.hd img{height:24mm}.hd h1{font-size:18pt;margin:0;font-weight:700}
   .mt{display:flex;gap:16mm;margin:3mm 0 0 6mm;font-size:11pt}.mt span{font-weight:700}.mt b{font-weight:700}
   .ln{flex:1;border-bottom:.2mm solid #999;margin-left:3mm;font-style:normal;min-height:5mm}
   table{border-collapse:collapse;width:100%;margin-top:8mm}th,td{border:.2mm solid #bbb;padding:1.5mm 2mm;text-align:center;font-weight:700}
   th{font-weight:700}thead{display:table-header-group}tr{page-break-inside:avoid}
   .ft{position:absolute;left:0;right:0;bottom:6mm;border-top:.5mm solid #000;padding-top:8mm;display:flex;justify-content:space-between;font-size:10pt;text-align:center}
   .ft>div{width:45%}.dot{border-bottom:.3mm dotted #999;margin:0 12mm 2mm;height:4mm}
   .pr{position:absolute;right:0;bottom:0;font-size:7.5pt;color:#888}</style></head><body>
   ${keys.map(k=>page(k,lots[k])).join('')}
   <script>window.onload=function(){setTimeout(function(){window.print()},500)}<\/script></body></html>`);
  w.document.close();
}
async function pgCard(){
  $('#app').innerHTML=`<h1>${L('สต็อกการ์ด','Stock card')}</h1><p class="sub">${L('ความเคลื่อนไหวรับ-จ่ายตามวันที่ พร้อมยอดคงเหลือ','in / out movements by date with running balance')}</p>
   <div class="bar"><label class="f">${L('รหัสสินค้า','Product code')}<input class="in" id="cp" value="${esc(CARD.p)}" placeholder="${L('พิมพ์รหัสหรือชื่อ','type code or name')}" style="min-width:240px" onkeydown="if(event.key==='Enter')cLoad()"></label>
    <label class="f">${L('ล็อต (ไม่บังคับ)','Lot (optional)')}<input class="in" id="cl" value="${esc(CARD.l)}" placeholder="${L('พิมพ์เลขล็อต','type a lot')}" onkeydown="if(event.key==='Enter')cLoad()"></label>
    <button class="btn pri" onclick="cLoad()">${L('แสดง','Show')}</button><button class="btn pri" onclick="cCardPrint()">🖨 ${L('พิมพ์สต็อกการ์ด (Stock card)','Print stock card')}</button><button class="btn" onclick="cA4()">${L('พิมพ์ตาราง A4','Print table A4')}</button></div><div id="cBody"></div>`;
  ta($('#cp'),taSrv('product'),()=>{$('#cl').value='';cLoad();});ta($('#cl'),taSrv('lot',()=>$('#cp').value.trim()),()=>cLoad(),0);
  if(CARD.p)cLoad();
}
async function cLoad(){
  CARD={p:$('#cp').value.trim(),l:$('#cl').value.trim()};if(!CARD.p)return;
  const B=$('#cBody'),u=`/api/fg/stockcard?product=${encodeURIComponent(CARD.p)}&lot=${encodeURIComponent(CARD.l)}`;loading(B,u);
  let d;try{d=await apiC(u,cLoad);}catch(e){B.innerHTML=err(e);return;}
  const rows=d.rows.slice().reverse();CARDD=d;
  B.innerHTML=`<div class="card" style="margin-bottom:10px"><b>${esc(CARD.p)}</b> ${esc(d.product.name||'')} · ${esc(d.product.packaging||'')} ${d.product.weight?n0(d.product.weight)+' kg':''}
    · ${L('คงเหลือ','Balance')} <b>${n0(d.rows.length?d.rows[d.rows.length-1].balance:0)}</b>${d.total_rows>d.rows.length?` <span class="muted">(${L('แสดง 2,000 รายการล่าสุด','last 2,000 rows')})</span>`:''}</div>
<div id="cT"></div>`;
  rows.forEach(e=>{e._in=e.kind==='in'?e.qty:'';e._out=e.kind==='out'?e.qty:'';});
  xTable($('#cT'),'card',[XC('d',L('วันที่','Date'),{val:e=>e.d,fmt:e=>fmtD(e.d)+' '+esc(e.t||''),cls:'nw'}),XC('lot_no','Lot No.',{cls:'mono nw'}),
   XC('info',L('รายการ','Movement'),{fmt:e=>esc(e.info||'')+(e.status==='waiting'?' '+stPill('waiting'):'')}),XC('who',L('ผู้ทำ / ลูกค้า','By / customer')),
   XC('_in',L('รับ','In'),{r:1,num:1,fmt:e=>e.kind==='in'?n0(e.qty):''}),XC('_out',L('จ่าย','Out'),{r:1,num:1,fmt:e=>e.kind==='out'?n0(e.qty):''}),
   XC('balance',L('คงเหลือ','Balance'),{r:1,num:1,nf:1,fmt:e=>`<b>${n0(e.balance)}</b>`})],rows,{foot:xFoot('_in','_out'),maxH:'calc(100vh - 300px)'});
}

/* ════════ Daily report ════════ */
let DAILY=null;
function dA4(){if(!DAILY)return;const t=[...new Set(DAILY.days.flatMap(x=>Object.keys(x.types)))].sort();
  printA4('รายงานประจำวัน FG / FG daily report',`${fmtD(DAILY.d1)} – ${fmtD(DAILY.d2)}`,['Date','In units','In kg','Out units','Out kg',...t.map(x=>x+' in/out kg')],
   DAILY.days.map(x=>[fmtD(x.d),n0(x.in_q),n0(x.in_kg),n0(x.out_q),n0(x.out_kg),...t.map(k=>x.types[k]?n0(x.types[k].in_kg)+' / '+n0(x.types[k].out_kg):'-')]),'',[1,2,3,4]);}
async function pgDaily(){
  $('#app').innerHTML=`<h1>${L('รายงานประจำวัน','Daily report')}</h1><p class="sub">${L('รับเข้า / จ่ายออก ที่ยืนยันแล้ว ต่อวัน (kg)','confirmed receive / release per day (kg)')}</p>
   <div class="bar"><label class="f">${L('จาก','From')}<input class="in" type="date" id="d1" value="${daysAgo(6)}"></label><label class="f">${L('ถึง','To')}<input class="in" type="date" id="d2" value="${today()}"></label>
    <button class="btn pri" onclick="dLoad()">${L('แสดง','Show')}</button><button class="btn" onclick="dA4()">${L('พิมพ์ A4','Print A4')}</button></div><div id="dBody"></div>`;
  dLoad();
}
async function dLoad(){
  const B=$('#dBody');B.innerHTML=LOADH;
  let d;try{d=await api(`/api/fg/daily?d1=${$('#d1').value}&d2=${$('#d2').value}`);}catch(e){B.innerHTML=err(e);return;}
  DAILY=d;
  const types=[...new Set(d.days.flatMap(x=>Object.keys(x.types)))].sort();
  B.innerHTML=`<div class="tw"><table><thead><tr><th>${L('วันที่','Date')}</th><th class="r">${L('รับ หน่วย','In units')}</th><th class="r">${L('รับ kg','In kg')}</th><th class="r">${L('จ่าย หน่วย','Out units')}</th><th class="r">${L('จ่าย kg','Out kg')}</th>
    ${types.map(t=>`<th class="r">${esc(t)}<div class="muted">in / out kg</div></th>`).join('')}</tr></thead><tbody>
   ${d.days.map(x=>`<tr><td class="nw">${fmtD(x.d)}</td><td class="r">${n0(x.in_q)}</td><td class="r"><b>${n0(x.in_kg)}</b></td><td class="r">${n0(x.out_q)}</td><td class="r"><b>${n0(x.out_kg)}</b></td>
    ${types.map(t=>{const v=x.types[t];return `<td class="r">${v?n0(v.in_kg)+' / '+n0(v.out_kg):'-'}</td>`}).join('')}</tr>`).join('')||`<tr><td colspan="5" class="muted" style="padding:20px;text-align:center">${L('ไม่มีข้อมูล','No data')}</td></tr>`}</tbody></table></div>`;
}

/* ════════ Packing records (stand-in until the packing DB is linked) ════════ */
let PKREC=[];
async function pgPacking(){
  $('#app').innerHTML=`<h1>${L('ข้อมูลแพคกิ้ง','Packing records')}</h1>
   <p class="sub">${L('ทุกพาเลทจากแพคกิ้ง: ใบพาเลท QR ใหม่ ใบเก่า (EAN-13) ที่นำเข้า และ QR ที่สแกนเข้ามาโดยไม่มีใบในระบบ','every pallet from packing: new QR slips, imported old EAN-13 slips, and QRs scanned without a slip in the system')}</p>
   <div class="tabs" id="pkT"></div><div id="pkBody"></div>`;
  pkrLoad('');
}
async function pkrLoad(st){
  $('#pkT').innerHTML=['','packed','moved_to_fg','rejected_by_fg','cancelled'].map(s=>`<button class="tab ${s===st?'on':''}" onclick="pkrLoad('${s}')">${s?esc(L(...STL[s])):L('ทั้งหมด','All')}</button>`).join('');
  let d;try{d=await api('/api/fg/packing?status='+st);}catch(e){$('#pkBody').innerHTML=err(e);return;}
  PKREC=d.rows;$('#pkBody').innerHTML='<div id="pkrT"></div>';
  xTable($('#pkrT'),'pkrec',[XC('lot_no','Lot No.',{cls:'mono nw'}),XC('pallet_no',L('พาเลท','Pallet'),{num:1}),XC('product_code',L('สินค้า','Product'),{fmt:pName,val:pVal}),
   XC('qty',L('จำนวน','Qty'),{r:1,num:1,fmt:r=>n0(r.qty)}),XC('station','Station / operator',{val:r=>(r.station||'')+' '+(r.operator||'')}),
   XC('status',L('สถานะ','Status'),{val:r=>L(...(STL[r.status]||[r.status,r.status])),fmt:r=>stPill(r.status)}),XC('status_by',L('โดย','By'),{fmt:r=>esc(r.status_by)+' '+fmtT(r.status_at),cls:'muted'}),
   XC('note',L('หมายเหตุ','Note')),XC('_q','',{nf:1,fmt:(r)=>`<button class="btn sm" onclick="pkQr(PKREC.find(x=>x.id===${r.id}).raw_qr)">QR</button>`})],d.rows,{foot:xFoot('qty'),maxH:'calc(100vh - 260px)'});
}
async function pkAdd(){
  const b={product_code:$('#pkC').value.trim(),lot_no:$('#pkL').value.trim(),pallet_no:$('#pkP').value.trim(),qty:+$('#pkQ').value||0,station:$('#pkS').value,operator:$('#pkO').value};
  try{const r=await post('/api/fg/packing',b);$('#pkRes').innerHTML=`<div class="msg m-ok">${L('เพิ่มแล้ว','Added')}</div>`;pkQr(r.qr);$('#pkP').value=(+b.pallet_no||0)+1;pkrLoad('');}
  catch(e){$('#pkRes').innerHTML=err(e);}
}
async function pkQr(text){
  try{await loadJs('/vendor/qrcode.js',()=>window.qrcode);}catch(e){alert(e.message);return;}
  if(qrcode.stringToBytesFuncs&&qrcode.stringToBytesFuncs['UTF-8'])qrcode.stringToBytes=qrcode.stringToBytesFuncs['UTF-8'];const q=qrcode(0,'M');q.addData(text,'Byte');q.make();const n=q.getModuleCount(),m=2;let p='';
  for(let r=0;r<n;r++)for(let c=0;c<n;c++)if(q.isDark(r,c))p+=`M${c+m} ${r+m}h1v1h-1z`;
  dlg(`<h2>${L('QR ใบพาเลท (ทดสอบ)','Pallet slip QR (test)')}</h2><div style="text-align:center"><svg width="260" height="260" viewBox="0 0 ${n+2*m} ${n+2*m}" shape-rendering="crispEdges"><rect width="100%" height="100%" fill="#fff"/><path d="${p}" fill="#000"/></svg></div>
   <pre style="white-space:pre-wrap;font-size:12px;background:var(--soft);padding:8px;border-radius:8px">${esc(text)}</pre><div class="btns" style="justify-content:flex-end"><button class="btn" onclick="window.print()">${L('พิมพ์','Print')}</button><button class="btn" onclick="closeDlg()">${L('ปิด','Close')}</button></div>`);
}

/* ════════ Packing room: A6 QR pallet slips ════════ */
let LISTS={machine:[],line:[],pack_types:['Finished Goods','Repack']},PRODS=null;
async function loadLists(){
  try{const d=await api('/api/fg/lists');LISTS={machine:d.rows.filter(r=>r.kind==='machine'&&r.active).map(r=>r.name),line:d.rows.filter(r=>r.kind==='line'&&r.active).map(r=>r.name),pack_types:d.pack_types,all:d.rows};}catch(e){}
  if(!PRODS){try{PRODS=(await api('/api/fg/products')).rows.filter(p=>p.active);}catch(e){PRODS=[];}}
}
const PCL={pending:['รอ Checker แพคกิ้ง','Waiting packing check'],approved:['ผ่าน Checker แพคกิ้ง','Packing approved'],rejected:['Checker แพคกิ้งไม่ผ่าน','Packing rejected']};
const pcPill=s=>`<span class="pill ${s==='approved'?'p-confirmed':s==='rejected'?'p-rejected':'p-waiting'}">${esc(L(...(PCL[s]||[s,s])))}</span>`;
const LAST=(()=>{try{return JSON.parse(localStorage.getItem('fg_slip_last')||'{}')}catch(e){return {}}})();
function slipForm(v,pre){
  pre=pre||'sf';v=v||{};
  const sel=(id,opts,val)=>`<select class="in" id="${pre}${id}"><option value="">—</option>${opts.map(o=>`<option ${o===val?'selected':''}>${esc(o)}</option>`).join('')}</select>`;
  return `<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
   <label class="f">${L('เลขที่เอกสาร','Document No.')}<input class="in" id="${pre}Doc" value="${esc(v.doc_no||'')}"></label>
   <label class="f">${L('เครื่องแพค','Packing machine')} *${sel('Mc',LISTS.machine,v.pack_machine)}</label>
   <label class="f">${L('ไลน์ผลิต','Production line')} *${sel('Ln',LISTS.line,v.pd_line)}</label>
   <label class="f">${L('ประเภทแพค','Pack type')}${sel('Pt',LISTS.pack_types,v.pack_type||LISTS.pack_types[0])}</label>
   <label class="f" style="grid-column:span 2">${L('รหัสสินค้า (เบอร์อาหาร)','Product code (formula)')} *<input class="in" id="${pre}Pc" value="${esc(v.product_code||'')}" placeholder="${L('พิมพ์รหัสหรือชื่อ','type code or name')}" oninput="slipProd('${pre}')" autocomplete="off"></label>
   <label class="f" style="grid-column:span 2">${L('ชื่อสินค้า','Product name')}<input class="in" id="${pre}Pn" readonly style="background:var(--soft)" value="${esc(v.product_name||'')}"></label>
   <label class="f">${L('เลขล็อต','Lot No.')} *<input class="in" id="${pre}Lot" value="${esc(v.lot_no||'')}" placeholder="261027001-PC" oninput="slipLot('${pre}')" style="text-transform:uppercase"></label>
   <label class="f">${L('วันผลิต','MFG date')} *<input class="in" type="date" id="${pre}Mfg" value="${esc(v.mfg||'')}" onchange="slipExp('${pre}')"></label>
   <label class="f">${L('วันหมดอายุ','Expiry date')} *<input class="in" type="date" id="${pre}Exp" value="${esc(v.exp||'')}"></label>
   <label class="f">${L('น้ำหนัก/ถุง (kg) เช่น 20 หรือ 1*20','Bag weight kg (20 or 1*20)')} *<input class="in" id="${pre}Bw" value="${esc(v.bag_weight||'')}" oninput="slipTot('${pre}')"></label>
   <label class="f">${L('จำนวนถุง/พาเลท','Total bags / pallet')} *<input class="in" type="number" inputmode="numeric" id="${pre}Bg" value="${v.qty?+v.qty:''}" oninput="slipTot('${pre}')"></label>
   <label class="f">${L('น้ำหนักรวม (kg)','Total weight (kg)')}<input class="in" id="${pre}Tw" readonly style="background:var(--soft);font-weight:700"></label>
   <label class="f">${L('ผู้แพค','Staff name')}<input class="in" id="${pre}St" value="${esc(v.staff_name||ME.name)}"></label>
  </div>`;
}
const bagKg=t=>{t=String(t||'').replace(/[xX]/g,'*');if(t.includes('*')){const [a,b]=t.split('*');return (+a||0)*(+b||0);}return +t||0;};
function slipProd(pre){
  const p=(PRODS||[]).find(x=>x.code===$('#'+pre+'Pc').value.trim());
  $('#'+pre+'Pn').value=p?p.name:'';
  if(p&&!$('#'+pre+'Bw').value&&p.weight)$('#'+pre+'Bw').value=n0(p.weight);
  slipTot(pre);slipExp(pre);
}
function slipLot(pre){
  const m=$('#'+pre+'Lot').value.trim().match(/^(\d{2})(\d{2})(\d{2})/);
  if(m){const d=`20${m[1]}-${m[2]}-${m[3]}`;if(!isNaN(Date.parse(d))){$('#'+pre+'Mfg').value=d;slipExp(pre);}}
}
function slipExp(pre){
  const p=(PRODS||[]).find(x=>x.code===$('#'+pre+'Pc').value.trim()),m=$('#'+pre+'Mfg').value;
  if(p&&p.shelf_life_days&&m){const d=new Date(m+'T00:00:00');d.setDate(d.getDate()+p.shelf_life_days);$('#'+pre+'Exp').value=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;}
}
function slipTot(pre){const t=bagKg($('#'+pre+'Bw').value)*(+$('#'+pre+'Bg').value||0);$('#'+pre+'Tw').value=n0(t);const b=pre==='sf'&&$('#pkTw');if(b)b.textContent=n0(t)+' kg';}
function slipVals(pre){
  return {doc_no:$('#'+pre+'Doc').value.trim(),pack_machine:$('#'+pre+'Mc').value,pd_line:$('#'+pre+'Ln').value,pack_type:$('#'+pre+'Pt').value,
    product_code:$('#'+pre+'Pc').value.trim(),lot_no:$('#'+pre+'Lot').value.trim().toUpperCase(),mfg:$('#'+pre+'Mfg').value,exp:$('#'+pre+'Exp').value,
    bag_weight:$('#'+pre+'Bw').value.trim(),bags:+$('#'+pre+'Bg').value||0,staff_name:$('#'+pre+'St').value.trim()};
}
function slipCheck(v){
  if(!v.pack_machine||!v.pd_line)return L('เลือกเครื่องแพคและไลน์ผลิต','Choose packing machine and production line');
  if(!(PRODS||[]).some(p=>p.code===v.product_code))return L('เลือกรหัสสินค้าจากรายการ','Pick a product code from the list');
  if(!v.lot_no)return L('ใส่เลขล็อต','Enter the lot number');
  if(!v.mfg||!v.exp)return L('ใส่วันผลิตและวันหมดอายุ','Enter MFG and expiry dates');
  if(v.exp<=v.mfg)return L('วันหมดอายุต้องหลังวันผลิต','Expiry must be after MFG');
  if(!(bagKg(v.bag_weight)>0)||!(v.bags>0))return L('ใส่น้ำหนักต่อถุงและจำนวนถุง','Enter bag weight and total bags');
  return '';
}
/* ════════ Packing: pallet slip page (b477) — like the old VB Pallet Form ════════
   Left: Pallet information (status rings, the form, live QR of the next slip).
   Right: Filter data (date / FG code / lot + totals) and the slip list.
   Save asks how many slips — each gets the next slip number and its own QR, the rest is the same. */
let PKF={d1:today(),d2:today(),all:false,q:'',st:''},PKROWS=[],PKNEXT=1,PKT=null,PKCNT={};
const PKC={blue:'#1B75BC',dblue:'#0F3D6E',green:'#43A047',orange:'#F97316',red:'#DC2626'};
function ring(n,tot,col,label){
  const r=30,c=2*Math.PI*r,f=tot?Math.min(1,n/tot):0;
  return `<div style="display:flex;flex-direction:column;align-items:center;gap:4px" data-tip="${esc(label)}: ${n}">
   <span style="font-size:12.5px;font-weight:600;color:#fff">${esc(label)}</span>
   <svg width="78" height="78" viewBox="0 0 78 78" role="img" aria-label="${esc(label)} ${n}"><circle cx="39" cy="39" r="${r}" fill="#fff" stroke="#E2E8F0" stroke-width="9"/>
    <circle cx="39" cy="39" r="${r}" fill="none" stroke="${col}" stroke-width="9" stroke-linecap="round" stroke-dasharray="${(c*f).toFixed(1)} ${c.toFixed(1)}" transform="rotate(-90 39 39)"/>
    <text x="39" y="45" text-anchor="middle" font-size="19" font-weight="700" fill="#0F3D6E">${n}</text></svg></div>`;
}
function pkRow(lab,ctrl){return `<div class="pkr"><label>${lab}</label><div>${ctrl}</div></div>`;}
const ICO={"pend": "<path d=\"M12 7v5l3 2\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\"/><circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"2.2\" fill=\"none\"/>", "ok": "<circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"currentColor\"/><path d=\"M7.5 12.5l3 3 6-6.5\" stroke=\"#fff\" stroke-width=\"2.4\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>", "doc": "<rect x=\"5\" y=\"3\" width=\"14\" height=\"18\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\"/><path d=\"M9 8h6M9 12h6M9 16h4\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>", "bag": "<path d=\"M7 7h10l2 13H5z\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linejoin=\"round\"/><path d=\"M9 7a3 3 0 0 1 6 0\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\"/>", "box": "<path d=\"M12 3l8 4.5v9L12 21l-8-4.5v-9z\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linejoin=\"round\"/><path d=\"M4 7.5l8 4.5 8-4.5M12 12v9\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\"/>"};
let PKPV=-1;
async function pgSlip(){
  await loadLists();
  const v=LAST,sel=(id,opts,val)=>`<select class="in" id="sf${id}"><option value="">${L('— เลือก —','Select')}</option>${opts.map(o=>`<option ${o===val?'selected':''}>${esc(o)}</option>`).join('')}</select>`;
  const fld=(lab,ctrl,cls)=>`<label class="pf ${cls||''}"><span>${lab}</span>${ctrl}</label>`;
  const ic=(d,c)=>`<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" style="color:${c}">${d}</svg>`;
  PKPV=-1;
  $('#app').innerHTML=`<style>
   .pkhead{display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px}
   .pkhead .rt{text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:6px}.pkhead .rt b{font-size:15px;font-weight:600;color:var(--navy)}
   .pkdr{display:flex;gap:8px;align-items:center}.pkdr label{display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--ink2)}.pkdr .in{width:auto;min-height:34px;height:34px}
   .pkdq{display:flex;gap:4px;flex-wrap:wrap;justify-content:flex-end}.pkdq button{border:1px solid #CBD5E1;background:#fff;border-radius:99px;padding:2px 10px;font:inherit;font-size:12px;cursor:pointer;color:#334155}
   .pkdq button.on{background:var(--navy);border-color:var(--navy);color:#fff}
   .pkstats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:14px}
   .pks{background:#fff;border:1px solid var(--line);border-radius:12px;padding:12px 16px;display:flex;gap:12px;align-items:center}
   .pks .i{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex:none}
   .pks small{display:block;font-size:12.5px;color:var(--ink2)}.pks b{display:block;font-size:22px;font-weight:600;line-height:1.2}.pks em{font-style:normal;font-size:12px;color:var(--ink2)}
   .pks.cur{border-left:4px solid ${PKC.orange}}
   .pkw{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:14px;align-items:stretch;margin-bottom:14px}
   .pc{background:#fff;border:1px solid var(--line);border-radius:12px;min-width:0}
   .pch{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--line)}
   .pch h2{margin:0;font-size:16px;font-weight:600;flex:1;display:flex;align-items:center;gap:10px}
   .pch .plus{width:26px;height:26px;border-radius:13px;background:var(--blue);color:#fff;display:flex;align-items:center;justify-content:center;font-size:18px;line-height:1}
   .pnext{background:#E8F1FA;color:var(--blue);font-weight:600;font-size:13px;border-radius:8px;padding:4px 10px;border:1px solid #BFDBFE}
   .psec{padding:14px 18px}.psec+.psec{border-top:1px solid var(--line)}
   .psec h3{margin:0 0 10px;font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:#475569;font-weight:600;display:flex;align-items:center;gap:8px}
   .pg4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px 12px}
   .pg5{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px 12px;margin-bottom:12px}
   .pgr{display:grid;grid-template-columns:minmax(150px,1.3fr) minmax(150px,1.3fr) minmax(90px,1fr) minmax(70px,.6fr) minmax(70px,.6fr);gap:10px 12px;align-items:start}
   .pgb{display:grid;grid-template-columns:minmax(0,1fr) 1px 200px;gap:16px;align-items:start}.pgb .vl{background:var(--line);align-self:stretch}
   .pg3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px 12px}
   .pf{display:flex;flex-direction:column;gap:4px;min-width:0}
   .pf>span{font-size:12.5px;color:#475569;font-weight:500}
   .pf .in{min-height:40px;padding:7px 10px;font-size:14px;border-color:#CBD5E1}
   .pf .in:focus{outline:2px solid #BFDBFE;border-color:var(--blue)}
   .sr{position:relative}.sr .in{padding-right:34px;width:100%}.sr svg{position:absolute;right:10px;top:50%;transform:translateY(-50%);color:#94A3B8;pointer-events:none}
   .pro{min-height:40px;border-radius:8px;background:#F8FAFC;border:1px solid #E2E8F0;padding:8px 10px;font-size:13.5px;color:#94A3B8;display:flex;align-items:center;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
   .pkx{display:flex;gap:6px;margin-top:6px;flex-wrap:wrap}.pkx button{border:1px solid #CBD5E1;background:#fff;border-radius:99px;padding:2px 10px;font:inherit;font-size:12px;cursor:pointer;color:#334155}
   .pkx button.on{background:var(--blue);border-color:var(--blue);color:#fff}
   .psv{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px;margin-top:14px;align-items:stretch}
   .psv .btn{min-height:58px;font-size:15px;display:flex;align-items:center;justify-content:center;gap:8px}
   .pqb{display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center}.pqb .q{width:150px;height:150px;background:#fff;border:1px solid var(--line);border-radius:8px;padding:5px}
   .pqb b{display:block;font-size:13px}.pqb span{display:block;font-size:12.5px;color:var(--ink2);font-family:ui-monospace,Consolas,monospace}
   .ptw{border:1px solid #BFDBFE;background:#F4F8FD;border-radius:10px;padding:8px 14px}.ptw small{display:block;font-size:12.5px;color:#475569}
   .ptw b{font-size:22px;font-weight:700;color:var(--blue)}
   .ppv{display:flex;flex-direction:column}.ppv .pch h2{font-size:14.5px}
   .ppv .q{width:150px;height:150px;margin:14px auto 8px;background:#fff;border-radius:8px;padding:5px;border:1px solid var(--line)}
   .ppv .id{text-align:center;font-weight:700;font-size:14px;margin-bottom:2px}.ppv .tg{text-align:center;margin-bottom:8px}
   .ppv .kvs{padding:0 18px;flex:1}.ppv .kv{padding:6px 0;font-size:13px}
   .ppv .nav{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:14px 18px}
   .ptool{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:12px 18px;border-bottom:1px solid var(--line)}
   .pchip{border:1px solid #CBD5E1;background:#fff;border-radius:99px;padding:5px 12px;font:inherit;font-size:12.5px;cursor:pointer;color:#334155;display:flex;gap:6px;align-items:center;font-weight:500}
   .pchip.on{background:var(--blue);border-color:var(--blue);color:#fff}
   .pchip.c-p{border-color:#FED7AA;color:#C2410C;background:#FFF7ED}.pchip.c-a{border-color:#BBF7D0;color:#15803D;background:#F0FDF4}.pchip.c-r{border-color:#FECACA;color:#B91C1C;background:#FEF2F2}
   .pchip.on.c-p,.pchip.on.c-a,.pchip.on.c-r{color:#fff}.pchip.on.c-p{background:${PKC.orange};border-color:${PKC.orange}}.pchip.on.c-a{background:${PKC.green};border-color:${PKC.green}}.pchip.on.c-r{background:${PKC.red};border-color:${PKC.red}}
   .pchip b{font-weight:700}
   .psrch{position:relative;flex:0 1 280px}.psrch .in{padding-left:34px;width:100%;min-height:38px}.psrch svg{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:#94A3B8}
   .pc .tw{border:0;border-radius:0}
   .pc .nm{max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
   .ibtn{width:34px;height:32px;border:1px solid #CBD5E1;background:#fff;border-radius:7px;cursor:pointer;color:#334155;display:inline-flex;align-items:center;justify-content:center;padding:0}.ibtn:hover{border-color:var(--blue);color:var(--blue)}
   .plink{background:none;border:0;color:var(--blue);font:inherit;font-size:13px;cursor:pointer;padding:4px 6px;border-radius:6px}.plink:hover{background:#E8F1FA}
   .pmenu{position:fixed;z-index:80;background:#fff;border:1px solid #CBD5E1;border-radius:10px;box-shadow:0 10px 28px rgba(15,23,42,.16);padding:4px 0;min-width:170px}
   .pmenu button{display:block;width:100%;text-align:left;background:none;border:0;padding:9px 14px;font:inherit;font-size:13.5px;cursor:pointer}.pmenu button:hover{background:#F1F5F9}
   @media(max-width:1200px){.pkw{grid-template-columns:minmax(0,1fr)}}
   @media(max-width:760px){.pgr{grid-template-columns:repeat(6,minmax(0,1fr))}.pgr>*{grid-column:span 2}.pgr>:nth-child(-n+2){grid-column:span 3}.pkhead .rt{text-align:left;align-items:flex-start}.pkstats,.pg4{grid-template-columns:repeat(2,minmax(0,1fr))}.pg5,.pg3{grid-template-columns:repeat(2,minmax(0,1fr))}.pgb{grid-template-columns:minmax(0,1fr)}.pgb .vl{display:none}.ppv .q{display:none}.pqb{margin-top:14px}}
  </style>
  <div class="pkhead"><div><h1>${L('ใบพาเลท (QR)','Pallet slips (QR)')}</h1><p class="sub" style="margin:0">${L('สร้าง ตรวจ และพิมพ์ใบพาเลท','Create, review and print pallet slips')}</p></div>
   <div class="rt"><b>${L('จัดการใบพาเลท','Pallet slip management')}</b><span id="pkAcc"></span><div class="pkdr"><label>${L('จาก','From')}<input class="in" type="date" id="pkD1" value="${PKF.d1}" onchange="pkRange(this.value,$('#pkD2').value)"></label>
     <label>${L('ถึง','To')}<input class="in" type="date" id="pkD2" value="${PKF.d2}" onchange="pkRange($('#pkD1').value,this.value)"></label></div>
    <div class="pkdq" id="pkDq"></div></div></div>
  <div class="pkstats" id="pkStats"></div>
  <div class="pkw">
   <div class="pc">
    <div class="pch"><h2><span class="plus">+</span>${L('สร้างใบพาเลทใหม่','Create new pallet slip')}</h2><button class="plink" onclick="pkClear()">${L('ล้างฟอร์ม','Clear')}</button><span class="pnext">${L('ใบถัดไป','Next slip')} <span id="pkNo">#1</span></span></div>
    <div class="psec"><h3>${ic(ICO.box,'#1B75BC')}${L('สินค้าและการตรวจสอบย้อนกลับ','Product & traceability')}</h3><div class="pg4">
     ${fld(L('รหัส FG','FG code')+' *',`<div class="sr"><input class="in" id="sfPc" value="${esc(v.product_code||'')}" placeholder="${L('ค้นหารหัส / ชื่อ','Search code / name')}" oninput="slipProd('sf');pkName();pkLive()" autocomplete="off"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></div>`)}
     ${fld(L('ชื่อสูตร','Formula name'),`<div class="pro" id="pkPn">${L('เติมอัตโนมัติ','Auto-filled')}</div><input type="hidden" id="sfPn">`)}
     ${fld(L('เลขล็อต','Lot number')+' *',`<input class="in" id="sfLot" value="${esc(v.lot_no||'')}" placeholder="261027001-PC" oninput="slipLot('sf');pkLive()" style="text-transform:uppercase">`)}
     ${fld(L('ประเภทสินค้า','Product type'),sel('Pt',LISTS.pack_types,v.pack_type||LISTS.pack_types[0]))}</div></div>
    <div class="psec"><h3>${ic(ICO.box,'#1B75BC')}${L('รายละเอียดการแพค','Packing details')}</h3>
     <div class="pg5">
      ${fld(L('ไลน์ผลิต','PD line')+' *',sel('Ln',LISTS.line,v.pd_line))}
      ${fld(L('เครื่องแพค','Packing M/C')+' *',sel('Mc',LISTS.machine,v.pack_machine))}
      ${fld(L('เลขที่เอกสาร','Document no.'),`<input class="in" id="sfDoc" value="${esc(v.doc_no||'')}" placeholder="${L('ใส่เลขเอกสาร','Enter document')}">`)}</div>
     <div class="pgb"><div><div class="pgr">
      <div class="pf"><span>${L('วันผลิต','MFG date')} *</span><input class="in" type="date" id="sfMfg" value="${esc(v.mfg||'')}" onchange="slipExp('sf');pkExpChip();pkLive()">
       <div class="pkx">${[[12,L('1 ปี','1 yr')],[18,L('1.5 ปี','1.5 yr')],[24,L('2 ปี','2 yr')]].map(([m,t])=>`<button type="button" data-m="${m}" title="${L('อายุสินค้า','Shelf life')}" onclick="pkExpM(${m})">${t}</button>`).join('')}</div></div>
      ${fld(L('วันหมดอายุ','Expiry date')+' *',`<input class="in" type="date" id="sfExp" value="${esc(v.exp||'')}" onchange="pkExpChip();pkLive()">`)}
      ${fld(L('ผู้แพค','Staff'),`<input class="in" id="sfSt" value="${esc(v.staff_name||ME.name)}" oninput="pkLive()">`)}
      ${fld(L('จำนวนถุง','Bags')+' *',`<input class="in" type="number" inputmode="numeric" id="sfBg" value="${v.qty?+v.qty:''}" oninput="slipTot('sf');pkLive()">`)}
      ${fld(L('กก./ถุง','kg / bag')+' *',`<input class="in" id="sfBw" value="${esc(v.bag_weight||'')}" placeholder="20 / 1*20" oninput="slipTot('sf');pkLive()">`)}</div>
      <div class="psv"><div class="ptw"><small>${L('น้ำหนักรวม','Total weight')}</small><b id="pkTw">0 kg</b><input type="hidden" id="sfTw"></div>
       <button class="btn pri" onclick="pkSaveDlg()"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h11l3 3v15H5z"/><path d="M8 3v5h8V3M8 21v-7h8v7"/></svg>${L('บันทึกใบพาเลท','Save slip')}</button></div></div>
      <div class="vl"></div>
      <div class="pqb"><div class="q" id="pkQr2"></div><div><b>${L('QR ของใบนี้','QR for this slip')}</b><span id="pkQr2t">—</span></div></div></div>
     <div id="sfMsg" style="margin-top:8px"></div></div>
   </div>
   <div class="pc ppv">
    <div class="pch"><h2>${L('ตัวอย่างใบพาเลท','Generated slip preview')}</h2></div>
    <div class="q" id="pkQr"></div><div class="id mono" id="pkPid">—</div><div class="tg" id="pkPtag"></div>
    <div class="kvs" id="pkQt"></div>
    <div class="nav"><button class="btn" id="pkPrev" onclick="pkPv(-1)">‹ ${L('ก่อนหน้า','Previous')}</button><button class="btn" id="pkNext" onclick="pkPv(1)">${L('ถัดไป','Next')} ›</button></div>
   </div>
  </div>
  <div class="pc">
   <div class="pch"><h2>${ic(ICO.doc,'#0F3D6E')}<span id="pkListT">${L('ทะเบียนใบพาเลท','Pallet slip register')}</span></h2></div>
   <div class="ptool"><div id="pkChips" style="display:flex;gap:6px;flex-wrap:wrap"></div><span style="flex:1"></span>
    <div class="psrch"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
     <input class="in" id="pkQ" value="${esc(PKF.q||'')}" placeholder="${L('ค้นหา รหัส FG / ล็อต','Search FG code / lot')}" oninput="clearTimeout(PKQT);PKQT=setTimeout(()=>{PKF.q=this.value.trim();pkLoad()},400)" autocomplete="off"></div>
    <button class="btn pri" id="pkPrSel" onclick="printSlips(PKVIEW.filter(s=>SLSEL[s.id]))">${L('พิมพ์ที่เลือก','Print selected')}</button></div>
   <div id="pkList"></div>
  </div>`;
  ta($('#sfPc'),taProd);ta($('#pkQ'),taSrv('all'),it=>{PKF.q=it.v;pkLoad();});
  slipProd('sf');pkName();slipTot('sf');pkExpChip();pkLive();pkLoad();
  if(isAdmin()||ME.cmms_role==='admin')api('/api/fg/access-slips').then(d=>{if(d.missing&&$('#pkAcc'))$('#pkAcc').innerHTML=`<button class="btn sm" id="pkAccB" onclick="pkAccMake(${d.missing})">${L('สร้าง QR ใบพาเลทจากข้อมูล Access','Make QR slips from Access history')} (${n0(d.missing)})</button>`;}).catch(()=>{});
}
async function pkAccMake(n){
  if(!confirm(L(`สร้างใบพาเลท QR ${n0(n)} ใบ จากประวัติรับเข้า Access?\nทุกใบ = อนุมัติแล้ว + ย้ายเข้า FG แล้ว · สต็อกไม่เปลี่ยน`,`Make ${n0(n)} QR pallet slips from the Access receive history?\nEvery slip = packing-approved + moved to FG · stock does not change`)))return;
  const b=$('#pkAccB');b.disabled=true;b.textContent=L('กำลังสร้าง…','Making slips…');
  try{const r=await post('/api/fg/access-slips');alert(L('สร้างแล้ว','Made')+' '+n0(r.made)+' '+L('ใบ','slips'));$('#pkAcc').innerHTML='';pkLoad();}
  catch(e){alert(e.message);b.disabled=false;}
}
let PKQT=null,PKVIEW=[];
function pkName(){const p=(PRODS||[]).find(x=>x.code===$('#sfPc').value.trim());$('#pkPn').textContent=p?p.name:L('เติมอัตโนมัติ','Auto-filled');$('#pkPn').title=p?p.name:'';$('#pkPn').style.color=p?'#0F172A':'#94A3B8';}
const ymd=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
function pkExpM(m){const mf=$('#sfMfg').value;if(!mf){alert(L('ใส่วันผลิตก่อน','Enter the MFG date first'));return;}
  const d=new Date(mf+'T00:00:00');d.setMonth(d.getMonth()+m);$('#sfExp').value=ymd(d);pkExpChip();pkLive();}
function pkExpChip(){const mf=$('#sfMfg').value,ex=$('#sfExp').value;
  document.querySelectorAll('.pkx button').forEach(b=>{let on=false;if(mf&&ex){const d=new Date(mf+'T00:00:00');d.setMonth(d.getMonth()+(+b.dataset.m));on=ymd(d)===ex;}b.classList.toggle('on',on);});}
function pkClear(){['sfDoc','sfPc','sfPn','sfLot','sfBg','sfBw','sfTw','sfMfg','sfExp'].forEach(i=>{const e=$('#'+i);if(e)e.value='';});pkName();pkExpChip();pkLive();}
/* preview card: the next slip (live, exactly what its QR will hold) or a saved slip (‹ › browse the register) */
const PKKV=(k,v)=>`<div class="kv"><span>${k}</span><b>${v}</b></div>`;
function pkPvDraw(){
  const prev=$('#pkPrev'),next=$('#pkNext');if(!prev)return;
  prev.disabled=PKPV>=PKVIEW.length-1;next.disabled=PKPV<0;
  if(PKPV<0){pkLive();return;}
  const s=PKVIEW[PKPV];if(!s){PKPV=-1;pkLive();return;}
  qrSvgStr(s.qr||'').then(h=>{if(PKPV>=0)$('#pkQr').innerHTML=h;}).catch(()=>{});
  $('#pkPid').textContent=`${s.lot_no} · #${s.pallet_no}`;
  $('#pkPtag').innerHTML=(s.status==='packed'?pcPill(s.pc_status):stPill(s.status))+` <span class="muted">${PKPV+1} / ${PKVIEW.length}</span>`;
  $('#pkQt').innerHTML=PKKV(L('สินค้า','Product'),esc(s.product_code))+PKKV('Lot No.',`<span class="mono">${esc(s.lot_no)}</span>`)+PKKV(L('ถุง','Bags'),n0(s.qty))
    +PKKV(L('น้ำหนัก','Weight'),n0(s.total_weight)+' kg')+PKKV('MFG / EXP',`${fmtD(s.mfg)} / ${fmtD(s.exp)}`)
    +`<div style="display:flex;gap:6px;margin-top:8px"><button class="btn sm" style="flex:1" onclick="slipPreview(${s.id})">A6</button><button class="btn sm" style="flex:1" onclick="printSlips([PKVIEW[${PKPV}]])">${L('พิมพ์','Print')}</button></div>`;
}
function pkPv(d){PKPV=Math.max(-1,Math.min(PKVIEW.length-1,PKPV-d));pkPvDraw();}   // ‹ Previous = older saved slip, Next › = back toward the new slip
function pkLive(){
  clearTimeout(PKT);PKT=setTimeout(async()=>{
    const v=slipVals('sf');
    if(v.product_code&&v.lot_no){try{PKNEXT=(await api(`/api/fg/slips-next?product=${encodeURIComponent(v.product_code)}&lot=${encodeURIComponent(v.lot_no)}`)).next;}catch(e){PKNEXT=1;}}else PKNEXT=1;
    $('#pkNo').textContent='#'+PKNEXT;
    const p=(PRODS||[]).find(x=>x.code===v.product_code)||{};
    const txt=JSON.stringify({Id:'(new)',Product_code:v.product_code,Product_Name:p.name||'',Lot_No:v.lot_no,Pallet:String(PKNEXT),No:String(v.bags||''),weight:n0(bagKg(v.bag_weight))+' kg',MFG:v.mfg,EXP:v.exp,Station:v.pack_machine,Operator:v.staff_name});
    try{const h=await qrSvgStr(txt);$('#pkQr2').innerHTML=h;if(PKPV<0)$('#pkQr').innerHTML=h;}catch(e){}
    const ok=v.product_code&&v.lot_no,tw=bagKg(v.bag_weight)*(v.bags||0);$('#pkQr2t').textContent=ok?`${v.lot_no} · #${PKNEXT}`:L('กรอกรหัส FG และล็อต','enter FG code + lot');
    if(PKPV>=0)return;
    $('#pkPid').textContent=ok?`${v.lot_no} · #${PKNEXT}`:'—';
    $('#pkPtag').innerHTML=`<span class="pill" style="background:#E8F1FA;color:var(--blue)">${L('ใบใหม่ (ยังไม่บันทึก)','New slip (not saved)')}</span>`;
    $('#pkQt').innerHTML=ok?PKKV(L('สินค้า','Product'),esc(v.product_code))+PKKV('Lot No.',`<span class="mono">${esc(v.lot_no)}</span>`)+PKKV(L('ถุง','Bags'),n0(v.bags||0))
      +PKKV(L('น้ำหนัก','Weight'),n0(tw)+' kg')+PKKV('MFG / EXP',`${v.mfg?fmtD(v.mfg):'—'} / ${v.exp?fmtD(v.exp):'—'}`)
      :`<p class="muted" style="text-align:center;margin:6px 0">${L('กรอกรหัส FG และเลขล็อตเพื่อดู QR','Enter FG code and lot to see the QR')}</p>`;
    const n=$('#pkNext');if(n)n.disabled=true;const pv=$('#pkPrev');if(pv)pv.disabled=!PKVIEW.length;
  },250);
}
/* b489: date range + quick ranges; "All dates" searches every slip (newest 3,000 shown) */
function pkRange(a,b,all){PKF.all=!!all;if(!all){if(!a||!b)return;if(a>b)[a,b]=[b,a];PKF.d1=a;PKF.d2=b;}if(PKF.st==='fgrej')PKF.st='';
  const x=$('#pkD1'),y=$('#pkD2');if(x){x.value=PKF.d1;y.value=PKF.d2;x.disabled=y.disabled=PKF.all;}PKPV=-1;pkLoad();}
function pkDq(){const e=$('#pkDq');if(!e)return;const t=today(),cur=PKF.all?'all':(PKF.d2===t?{[t]:'0',[daysAgo(6)]:'7',[daysAgo(29)]:'30'}[PKF.d1]:'');
  const b=(k,lab,a,all)=>`<button class="${cur===k?'on':''}" onclick="pkRange('${a}','${t}',${all?1:0})">${lab}</button>`;
  e.innerHTML=b('0',L('วันนี้','Today'),t)+b('7',L('7 วัน','7 days'),daysAgo(6))+b('30',L('30 วัน','30 days'),daysAgo(29))+b('all',L('ทุกวัน','All dates'),t,1);
  const x=$('#pkD1'),y=$('#pkD2');if(x){x.disabled=y.disabled=PKF.all;}}
async function pkLoad(){
  pkDq();
  const q=encodeURIComponent(PKF.q||''),rg=PKF.all?'':`d1=${PKF.d1}&d2=${PKF.d2}&`;
  try{const r=await api(PKF.st==='fgrej'?'/api/fg/slips?status=rejected_by_fg&limit=3000&q='+q:`/api/fg/slips?${rg}q=${q}&limit=3000`);PKCNT=r.counts||{};PKROWS=r.rows;}
  catch(e){$('#pkList').innerHTML=err(e);return;}
  SLSEL={};SLIPS=PKROWS;pkDraw();
}
const PKI=(d)=>`<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
function pkMenu(ev,id){
  ev.stopPropagation();const o=$('#pkM');if(o)o.remove();
  const s=PKROWS.find(x=>x.id===id);if(!s)return;
  const m=document.createElement('div');m.id='pkM';m.className='pmenu';
  m.innerHTML=`<button onclick="pkCopy(${id})">${L('คัดลอกไปทำใบใหม่','Copy to a new slip')}</button>`+(s.status==='packed'||s.status==='rejected_by_fg'?`<button onclick="slEdit(${id})">${L('แก้ไข','Edit')}</button>`:'')
    +`<button onclick="logDlg('packing',${id},${esc(JSON.stringify(s.lot_no+' #'+s.pallet_no))})">${L('ประวัติขั้นตอน','Audit trail')}</button>`;
  document.body.appendChild(m);const r=ev.currentTarget.getBoundingClientRect();m.style.top=(r.bottom+4)+'px';m.style.left=Math.max(8,r.right-180)+'px';
  setTimeout(()=>document.addEventListener('click',()=>{const x=$('#pkM');if(x)x.remove();},{once:true}),0);
}
function pkDraw(){
  const stf=PKF.st,multi=stf==='fgrej'||PKF.all||PKF.d1!==PKF.d2;
  const live=PKROWS.filter(s=>s.status!=='cancelled'),n=k=>live.filter(s=>s.status==='packed'&&s.pc_status===k).length;
  PKVIEW=PKROWS.filter(s=>(!stf||stf==='fgrej'||(s.status==='packed'&&s.pc_status===stf)));SLIPS=PKVIEW;
  if(PKPV>=PKVIEW.length)PKPV=-1;
  const bags=live.reduce((a,s)=>a+s.qty,0),kg=live.reduce((a,s)=>a+(s.total_weight||0),0);
  const st=(lab,val,sub,ico,col,bg,cur)=>`<div class="pks ${cur?'cur':''}"><span class="i" style="background:${bg};color:${col}"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">${ico}</svg></span><div><small>${lab}</small><b style="color:${col}">${val}</b>${sub?`<em>${sub}</em>`:''}</div></div>`;
  $('#pkStats').innerHTML=st(L('รอตรวจ','Pending'),n('pending'),'',ICO.pend,PKC.orange,'#FFF7ED',1)+st(L('อนุมัติ','Accepted'),n('approved'),'',ICO.ok,PKC.green,'#F0FDF4')
    +st(L('จำนวนใบ','Total slips'),live.length,n('rejected')?`${n('rejected')} ${L('ไม่ผ่าน','rejected')}`:'',ICO.doc,PKC.blue,'#E8F1FA')+st(L('จำนวนถุง','Total bags'),n0(bags),kgT(kg),ICO.bag,PKC.dblue,'#EEF2F6');
  $('#pkListT').textContent=stf==='fgrej'?L('FG ไม่รับ — ต้องแก้ไข (ทุกวัน)','Rejected by FG — to fix (all dates)'):L('ทะเบียนใบพาเลท · ','Pallet slip register · ')+(PKF.all?L('ทุกวัน','all dates'):PKF.d1===PKF.d2?fmtD(PKF.d1):fmtD(PKF.d1)+' – '+fmtD(PKF.d2))+(PKF.q?` · “${PKF.q}”`:'')+(PKROWS.length>=3000?` · ${L('แสดง 3,000 ใบล่าสุด','newest 3,000 shown')}`:'');
  const chip=(k,t,c,cnt)=>`<button class="pchip ${c||''} ${stf===k?'on':''}" onclick="PKF.st='${k}';${k==='fgrej'||stf==='fgrej'?'pkLoad()':'pkDraw()'}">${t}${cnt!=null?` <b>${cnt}</b>`:''}</button>`;
  $('#pkChips').innerHTML=chip('',L('ทั้งหมด','All slips'))+chip('pending',L('รอตรวจ','Pending'),'c-p')+chip('approved',L('อนุมัติ','Accepted'),'c-a')+chip('rejected',L('ไม่ผ่าน','Rejected'),'c-r')
    +chip('fgrej',L('FG ไม่รับ','Rejected by FG'),'c-r',PKCNT.fg_rejected||0);
  xTable($('#pkList'),'slips',[XC('pallet_no','#',{num:1,fmt:s=>`<b>${esc(s.pallet_no)}</b>`}),
   XC('packed_at',multi?L('วันที่ / เวลา','Date / time'):L('เวลา','Time'),{val:s=>multi?(s.packed_at||'').slice(0,16):(s.packed_at||'').slice(11,16),fmt:s=>(multi?fmtD(s.packed_at)+' ':'')+esc((s.packed_at||'').slice(11,16)),cls:'nw'}),
   XC('product_code',L('สินค้า','Product'),{val:pVal,fmt:s=>`<div class="nm" style="font-weight:600">${esc(s.product_code)}</div><div class="muted nm" title="${esc(s.product_name)}">${esc(s.product_name)}</div>`}),
   XC('lot_no','Lot No.',{cls:'mono nw'}),XC('qty',L('ถุง','Bags'),{r:1,num:1,fmt:s=>n0(s.qty)}),XC('total_weight','kg',{r:1,num:1,fmt:s=>n0(s.total_weight)}),
   XC('pd_line',L('ไลน์ / เครื่อง','Line / M/C'),{val:s=>(s.pd_line||'')+' · '+(s.pack_machine||''),fmt:s=>`${esc(s.pd_line)}<div class="muted">${esc(s.pack_machine)}</div>`,cls:'nw'}),
   XC('st',L('สถานะ','Status'),{val:s=>s.status==='packed'?({pending:L('รอตรวจ','Pending check'),approved:L('อนุมัติ','Accepted'),rejected:L('ไม่ผ่าน','Rejected')}[s.pc_status]||s.pc_status):L(...(STL[s.status]||[s.status,s.status])),fmt:s=>s.status==='packed'?pcPill(s.pc_status):stPill(s.status),cls:'nw'}),
   XC('_a',L('จัดการ','Action'),{nf:1,cls:'nw',fmt:s=>`<button class="ibtn" title="${L('ดู A6','View A6')}" aria-label="View" onclick="slipPreview(${s.id})">${PKI('<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>')}</button>
     <button class="ibtn" title="${L('พิมพ์','Print')}" aria-label="Print" onclick="printSlips([PKROWS.find(x=>x.id===${s.id})])">${PKI('<path d="M6 9V3h12v6M6 18H4v-7h16v7h-2"/><rect x="6" y="14" width="12" height="7"/>')}</button>
     <button class="ibtn" title="${L('เพิ่มเติม','More')}" aria-label="More" onclick="pkMenu(event,${s.id})">${PKI('<circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/>')}</button>`})],
   PKVIEW,{select:SLSEL,pageSize:10,onRow:s=>{PKPV=PKVIEW.indexOf(s);pkPvDraw();},
   empty:`<div style="font-weight:600;margin-bottom:4px;color:#0F172A">${L('ยังไม่มีใบพาเลท','No slips yet')}</div><div class="muted">${stf==='fgrej'?L('ไม่มีใบที่ FG ไม่รับ','Nothing rejected by FG'):L('กรอกฟอร์มด้านบนแล้วกด “บันทึกใบพาเลท”','Fill in the form above and press “Save slip”')}</div>`,
   after:()=>{const n=PKROWS.filter(s=>SLSEL[s.id]).length;$('#pkPrSel').disabled=!n;$('#pkPrSel').textContent=L('พิมพ์ที่เลือก','Print selected')+(n?` (${n})`:'');}});
  pkPvDraw();
}
function pkCopy(id){const s=PKROWS.find(x=>x.id===id);if(!s)return;
  Object.assign(LAST,{doc_no:s.doc_no,product_code:s.product_code,lot_no:s.lot_no,pd_line:s.pd_line,pack_machine:s.pack_machine,qty:s.qty,bag_weight:s.bag_weight,pack_type:s.pack_type,mfg:s.mfg,exp:s.exp,staff_name:s.staff_name});pgSlip();window.scrollTo(0,0);}
function pkSaveDlg(){
  const v=slipVals('sf'),bad=slipCheck(v);if(bad){$('#sfMsg').innerHTML=err(bad);return;}$('#sfMsg').innerHTML='';
  dlg(`<h2>${L('ต้องการสร้างใบพาเลทกี่ใบ?','How many slips to make?')}</h2>
   <p class="muted">${L('ทุกใบใช้ข้อมูลเดียวกัน แต่ได้เลขใบและ QR ใหม่','All slips get the same data, each with its own slip number and QR')}</p>
   <div class="card" style="display:grid;gap:10px">
    <div><b class="mono">${esc(v.lot_no)}</b> · ${esc(v.product_code)} · ${n0(v.bags)} ${L('ถุง','bags')} × ${esc(v.bag_weight)} kg</div>
    <label class="f">${L('จำนวนใบ','Number of slips')} (1–50)<input class="in" type="number" id="pkN" min="1" max="50" value="1" style="font-size:22px;font-weight:700" oninput="pkNHint()"></label>
    <div class="btns">${[1,2,3,5,10].map(n=>`<button class="btn" style="min-height:36px" onclick="$('#pkN').value=${n};pkNHint()">${n}</button>`).join('')}</div>
    <div id="pkNh" style="font-weight:600;color:${PKC.dblue}"></div>
    <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" id="pkPr" checked> ${L('พิมพ์ A6 ทันทีหลังบันทึก','Print A6 right after saving')}</label>
   </div><div id="pkE"></div>
   <div class="btns" style="justify-content:flex-end;margin-top:12px"><button class="btn" onclick="closeDlg()">${L('ยกเลิก','Cancel')}</button><button class="btn pri" id="pkGo" onclick="pkSave()">${L('สร้างใบพาเลท','Make slips')}</button></div>`);
  pkNHint();
}
function pkNHint(){const n=Math.max(1,Math.min(50,+$('#pkN').value||1));$('#pkNh').textContent=n===1?L(`ใบที่ #${PKNEXT}`,`Slip #${PKNEXT}`):L(`ใบที่ #${PKNEXT} ถึง #${PKNEXT+n-1} (${n} ใบ)`,`Slips #${PKNEXT} to #${PKNEXT+n-1} (${n} slips)`);}
async function pkSave(){
  const v=slipVals('sf');
  const pm=(PRODS||[]).find(p=>p.code===v.product_code);
  if(pm&&pm.weight&&Math.abs(bagKg(v.bag_weight)-pm.weight)>0.001&&!confirm(L(`น้ำหนักต่อถุง ${n0(bagKg(v.bag_weight))} kg ไม่ตรงกับข้อมูลสินค้า (${n0(pm.weight)} kg) — บันทึกต่อ?`,`Bag weight ${n0(bagKg(v.bag_weight))} kg differs from the product master (${n0(pm.weight)} kg) — save anyway?`)))return;
  v.copies=Math.max(1,Math.min(50,+$('#pkN').value||1));const pr=$('#pkPr').checked;$('#pkGo').disabled=true;
  let d;try{d=await post('/api/fg/slips',v);}catch(e){$('#pkE').innerHTML=err(e);$('#pkGo').disabled=false;return;}
  closeDlg();
  try{localStorage.setItem('fg_slip_last',JSON.stringify(Object.assign({},v,{qty:v.bags})));}catch(e){}
  Object.assign(LAST,v,{qty:v.bags});SLIPLAST=d.slips;
  if(pr)printSlips(d.slips);
  if(!PKF.all&&PKF.d2<today()){PKF.d2=today();}if(!PKF.all&&PKF.d1>today())PKF.d1=today();await pkLoad();pkLive();
  $('#sfMsg').innerHTML=`<div class="msg m-ok">${L('สร้างแล้ว','Made')} ${d.slips.length} ${L('ใบ','slip(s)')}: ${d.slips.map(s=>'#'+esc(s.pallet_no)).join(', ')} <button class="btn" style="min-height:32px;margin-left:6px" onclick="printSlips(SLIPLAST)">${L('พิมพ์อีกครั้ง','Print again')}</button></div>`;
}
let SLIPLAST=[],SLIPS=[],SLSEL={},SLF={d1:daysAgo(6),d2:today(),q:'',pc:'',st:''};

/* ---------- A6 slip (148 × 105 mm landscape) ---------- */
async function qrSvgStr(text){
  await loadJs('/vendor/qrcode.js',()=>window.qrcode);
  if(qrcode.stringToBytesFuncs&&qrcode.stringToBytesFuncs['UTF-8'])qrcode.stringToBytes=qrcode.stringToBytesFuncs['UTF-8'];
  const q=qrcode(0,'M');q.addData(text,'Byte');q.make();const n=q.getModuleCount(),m=2;let p='';
  for(let r=0;r<n;r++)for(let c=0;c<n;c++)if(q.isDark(r,c))p+=`M${c+m} ${r+m}h1v1h-1z`;
  return `<svg viewBox="0 0 ${n+2*m} ${n+2*m}" shape-rendering="crispEdges" style="width:100%;height:100%;display:block"><rect width="100%" height="100%" fill="#fff"/><path d="${p}" fill="#000"/></svg>`;
}
const A6CSS=`@page{size:148mm 105mm;margin:0}*{box-sizing:border-box}body{margin:0;font-family:"Sarabun",Tahoma,sans-serif;color:#000;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.a6{width:148mm;height:105mm;padding:4mm 5mm;display:flex;flex-direction:column;gap:2mm;page-break-after:always;overflow:hidden;background:#fff}
.a6:last-child{page-break-after:auto}
.a6 .hd{display:flex;align-items:stretch;gap:3mm;border-bottom:.6mm solid #000;padding-bottom:1.5mm}
.a6 .tt{flex:1}.a6 .tt b{font-size:15pt;display:block;line-height:1.1}.a6 .tt span{font-size:8pt}
.a6 .no{border:.6mm solid #000;border-radius:2mm;min-width:30mm;text-align:center;padding:0 2mm}.a6 .no small{font-size:7pt;display:block}.a6 .no b{font-size:24pt;line-height:1}
.a6 .bd{flex:1;display:flex;gap:3mm;min-height:0}
.a6 table{border-collapse:collapse;width:100%;height:100%;font-size:10pt}.a6 td{border:.25mm solid #000;padding:.8mm 1.8mm;vertical-align:middle}
.a6 td.l{width:25mm;font-size:7.5pt;line-height:1.1;background:#eee}.a6 td.v{font-weight:700}
.a6 .big{font-size:14pt}.a6 .sm{font-size:8.5pt}.a6 .nm{font-size:10pt;line-height:1.15}
.a6 .qr{width:46mm;flex:none;display:flex;flex-direction:column;align-items:center;gap:1mm}.a6 .qr .q{width:46mm;height:46mm}
.a6 .qr .c{font-size:9pt;font-weight:700;text-align:center;line-height:1.15}.a6 .qr .s{font-size:6.5pt;text-align:center}
.a6 .ft{display:flex;gap:3mm;font-size:7pt}.a6 .ft div{flex:1;border-top:.25mm dotted #000;padding-top:.6mm;text-align:center}`;
async function slipHtml(s,copy){
  const q=await qrSvgStr(s.qr);
  const dt=s.packed_at||'',row=(th,en,v,cls)=>`<tr><td class="l">${th}<br>${en}</td><td class="v ${cls||''}">${v}</td></tr>`;
  return `<div class="a6"><div class="hd"><div class="tt"><b>ใบพาเลท · PALLET SLIP</b><span>${copy>1?`<b style="border:1.5px solid #000;padding:0 4px;margin-right:4px">REPRINT · COPY ${copy}</b>`:''}FG ${esc(ME.factory_code)} · ${esc(s.pack_type||'')} · Doc ${esc(s.doc_no||'-')} · ${fmtD(dt.slice(0,10))} ${esc(dt.slice(11,16))}</span></div>
    <div class="no"><small>Pallet / Slip No.</small><b>${esc(s.pallet_no)}</b></div></div>
   <div class="bd"><div style="flex:1;min-width:0"><table>
    ${row('เบอร์อาหาร','Formula code',esc(s.product_code))}
    ${row('ชื่อสินค้า','Formula name',`<span class="nm">${esc(s.product_name)}</span>`)}
    ${row('ล็อต','Lot No.',esc(s.lot_no),'big')}
    ${row('วันผลิต / หมดอายุ','MFG / EXP',`${fmtD(s.mfg)} → ${fmtD(s.exp)}`)}
    ${row('จำนวนถุง','Bags × kg/bag',`${n0(s.qty)} ${esc(s.unit||'')} × ${esc(s.bag_weight||n0(s.weight_unit))} kg`)}
    ${row('น้ำหนักรวม','Total weight',`${n0(s.total_weight||s.qty*s.weight_unit)} kg`,'big')}
    ${row('เครื่องแพค / ไลน์','Pack M/c / line',`${esc(s.pack_machine||'-')} · ${esc(s.pd_line||'-')}`,'sm')}
    ${row('ผู้แพค','Staff name',esc(s.staff_name||s.operator||'-'))}
   </table></div>
   <div class="qr"><div class="q">${q}</div><div class="c">${esc(s.lot_no)} · #${esc(s.pallet_no)}</div><div class="s">${esc(s.product_code)} · ID ${s.id}</div></div></div>
   <div class="ft"><div>Checker แพคกิ้ง / Packing checker</div><div>ผู้รับ FG / FG receiver</div></div></div>`;
}
/* b497 — every print goes through a confirm step. A slip that was printed before is a REPRINT:
   red warning (printed N× · last by · when), a reason is required, and the copy is marked on the slip. */
let PRQ=null;
const PRWHY=()=>[['jam',L('กระดาษติด / พิมพ์ไม่ออก','Printer jam / bad print')],['damaged',L('ใบพาเลทชำรุด / เปื้อน','Slip damaged / dirty')],
  ['lost',L('ใบพาเลทหาย','Slip lost')],['fixed',L('แก้ไขข้อมูลแล้ว','Data was corrected')],['other',L('อื่นๆ','Other')]];
async function printSlips(list){
  list=(list||[]).filter(Boolean);if(!list.length)return;
  let pr=[];
  if(can('pack')){try{pr=(await post('/api/fg/slips-print-check',{ids:list.map(s=>s.id)})).printed||[];}catch(e){}}
  const PM={};pr.forEach(p=>PM[p.id]=p);PRQ={list,PM};
  const re=pr.length;
  dlg(`<h2>${re?'⚠️ '+L('ใบพาเลทนี้เคยพิมพ์แล้ว','Already printed — this is a REPRINT'):L('ยืนยันการพิมพ์ใบพาเลท','Confirm pallet slip print')}</h2>
   ${re?`<div class="msg m-bad">${L('ใบต่อไปนี้พิมพ์ไปแล้ว — การพิมพ์ซ้ำจะถูกบันทึกในชื่อของคุณ','These slips were printed before — the reprint is recorded under your name')}</div>`:''}
   <div class="tw" style="max-height:40vh;overflow:auto"><table><thead><tr><th>${L('พาเลท','Pallet')}</th><th>Lot No.</th><th>${L('เบอร์อาหาร','Product')}</th><th class="r">${L('ถุง','Bags')}</th><th>${L('พิมพ์แล้ว','Printed')}</th></tr></thead><tbody>
    ${list.map(s=>{const p=PM[s.id];return `<tr style="${p?'background:#FEF2F2':''}"><td><b>#${esc(s.pallet_no)}</b></td><td class="mono">${esc(s.lot_no)}</td><td>${esc(s.product_code)}</td><td class="r">${n0(s.qty)}</td>
      <td>${p?`<b style="color:#B91C1C">${p.print_count}× </b><span class="muted">${esc(p.last_by||'-')} · ${fmtT(p.last_at)}</span>`:`<span class="muted">${L('ยังไม่เคยพิมพ์','first print')}</span>`}</td></tr>`;}).join('')}</tbody></table></div>
   ${re?`<label class="f" style="margin-top:12px">${L('เหตุผลที่พิมพ์ซ้ำ','Reason for reprint')} *<select class="in" id="prWhy" onchange="prChk()"><option value="">— ${L('เลือก','choose')} —</option>${PRWHY().map(w=>`<option value="${w[0]}">${esc(w[1])}</option>`).join('')}</select></label>
    <label class="f" style="margin-top:8px">${L('รายละเอียด','Details')}<input class="in" id="prTx" oninput="prChk()" placeholder="${L('จำเป็นถ้าเลือก อื่นๆ','required for Other')}"></label>
    <label style="display:flex;gap:8px;align-items:flex-start;margin-top:10px;font-size:13.5px"><input type="checkbox" id="prAck" onchange="prChk()" style="margin-top:3px">
     <span>${L('ฉันจะเก็บ / ทำลายใบเก่า ให้มีใบพาเลทเพียงใบเดียวบนพาเลท','I will remove / destroy the old slip so only ONE slip is on the pallet')}</span></label>`:''}
   <div class="btns" style="justify-content:flex-end;margin-top:14px"><button class="btn" onclick="closeDlg()">${L('ยกเลิก','Cancel')}</button>
    <button class="btn ${re?'bad':'pri'}" id="prGo" ${re?'disabled':''} onclick="prGo()">${re?L('พิมพ์ซ้ำ','Reprint'):L('พิมพ์','Print')} ${list.length} ${L('ใบ','slip(s)')}</button></div>`);
}
function prReason(){const w=$('#prWhy');if(!w)return '';const t=($('#prTx').value||'').trim(),o=PRWHY().find(x=>x[0]===w.value);return o?(o[1]+(t?' — '+t:'')):'';}
function prChk(){const b=$('#prGo');if(!b)return;const w=$('#prWhy').value,t=($('#prTx').value||'').trim();
  b.disabled=!(w&&(w!=='other'||t)&&$('#prAck').checked);}
async function prGo(){
  if(!PRQ)return;const {list,PM}=PRQ;const reason=prReason();
  if(Object.keys(PM).length&&!reason)return;
  const w=window.open('','_blank');   // opened inside the click so the browser does not block it
  if(!w){alert(L('เบราว์เซอร์บล็อกหน้าต่างพิมพ์ — อนุญาต pop-up','The browser blocked the print window — allow pop-ups'));return;}
  closeDlg();
  w.document.write('<p style="font-family:sans-serif">Preparing…</p>');
  let pages='';for(const s of list)pages+=await slipHtml(s,PM[s.id]?PM[s.id].print_count+1:1);
  w.document.open();
  w.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>Pallet slip</title><style>${A6CSS}</style></head><body>${pages}<script>window.onload=function(){setTimeout(function(){window.print()},200)}<\/script></body></html>`);
  w.document.close();
  if(can('pack'))post('/api/fg/slips-printed',{ids:list.map(s=>s.id),reason}).catch(()=>{});
  PRQ=null;
}
async function slipPreview(id){
  const s=SLIPS.concat(SLIPLAST).find(x=>x.id===id);if(!s)return;
  const h=await slipHtml(s);
  dlg(`<style>${A6CSS.replace('@page{size:148mm 105mm;margin:0}','')}.a6{border:1px solid #CBD5E1;margin:0 auto}</style><div style="overflow:auto">${h}</div>
   <div class="btns" style="justify-content:flex-end;margin-top:12px"><button class="btn" onclick="closeDlg()">${L('ปิด','Close')}</button><button class="btn pri" onclick="printSlips([SLIPS.concat(SLIPLAST).find(x=>x.id===${id})])">${L('พิมพ์','Print')}</button></div>`);
}

/* ---------- slip list ---------- */
async function pgSlips(){
  await loadLists();
  $('#app').innerHTML=`<h1>${L('รายการใบพาเลท','Pallet slips')}</h1><p class="sub">${L('พิมพ์ซ้ำ แก้ไข (ก่อน FG รับ) หรือยกเลิก','reprint, edit (before FG receives) or cancel')}</p>
   <div class="bar"><label class="f">${L('จาก','From')}<input class="in" type="date" id="l1" value="${SLF.d1}"></label><label class="f">${L('ถึง','To')}<input class="in" type="date" id="l2" value="${SLF.d2}"></label>
    <label class="f">${L('ค้นหา','Search')}<input class="in" id="lq" value="${esc(SLF.q)}" placeholder="${L('ล็อต / สินค้า / เอกสาร','lot / product / doc')}" onkeydown="if(event.key==='Enter')slLoad()" autocomplete="off"></label>
    <label class="f">${L('Checker แพคกิ้ง','Packing check')}<select class="in" id="lpc"><option value="">${L('ทั้งหมด','All')}</option>${['pending','approved','rejected'].map(s=>`<option value="${s}" ${SLF.pc===s?'selected':''}>${esc(L(...PCL[s]))}</option>`).join('')}</select></label>
    <label class="f">FG<select class="in" id="lst"><option value="">${L('ทั้งหมด','All')}</option>${['packed','rejected_by_fg','moved_to_fg','cancelled'].map(s=>`<option value="${s}" ${SLF.st===s?'selected':''}>${esc(L(...STL[s]))}</option>`).join('')}</select></label>
    <button class="btn pri" onclick="slLoad()">${L('แสดง','Show')}</button></div><div id="slBody"></div>`;
  ta($('#lq'),taSrv('all'),()=>slLoad());
  slLoad();
}
async function slLoad(){
  SLF={d1:$('#l1').value,d2:$('#l2').value,q:$('#lq').value.trim(),pc:$('#lpc').value,st:$('#lst').value};SLSEL={};
  try{SLIPS=(await api(`/api/fg/slips?d1=${SLF.d1}&d2=${SLF.d2}&pc=${SLF.pc}&status=${SLF.st}&q=${encodeURIComponent(SLF.q)}`)).rows;}catch(e){$('#slBody').innerHTML=err(e);return;}
  slDraw();
}
function slDraw(){
  const kg=SLIPS.reduce((a,s)=>a+(s.status!=='cancelled'?s.total_weight||0:0),0);
  $('#slBody').innerHTML=`<div class="btns" style="margin-bottom:10px"><span class="muted">${SLIPS.length} ${L('ใบ','slips')} · ${n0(kg)} kg</span><span style="flex:1"></span>
    <button class="btn" id="slPr" disabled onclick="printSlips(SLIPS.filter(s=>SLSEL[s.id]))">${L('พิมพ์ที่เลือก','Print selected')}</button>
    <button class="btn pri" onclick="go('slip')">+ ${L('ใบพาเลทใหม่','New slip')}</button></div><div id="slT"></div>`;
  xTable($('#slT'),'sllist',[XC('packed_at',L('วันที่','Date'),{val:s=>(s.packed_at||'').slice(0,10),fmt:s=>fmtT(s.packed_at),cls:'nw'}),XC('pallet_no',L('พาเลท','Pallet'),{num:1,fmt:s=>`<b>#${esc(s.pallet_no)}</b>`}),
   XC('product_code',L('เบอร์อาหาร','Product'),{fmt:pName,val:pVal}),XC('lot_no','Lot No.',{fmt:s=>`<b>${esc(s.lot_no)}</b>`,cls:'mono nw'}),
   XC('qty',L('ถุง','Bags'),{r:1,num:1,fmt:s=>n0(s.qty)}),XC('total_weight','kg',{r:1,num:1,fmt:s=>n0(s.total_weight)}),
   XC('pack_machine',L('เครื่อง / ไลน์','Machine / line'),{val:s=>(s.pack_machine||'')+' · '+(s.pd_line||''),fmt:s=>`${esc(s.pack_machine)}<div class="muted">${esc(s.pd_line)}</div>`}),XC('staff_name',L('ผู้แพค','Staff')),
   XC('pc_status',L('Checker แพคกิ้ง','Packing check'),{val:s=>s.status==='cancelled'?'':L(...(PCL[s.pc_status]||[s.pc_status,s.pc_status])),fmt:s=>(s.status==='cancelled'?'':pcPill(s.pc_status))+(s.pc_note?`<div class="muted">${esc(s.pc_note)}</div>`:'')}),
   XC('status','FG',{val:s=>L(...(STL[s.status]||[s.status,s.status])),fmt:s=>stPill(s.status)+(s.status==='rejected_by_fg'&&s.note?`<div class="muted" style="color:var(--bad)">${esc(s.note)}</div>`:'')}),
   XC('_a','',{nf:1,cls:'nw',fmt:s=>`<button class="btn sm" onclick="slipPreview(${s.id})">A6</button>
     ${s.status==='packed'||s.status==='rejected_by_fg'?`<button class="btn sm" onclick="slEdit(${s.id})">${s.status==='rejected_by_fg'?L('แก้ไข + พิมพ์ใหม่','Fix + reprint'):L('แก้ไข','Edit')}</button>
     <button class="btn sm badl" onclick="slCancel(${s.id})">${L('ยกเลิก','Cancel')}</button>`:''}${s.print_count?`<div class="muted">${L('พิมพ์','printed')} ${s.print_count}×</div>`:''}`})],
   SLIPS,{select:SLSEL,empty:L('ไม่มีใบพาเลท','No slips'),foot:xFoot('qty','total_weight'),maxH:'calc(100vh - 300px)',
   after:()=>{const n=SLIPS.filter(s=>SLSEL[s.id]).length,b=$('#slPr');if(b){b.disabled=!n;b.textContent=L('พิมพ์ที่เลือก','Print selected')+` (${n})`;}}});
}
function slEdit(id){
  const s=SLIPS.find(x=>x.id===id);
  dlg(`<h2>${L('แก้ไขใบพาเลท','Edit slip')} ${esc(s.lot_no)} #${esc(s.pallet_no)}</h2><p class="muted">${L('แก้แล้วต้องผ่าน Checker แพคกิ้งใหม่ และพิมพ์ใบใหม่ติดแทน','After editing it goes back to the packing checker — print the new slip and replace the old one')}</p>
   ${slipForm(s,'se')}<div id="seE"></div><div class="btns" style="justify-content:flex-end;margin-top:12px"><button class="btn" onclick="closeDlg()">${L('ยกเลิก','Cancel')}</button><button class="btn pri" onclick="slEditSave(${id})">${L('บันทึก + พิมพ์','Save + print')}</button></div>`);
  ta($('#sePc'),taProd);slipTot('se');
}
async function slEditSave(id){
  const v=slipVals('se'),bad=slipCheck(v);if(bad){$('#seE').innerHTML=err(bad);return;}
  let d;try{d=await post('/api/fg/slips/'+id,v);}catch(e){$('#seE').innerHTML=err(e);return;}
  closeDlg();printSlips([d.slip]);(PAGE==='slip'?pkLoad:slLoad)();
}
async function slCancel(id){
  const why=prompt(L('เหตุผลที่ยกเลิกใบพาเลท','Reason for cancelling this slip'));if(!why||!why.trim())return;
  try{await post(`/api/fg/slips/${id}/cancel`,{note:why});}catch(e){alert(e.message);return;}slLoad();
}

/* ---------- packing-room checker ---------- */
let PCK='pending';
async function pgSlipChk(){
  $('#app').innerHTML=`<h1>${L('Checker แพคกิ้ง','Packing check')}</h1><p class="sub">${L('ตรวจใบพาเลทก่อนส่ง FG — FG รับได้เฉพาะใบที่อนุมัติแล้ว','check slips before they go to FG — FG can only receive approved slips')}</p>
   <div class="tabs" id="pcT"></div><div id="pcBody"></div>`;
  pcLoad();
}
async function pcLoad(){
  SLSEL={};
  let d;try{d=await api(`/api/fg/slips?pc=${PCK}&status=packed&limit=1000`);}catch(e){$('#pcBody').innerHTML=err(e);return;}
  SLIPS=d.rows;
  $('#pcT').innerHTML=['pending','rejected','approved'].map(s=>`<button class="tab ${PCK===s?'on':''}" onclick="PCK='${s}';pcLoad()">${esc(L(...PCL[s]))} · ${d.counts[s]||0}</button>`).join('');
  pcDraw();
}
function pcDraw(){
  const n=Object.values(SLSEL).filter(Boolean).length,canAct=PCK!=='approved';
  $('#pcBody').innerHTML=`<div class="tw"><table><thead><tr>${canAct?`<th><input type="checkbox" onchange="SLIPS.forEach(s=>SLSEL[s.id]=this.checked);pcDraw()" aria-label="Select all"></th>`:''}
    <th>${L('เวลา','Time')}</th><th>${L('พาเลท','Pallet')}</th><th>${L('เบอร์อาหาร','Product')}</th><th>Lot No.</th><th>MFG / EXP</th><th class="r">${L('ถุง','Bags')}</th><th class="r">kg/${L('ถุง','bag')}</th><th class="r">kg</th><th>${L('เครื่อง / ไลน์','Machine / line')}</th><th>${L('ผู้แพค','Staff')}</th><th>${L('หมายเหตุ','Note')}</th><th></th></tr></thead><tbody>
   ${SLIPS.map(s=>`<tr class="${SLSEL[s.id]?'sel':''}">${canAct?`<td><input type="checkbox" ${SLSEL[s.id]?'checked':''} onchange="SLSEL[${s.id}]=this.checked;pcDraw()" aria-label="Select"></td>`:''}
    <td class="nw">${fmtT(s.packed_at)}</td><td><b>#${esc(s.pallet_no)}</b></td><td>${esc(s.product_code)}<div class="muted">${esc(s.product_name)}</div></td><td class="mono nw"><b>${esc(s.lot_no)}</b></td>
    <td class="nw">${fmtD(s.mfg)}<div class="muted">${fmtD(s.exp)}</div></td><td class="r">${n0(s.qty)}</td><td class="r">${esc(s.bag_weight)}</td><td class="r"><b>${n0(s.total_weight)}</b></td>
    <td>${esc(s.pack_machine)}<div class="muted">${esc(s.pd_line)}</div></td><td>${esc(s.staff_name)}</td><td>${esc(s.pc_note||'')}${s.pc_by?`<div class="muted">${esc(s.pc_by)} ${fmtT(s.pc_at)}</div>`:''}</td>
    <td><button class="btn" style="min-height:32px;padding:3px 10px" onclick="slipPreview(${s.id})">A6</button></td></tr>`).join('')
    ||`<tr><td colspan="13" class="muted" style="padding:20px;text-align:center">${L('ไม่มีรายการ','Nothing here')}</td></tr>`}</tbody></table></div>
   ${canAct?`<div class="card" style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;align-items:center;margin-top:12px"><span class="muted">${n} ${L('รายการที่เลือก','selected')}</span>
    <div class="btns"><button class="btn bad" ${n?'':'disabled'} onclick="pcAct('reject')">${L('ไม่อนุมัติ','Reject')}</button><button class="btn ok" ${n?'':'disabled'} onclick="pcAct('approve')">${L('อนุมัติ → ส่ง FG','Approve → to FG')}</button></div></div>`:''}`;
}
async function pcAct(action){
  const ids=Object.keys(SLSEL).filter(k=>SLSEL[k]).map(Number);if(!ids.length)return;
  let note='';if(action==='reject'){note=prompt(L('เหตุผลที่ไม่อนุมัติ','Reason for rejecting'))||'';if(!note.trim())return;}
  try{await post('/api/fg/slips-check',{ids,action,note});}catch(e){alert(e.message);return;}pcLoad();
}

/* ════════ b497 Packing checker: scan the printed slip → verify → approve. PC = USB scanner, phone = camera ════════ */
let PSMODE=(()=>{try{const v=localStorage.getItem('fg_scan_mode');if(v)return v;}catch(e){}return matchMedia('(pointer:fine)').matches?'usb':'camera';})();
let PS=null,PSLAST='';
function pgPScan(){
  PS=null;
  $('#app').innerHTML=`<div class="ph" style="max-width:820px"><h1>${L('สแกนตรวจใบพาเลท','Scan & verify pallet slip')}</h1>
   <p class="sub">${L('สแกน QR บนใบพาเลทที่พิมพ์แล้ว ตรวจกับพาเลทจริง แล้วอนุมัติ — FG รับได้เฉพาะใบที่อนุมัติ','Scan the QR on the printed slip, check it against the real pallet, then approve — FG can only receive approved slips')}</p>
   <div class="tabs" style="margin-bottom:6px"><button class="tab ${PSMODE==='usb'?'on':''}" onclick="psMode('usb')">⌨ ${L('เครื่องสแกน USB (PC)','USB scanner (PC)')}</button>
    <button class="tab ${PSMODE==='camera'?'on':''}" onclick="psMode('camera')">📷 ${L('กล้อง (มือถือ)','Camera (phone)')}</button></div>
   <div id="psIn"></div><div id="psLast">${PSLAST}</div><div id="psBody"></div></div>`;
  psIn();
}
function psMode(m){PSMODE=m;try{localStorage.setItem('fg_scan_mode',m)}catch(e){}pgPScan();}
function psIn(){
  const B=$('#psIn');if(!B)return;
  if(PSMODE==='camera'){B.innerHTML=scanBox(L('สแกน QR ใบพาเลท','Scan pallet slip QR'),'psCam','#B45309');return;}
  B.innerHTML=`<div class="usbw" id="usbw" onclick="psFocus()"><div class="st"><i></i><span id="usbst"></span></div>
    <input id="psUsb" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="${L('ยิง QR ด้วยเครื่องสแกน USB ที่นี่','Scan the QR with the USB scanner here')}"
     onfocus="psSt()" onblur="psSt();setTimeout(psFocus,400)" onkeydown="if(event.key==='Enter'||event.key==='Tab'){event.preventDefault();const v=this.value;this.value='';if(v.trim())psGot(v,'usb')}"></div>`;
  psFocus();psSt();
}
function psCam(v){psGot(v,'camera');}
function psSt(){const w=$('#usbw'),s=$('#usbst');if(!w||!s)return;const on=document.activeElement===$('#psUsb');w.classList.toggle('on',on);
  s.textContent=on?L('พร้อม — รอสแกน','Ready — waiting for scan'):L('คลิกที่นี่ก่อนสแกน','Click here before scanning');}
function psFocus(){if(PAGE!=='pscan'||PSMODE!=='usb'||$('#dlg'))return;const a=document.activeElement;
  if(a&&a!==document.body&&a.id!=='psUsb'&&/INPUT|TEXTAREA|SELECT/.test(a.tagName))return;const i=$('#psUsb');if(i)i.focus();}
let PSVIA='usb';
async function psGot(text,via){
  PSVIA=via||PSMODE;
  const B=$('#psBody');B.innerHTML=`<div class="card">${L('กำลังค้นหา…','Looking up…')}</div>`;
  try{PS=await post('/api/fg/slips-scan',{text,via:PSVIA});}
  catch(e){B.innerHTML=err(e);if(navigator.vibrate)try{navigator.vibrate([60,60,60])}catch(x){};psFocus();return;}
  psDraw();psFocus();
}
function psDraw(){
  const s=PS.slip,pr=PS.prints||[],n=s.print_count||0,B=$('#psBody');
  const can_act=s.status==='packed'&&(s.pc_status==='pending'||s.pc_status==='rejected');
  let banner='';
  if(s.status==='cancelled')banner=`<div class="msg m-bad">${L('ใบนี้ถูกยกเลิกแล้ว — ห้ามใช้','This slip is CANCELLED — do not use it')}</div>`;
  else if(s.status!=='packed')banner=`<div class="msg m-info">${esc(L(...(STL[s.status]||[s.status,s.status])))} — ${L('ไม่ต้องตรวจ','nothing to check')}</div>`;
  else if(s.pc_status==='approved')banner=`<div class="msg m-ok">✓ ${L('อนุมัติแล้วโดย','Already approved by')} ${esc(s.pc_by)} · ${fmtT(s.pc_at)}</div>`;
  else if(s.pc_status==='rejected')banner=`<div class="msg m-warn">${L('เคยไม่อนุมัติ:','Rejected before:')} ${esc(s.pc_note||'')} (${esc(s.pc_by)})</div>`;
  const v=(l,x,c)=>`<div class="${c||''}"><small>${l}</small><b>${x}</b></div>`;
  const pcc={pending:'background:#FEF3C7;color:#92400E',approved:'background:#DCFCE7;color:#166534',rejected:'background:#FEE2E2;color:#991B1B'}[s.pc_status]||'background:#EEF2F6';
  B.innerHTML=`<div class="card" style="border:2px solid ${can_act?'#F59E0B':'var(--line)'}">
    <div style="display:flex;justify-content:space-between;gap:8px;align-items:center;flex-wrap:wrap"><span class="mono" style="font-size:22px;font-weight:700">${esc(s.lot_no)} · #${esc(s.pallet_no)}</span>
     <span class="pill" style="${pcc}">${esc(L(...(PCL[s.pc_status]||[s.pc_status,s.pc_status])))}</span></div>
    ${banner}
    ${n>1?`<div class="msg m-bad">⚠️ ${L('ใบนี้พิมพ์แล้ว','This slip was printed')} ${n} ${L('ครั้ง — ตรวจว่ามีใบพาเลทใบเดียวบนพาเลท','times — make sure only ONE slip is on the pallet')}
      <div style="font-weight:400;font-size:13px;margin-top:4px">${pr.filter(p=>p.reprint).map(p=>`${L('ฉบับ','Copy')} ${p.copy_no}: ${esc(p.user_name)} · ${fmtT(p.printed_at)} · ${esc(p.reason||'')}`).join('<br>')}</div></div>`:''}
    ${n===0&&s.status==='packed'?`<div class="msg m-warn">${L('ระบบไม่มีบันทึกการพิมพ์ใบนี้','No print recorded for this slip')}</div>`:''}
    <div class="vgrid">
     ${v(L('เบอร์อาหาร','Formula code'),esc(s.product_code),'big')}${v(L('ชื่อสินค้า','Formula name'),esc(s.product_name))}
     ${v(L('จำนวนถุง','Bags'),n0(s.qty)+' '+esc(s.unit||''),'big')}${v(L('กก./ถุง · น้ำหนักรวม','kg/bag · total'),esc(s.bag_weight||n0(s.weight_unit))+' · '+n0(s.total_weight)+' kg')}
     ${v('MFG → EXP',fmtD(s.mfg)+' → '+fmtD(s.exp))}${v(L('เครื่องแพค / ไลน์','Machine / line'),esc(s.pack_machine||'-')+' · '+esc(s.pd_line||'-'))}
     ${v(L('ผู้แพค','Staff'),esc(s.staff_name||'-'))}${v(L('เวลาแพค / พิมพ์','Packed / printed'),fmtT(s.packed_at)+' · '+n+'×')}</div>
    ${can_act?`<div style="display:flex;gap:10px;margin-top:6px"><button class="btn bad big" style="flex:1" onclick="psAct('reject')">${L('ไม่อนุมัติ','Reject')}</button>
      <button class="btn ok big" style="flex:2" onclick="psAct('approve')">✓ ${L('ถูกต้อง — อนุมัติ → ส่ง FG','Correct — approve → to FG')}</button></div>`:''}
    <details style="margin-top:10px"><summary class="muted" style="cursor:pointer">${L('ประวัติขั้นตอน','Audit trail')}</summary>${logList(PS.log)}</details></div>`;
}
async function psAct(action){
  const s=PS.slip;let note='';
  if(action==='reject'){note=prompt(L('เหตุผลที่ไม่อนุมัติ','Reason for rejecting'))||'';if(!note.trim()){psFocus();return;}}
  try{const d=await post('/api/fg/slips-check',{ids:[s.id],action,note,via:PSVIA});
    if(!d.done)throw new Error(L('ใบนี้ถูกตรวจไปแล้ว','This slip was already checked'));}
  catch(e){$('#psBody').insertAdjacentHTML('afterbegin',err(e));psFocus();return;}
  PSLAST=`<div class="msg ${action==='approve'?'m-ok':'m-bad'}">${action==='approve'?'✓ '+L('อนุมัติแล้ว','Approved'):'✗ '+L('ไม่อนุมัติ','Rejected')}: ${esc(s.lot_no)} · #${esc(s.pallet_no)} · ${esc(s.product_code)} <span class="muted">${new Date().toTimeString().slice(0,5)}</span></div>`;
  PS=null;$('#psBody').innerHTML='';$('#psLast').innerHTML=PSLAST;psFocus();
}

/* checked list — what the packing checker approved / rejected, by check date */
let PAF={d1:today(),d2:today(),pc:'approved',me:0,q:''};
async function pgPApproved(){
  $('#app').innerHTML=`<h1>${L('รายการที่ตรวจแล้ว','Checked slips')}</h1><p class="sub">${L('ใบพาเลทที่ Checker แพคกิ้งอนุมัติ / ไม่อนุมัติ ตามวันที่ตรวจ','pallet slips approved / rejected by the packing checker, by check date')}</p>
   <div class="card" style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end">
    <label class="f">${L('จาก','From')}<input class="in" type="date" id="paD1" value="${PAF.d1}"></label><label class="f">${L('ถึง','To')}<input class="in" type="date" id="paD2" value="${PAF.d2}"></label>
    <label class="f" style="flex:1;min-width:160px">${L('ค้นหา','Search')}<input class="in" id="paQ" value="${esc(PAF.q)}" placeholder="Lot / ${L('เบอร์อาหาร','product')}"></label>
    <label style="display:flex;gap:6px;align-items:center;min-height:40px"><input type="checkbox" id="paMe" ${PAF.me?'checked':''}> ${L('เฉพาะของฉัน','Only mine')}</label>
    <button class="btn pri" onclick="paLoad()">${L('แสดง','Show')}</button></div>
   <div class="tabs" id="paT"></div><div id="paBody"></div>`;
  paLoad();
}
async function paLoad(){
  PAF.d1=$('#paD1').value||today();PAF.d2=$('#paD2').value||PAF.d1;PAF.q=$('#paQ').value.trim();PAF.me=$('#paMe').checked?1:0;
  const B=$('#paBody');B.innerHTML=LOADH;
  let d;try{d=await api(`/api/fg/slips?pc=${PAF.pc}&datef=pc&d1=${PAF.d1}&d2=${PAF.d2}&q=${encodeURIComponent(PAF.q)}${PAF.me?'&by=me':''}&limit=2000`);}catch(e){B.innerHTML=err(e);return;}
  $('#paT').innerHTML=['approved','rejected'].map(k=>`<button class="tab ${PAF.pc===k?'on':''}" onclick="PAF.pc='${k}';paLoad()">${esc(L(...PCL[k]))}${PAF.pc===k?' · '+d.rows.length:''}</button>`).join('')
    +`<span class="muted" style="margin-left:auto;align-self:center">${L('รอสแกนตรวจ','Waiting to be scanned')}: <b>${d.counts.pending||0}</b></span>`;
  SLIPS=d.rows;
  const tb=d.rows.reduce((a,s)=>a+(+s.qty||0),0),tk=d.rows.reduce((a,s)=>a+(+s.total_weight||0),0);
  B.innerHTML=`<div class="tw"><table><thead><tr><th>${L('เวลาตรวจ','Checked at')}</th><th>${L('ผู้ตรวจ','Checked by')}</th><th>${L('พาเลท','Pallet')}</th><th>${L('เบอร์อาหาร','Product')}</th><th>Lot No.</th><th>MFG / EXP</th><th class="r">${L('ถุง','Bags')}</th><th class="r">kg</th><th>${L('พิมพ์','Printed')}</th><th>${L('สถานะ FG','FG status')}</th><th></th></tr></thead><tbody>
   ${d.rows.map(s=>`<tr><td class="nw">${fmtT(s.pc_at)}</td><td>${esc(s.pc_by)}${s.pc_note?`<div class="muted">${esc(s.pc_note)}</div>`:''}</td><td><b>#${esc(s.pallet_no)}</b></td><td>${esc(s.product_code)}<div class="muted">${esc(s.product_name)}</div></td>
    <td class="mono nw"><b>${esc(s.lot_no)}</b></td><td class="nw">${fmtD(s.mfg)}<div class="muted">${fmtD(s.exp)}</div></td><td class="r">${n0(s.qty)}</td><td class="r">${n0(s.total_weight)}</td>
    <td>${(s.print_count||0)>1?`<b style="color:#B91C1C">${s.print_count}×</b>`:(s.print_count||0)+'×'}</td><td>${stPill(s.status)}</td>
    <td class="nw"><button class="btn sm" onclick="slipPreview(${s.id})">A6</button> <button class="btn sm" onclick="logDlg('packing',${s.id},'#${esc(s.pallet_no)}')">${L('ประวัติ','Log')}</button></td></tr>`).join('')
    ||`<tr><td colspan="11" class="muted" style="padding:20px;text-align:center">${L('ไม่มีรายการ','Nothing here')}</td></tr>`}</tbody>
   ${d.rows.length?`<tfoot><tr><td colspan="6">${d.rows.length} ${L('พาเลท','pallets')}</td><td class="r">${n0(tb)}</td><td class="r">${n0(tk)}</td><td colspan="3"></td></tr></tfoot>`:''}</table></div>`;
}

/* audit — every print / reprint / scan / approve / reject of a pallet slip, per user */
const PAL={slip_created:['สร้างใบพาเลท','Slip created'],slip_edited:['แก้ไขใบพาเลท','Slip edited'],slip_fixed_after_fg_reject:['แก้ไขหลัง FG ไม่รับ','Fixed after FG reject'],
  printed:['พิมพ์ (ฉบับแรก)','Printed (1st copy)'],reprinted:['พิมพ์ซ้ำ','REPRINTED'],checker_scanned:['Checker สแกน','Checker scanned'],
  pack_approve:['Checker อนุมัติ','Checker approved'],pack_reject:['Checker ไม่อนุมัติ','Checker rejected'],cancelled:['ยกเลิก','Cancelled'],
  moved_to_fg:['FG รับเข้า','Received by FG'],rejected_by_fg:['FG ไม่รับ','Rejected by FG'],packed:['กลับเป็นแพคแล้ว','Back to packed'],slip_from_access:['สร้างจาก Access','Made from Access']};
Object.assign(LOGL,PAL);
let PDF={d1:daysAgo(6),d2:today(),user:'',action:'',q:''},PDD=null;
async function pgPAudit(){
  $('#app').innerHTML=`<h1>${L('ประวัติพิมพ์ / ตรวจใบพาเลท','Pallet slip audit trail')}</h1><p class="sub">${L('ใครพิมพ์ พิมพ์ซ้ำ สแกน อนุมัติ ใบไหน เมื่อไร — แยกตามผู้ใช้','who printed, reprinted, scanned and approved which slip, and when — per user')}</p>
   <div class="card" style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end">
    <label class="f">${L('จาก','From')}<input class="in" type="date" id="pdD1" value="${PDF.d1}"></label><label class="f">${L('ถึง','To')}<input class="in" type="date" id="pdD2" value="${PDF.d2}"></label>
    <label class="f">${L('ผู้ใช้','User')}<select class="in" id="pdU" onchange="PDF.user=this.value"><option value="">${L('ทุกคน','Everyone')}</option></select></label>
    <label class="f">${L('การกระทำ','Action')}<select class="in" id="pdA"><option value="">${L('ทั้งหมด','All')}</option>${Object.keys(PAL).map(k=>`<option value="${k}" ${PDF.action===k?'selected':''}>${esc(L(...PAL[k]))}</option>`).join('')}</select></label>
    <label class="f" style="flex:1;min-width:140px">${L('ค้นหา','Search')}<input class="in" id="pdQ" value="${esc(PDF.q)}" placeholder="Lot / ${L('เบอร์อาหาร','product')}"></label>
    <button class="btn pri" onclick="pdLoad()">${L('แสดง','Show')}</button><button class="btn" onclick="pdCsv()">CSV</button></div>
   <div id="pdSum"></div><div id="pdBody"></div>`;
  pdLoad();
}
function pdUser(u){PDF.user=u;pdLoad();}
async function pdLoad(){
  PDF.d1=$('#pdD1').value;PDF.d2=$('#pdD2').value;PDF.action=$('#pdA').value;PDF.q=$('#pdQ').value.trim();
  $('#pdBody').innerHTML=LOADH;
  try{PDD=await api(`/api/fg/packing-audit?d1=${PDF.d1}&d2=${PDF.d2}&user=${encodeURIComponent(PDF.user)}&action=${PDF.action}&q=${encodeURIComponent(PDF.q)}`);}catch(e){$('#pdBody').innerHTML=err(e);return;}
  $('#pdU').innerHTML=`<option value="">${L('ทุกคน','Everyone')}</option>`+PDD.users.map(u=>`<option ${u===PDF.user?'selected':''}>${esc(u)}</option>`).join('');
  const by={};PDD.summary.forEach(r=>{(by[r.user_name]=by[r.user_name]||{})[r.action]=r.n;});
  const cols=['printed','reprinted','checker_scanned','pack_approve','pack_reject','slip_created','cancelled'];
  PDD.ul=Object.keys(by).sort();
  $('#pdSum').innerHTML=`<div class="tw" style="margin-bottom:12px"><table><thead><tr><th>${L('ผู้ใช้ (คลิกเพื่อกรอง)','User (click to filter)')}</th>${cols.map(c=>`<th class="r">${esc(L(...PAL[c]))}</th>`).join('')}</tr></thead><tbody>
   ${PDD.ul.map((u,i)=>`<tr style="cursor:pointer" onclick="pdUser(PDD.ul[${i}])"><td><b>${esc(u||'-')}</b></td>${cols.map(c=>`<td class="r" style="${c==='reprinted'&&by[u][c]?'color:#B91C1C;font-weight:700':''}">${by[u][c]||''}</td>`).join('')}</tr>`).join('')
   ||`<tr><td colspan="${cols.length+1}" class="muted" style="padding:14px;text-align:center">${L('ไม่มีรายการ','Nothing in this period')}</td></tr>`}</tbody></table></div>`;
  $('#pdBody').innerHTML=`<div class="tw"><table><thead><tr><th>${L('เวลา','Time')}</th><th>${L('ผู้ใช้','User')}</th><th>${L('การกระทำ','Action')}</th><th>${L('พาเลท','Pallet')}</th><th>Lot No.</th><th>${L('เบอร์อาหาร','Product')}</th><th>${L('รายละเอียด','Details')}</th></tr></thead><tbody>
   ${PDD.rows.map(r=>`<tr style="${r.action==='reprinted'?'background:#FEF2F2':''}"><td class="nw">${fmtT(r.created_at)}</td><td>${esc(r.user_name)}</td><td><b>${esc(L(...(PAL[r.action]||[r.action,r.action])))}</b></td>
    <td>#${esc(r.pallet_no||'')}</td><td class="mono nw">${esc(r.lot_no||'')}</td><td>${esc(r.product_code||'')}</td><td>${esc(r.note||'')}</td></tr>`).join('')
   ||`<tr><td colspan="7" class="muted" style="padding:20px;text-align:center">${L('ไม่มีรายการ','Nothing here')}</td></tr>`}</tbody></table></div>
   ${PDD.rows.length>=3000?`<div class="muted">${L('แสดง 3000 รายการล่าสุด — ย่อช่วงวันที่','showing the latest 3000 — narrow the dates')}</div>`:''}`;
}
function pdCsv(){if(!PDD)return;csv(`slip-audit_${PDF.d1}_${PDF.d2}.csv`,['Time','User','Action','Pallet','Lot','Product','Details'],
  PDD.rows.map(r=>[r.created_at,r.user_name,(PAL[r.action]||[r.action,r.action])[1],r.pallet_no,r.lot_no,r.product_code,r.note]));}

/* ---------- lists (machines, lines) ---------- */
async function pgLists(){
  await loadLists();
  const box=(k,t)=>`<div class="card" style="flex:1 1 320px"><h2>${t}</h2>${(LISTS.all||[]).filter(r=>r.kind===k).map(r=>`<div style="display:flex;justify-content:space-between;padding:6px 0;border-top:1px solid var(--soft)"><span style="${r.active?'':'text-decoration:line-through;color:#94A3B8'}">${esc(r.name)}</span>
    <button class="btn" style="min-height:30px;padding:2px 10px" onclick='lsSet("${k}",${JSON.stringify(r.name)},${r.active?0:1})'>${r.active?L('ปิด','Disable'):L('เปิด','Enable')}</button></div>`).join('')}
    <div style="display:flex;gap:8px;margin-top:10px"><input class="in" id="ls-${k}" placeholder="${L('ชื่อ','Name')}"><button class="btn pri" onclick="lsSet('${k}',$('#ls-${k}').value,1)">+</button></div></div>`;
  $('#app').innerHTML=`<h1>${L('รายการตัวเลือก','Lists')}</h1><p class="sub">${L('ตัวเลือกบนใบพาเลท','choices on the pallet slip')}</p>
   <div style="display:flex;flex-wrap:wrap;gap:14px">${box('machine',L('เครื่องแพค','Packing machines'))}${box('line',L('ไลน์ผลิต','Production lines'))}</div>`;
}
async function lsSet(kind,name,active){if(!(name||'').trim())return;try{await post('/api/fg/lists',{kind,name,active:!!active});pgLists();}catch(e){alert(e.message);}}

/* ════════ Masters ════════ */
async function pgProd(){
  $('#app').innerHTML=`<h1>${L('สินค้า','Products')}</h1><p class="sub">${L('น้ำหนักต่อหน่วยใช้คำนวณ kg · เจ้าของ (Owner) แบ่งกลุ่ม Brand / B2B (OEM) / BB','Weight per unit drives kg · Owner sets the group Brand / B2B (OEM) / BB')}</p>
   <div class="bar"><input class="in" id="prq" placeholder="${L('ค้นหา รหัส / ชื่อ','search code / name')}" style="min-width:260px" onkeydown="if(event.key==='Enter')prLoad()"><button class="btn pri" onclick="prLoad()">${L('ค้นหา','Search')}</button>
    <button class="btn" onclick="prEdit()">+ ${L('เพิ่มสินค้า','Add product')}</button></div><div id="prBody"></div>`;
  ta($('#prq'),taSrv('product'),()=>prLoad());
  prLoad();
}
let PRS=[],PTYPES=[];
async function prLoad(){
  const u='/api/fg/products?q='+encodeURIComponent($('#prq').value.trim());loading($('#prBody'),u);
  let d;try{d=await apiC(u,prLoad);}catch(e){$('#prBody').innerHTML=err(e);return;}
  PRS=d.rows;PTYPES=d.types;
  $('#prBody').innerHTML='<div id="prT"></div>';
  xTable($('#prT'),'prod',[XC('code',L('รหัส','Code'),{cls:'mono nw'}),XC('name',L('ชื่อ','Name')),XC('type_id',L('ชนิด','Type')),XC('packaging',L('บรรจุภัณฑ์','Packaging')),
   XC('weight','kg/'+L('หน่วย','unit'),{r:1,num:1,fmt:p=>n0(p.weight)}),XC('shelf_life_days',L('อายุ (วัน)','Shelf life d'),{r:1,num:1,fmt:p=>p.shelf_life_days||'-'}),
   XC('owner','Owner'),XC('active',L('ใช้งาน','Active'),{val:p=>p.active?'✓':'—'}),
   XC('_e','',{nf:1,fmt:p=>`<button class="btn sm" onclick='prEdit(${JSON.stringify(p.code)})'>${L('แก้ไข','Edit')}</button>`})],PRS,{maxH:'calc(100vh - 250px)'});
}
function prEdit(code){
  const i=code==null?null:code;
  const p=i==null?{code:'',name:'',type_id:'',packaging:'',weight:0,shelf_life_days:0,owner:'',active:1}:PRS.find(x=>x.code===code);
  const f=(id,lab,v,t)=>`<label class="f">${lab}<input class="in" id="${id}" type="${t||'text'}" value="${esc(v)}"></label>`;
  dlg(`<h2>${i==null?L('เพิ่มสินค้า','Add product'):esc(p.code)}</h2><div style="display:grid;gap:10px">
   ${i==null?f('peC',L('รหัส','Code'),''):''}${f('peN',L('ชื่อ','Name'),p.name)}
   <label class="f">${L('ชนิด','Type')}<select class="in" id="peT">${PTYPES.map(t=>`<option value="${esc(t.code)}" ${t.code===p.type_id?'selected':''}>${esc(t.code)} · ${esc(t.name)}</option>`).join('')}</select></label>
   ${f('peP',L('บรรจุภัณฑ์','Packaging'),p.packaging)}${f('peW','kg / '+L('หน่วย','unit'),p.weight,'number')}${f('peS',L('อายุสินค้า (วัน)','Shelf life (days)'),p.shelf_life_days,'number')}
   ${f('peO','Owner (Brand / OEM / BB…)',p.owner)}<label><input type="checkbox" id="peA" ${p.active?'checked':''}> ${L('ใช้งาน','Active')}</label>
   <div id="peE"></div><div class="btns" style="justify-content:flex-end"><button class="btn" onclick="closeDlg()">${L('ยกเลิก','Cancel')}</button><button class="btn pri" onclick="prSave('${esc(p.code)}')">${L('บันทึก','Save')}</button></div></div>`);
}
async function prSave(code){
  const b={code:code||$('#peC').value.trim(),name:$('#peN').value,type_id:$('#peT').value,packaging:$('#peP').value,weight:+$('#peW').value||0,shelf_life_days:+$('#peS').value||0,owner:$('#peO').value,active:$('#peA').checked};
  try{await post('/api/fg/products',b);closeDlg();prLoad();}catch(e){$('#peE').innerHTML=err(e);}
}
async function pgCust(){
  let d;try{d=await api('/api/fg/customers');}catch(e){$('#app').innerHTML=err(e);return;}
  $('#app').innerHTML=`<h1>${L('ลูกค้า','Customers')}</h1><p class="sub">${d.rows.length} ${L('ราย','customers')}</p>
   <div class="bar"><input class="in" id="cuC" placeholder="${L('รหัส','Code')}" style="width:120px"><input class="in" id="cuN" placeholder="${L('ชื่อ','Name')}" style="min-width:260px"><button class="btn pri" onclick="cuSave()">${L('เพิ่ม / แก้ไข','Add / update')}</button></div>
<div id="cuT"></div>`;
  xTable($('#cuT'),'cust',[XC('code',L('รหัส','Code'),{cls:'mono'}),XC('name',L('ชื่อ','Name')),XC('active',L('ใช้งาน','Active'),{val:c=>c.active?'✓':'—'})],d.rows,
   {onRow:c=>{$('#cuC').value=c.code;$('#cuN').value=c.name;},maxH:'calc(100vh - 250px)'});
  ta($('#cuC'),q=>{q=q.toLowerCase();return d.rows.filter(c=>(c.code+' '+c.name).toLowerCase().includes(q)).slice(0,12).map(c=>({v:c.code,t:c.code,s:c.name}));},it=>{const c=d.rows.find(x=>x.code===it.v);if(c)$('#cuN').value=c.name;});
}
async function cuSave(){try{await post('/api/fg/customers',{code:$('#cuC').value.trim(),name:$('#cuN').value.trim()});pgCust();}catch(e){alert(e.message);}}
async function pgPeople(){
  let d;try{d=await api('/api/fg/people');}catch(e){$('#app').innerHTML=err(e);return;}
  const box=(k,t)=>`<div class="card" style="flex:1 1 300px"><h2>${t}</h2>${d.rows.filter(r=>r.kind===k).map(r=>`<div style="display:flex;justify-content:space-between;padding:6px 0;border-top:1px solid var(--soft)"><span style="${r.active?'':'text-decoration:line-through;color:#94A3B8'}">${esc(r.name)}</span>
    <button class="btn" style="min-height:30px;padding:2px 10px" onclick='peSet("${k}",${JSON.stringify(r.name)},${r.active?0:1})'>${r.active?L('ปิด','Disable'):L('เปิด','Enable')}</button></div>`).join('')}
    <div style="display:flex;gap:8px;margin-top:10px"><input class="in" id="pe-${k}" placeholder="${L('ชื่อ','Name')}"><button class="btn pri" onclick="peSet('${k}',$('#pe-${k}').value,1)">+</button></div></div>`;
  $('#app').innerHTML=`<h1>${L('ผู้ตรวจสอบ / หัวหน้ากะ','Checkers & shift leaders')}</h1><p class="sub">${L('รายชื่อให้เลือกตอนยืนยันบน PC','names to pick from when confirming on the PC')}</p>
   <div style="display:flex;flex-wrap:wrap;gap:14px">${box('checker',L('ผู้ตรวจสอบ (Checker)','Checkers'))}${box('leader',L('หัวหน้ากะ','Shift leaders'))}</div>`;
}
async function peSet(kind,name,active){if(!(name||'').trim())return;try{await post('/api/fg/people',{kind,name,active:!!active});pgPeople();}catch(e){alert(e.message);}}

/* ════════ Users ════════ */
/* ════════ b499: Import Access database (admin, while the FG team is still on Access) ════════ */
async function pgAccImp(){
  $('#app').innerHTML=`<h1>${L('นำเข้าฐานข้อมูล Access','Import Access database')}</h1>
   <p class="sub">${L('อัปโหลดไฟล์ Access ของทีม FG เพื่อดึงข้อมูลใหม่เข้าระบบ — เพิ่มเฉพาะรายการที่ยังไม่มี (ตาม Access ID) ไม่ลบหรือแก้ของเดิม',
     'Upload the FG team\'s Access file to pull new rows in — only rows with new Access IDs are added; nothing existing is changed or deleted')}</p>
   <div class="card" style="max-width:760px">
    <ol style="margin:0 0 12px 18px;padding:0;line-height:1.8">
     <li>${L('เลือกไฟล์ Stock_FinishedGoods New.accdb (หรือ .mdb)','Choose Stock_FinishedGoods New.accdb (or .mdb)')}</li>
     <li>${L('หรือไฟล์ .zip ที่มีตาราง Access ส่งออกเป็น CSV (tbl_Product.csv, tbl_Receive_Product.csv …)','or a .zip of the Access tables exported as CSV (tbl_Product.csv, tbl_Receive_Product.csv …)')}</li>
     <li>${L('กด อัปโหลดและนำเข้า — ใช้เวลาประมาณ 1 นาที','Press Upload & import — takes about a minute')}</li></ol>
    <div class="bar" style="align-items:center">
     <input type="file" id="accF" accept=".accdb,.mdb,.zip" class="in" style="flex:1;min-width:260px">
     <button class="btn pri" id="accB" onclick="accUpload()">⬆ ${L('อัปโหลดและนำเข้า','Upload & import')}</button></div>
    <div class="muted" style="font-size:12.5px;margin-top:8px">${L('ไฟล์ .accdb ต้องการ Microsoft Access Database Engine บนเครื่องเซิร์ฟเวอร์ ถ้าอ่านไม่ได้ให้ใช้ .zip ของ CSV แทน',
      'An .accdb needs the Microsoft Access Database Engine on the server PC; if it cannot be read, upload a .zip of CSV exports instead')}</div>
    <div id="accR" style="margin-top:12px"></div></div>`;
}
async function accUpload(){
  const f=$('#accF').files&&$('#accF').files[0],R=$('#accR'),b=$('#accB');
  if(!f)return alert(L('เลือกไฟล์ก่อน','Choose a file first'));
  if(!confirm(L(`นำเข้า “${f.name}” เข้าโรงงาน ${ME.factory_code||''}?`,`Import “${f.name}” into plant ${ME.factory_code||''}?`)))return;
  b.disabled=true;b.textContent=L('กำลังนำเข้า…','Importing…');
  R.innerHTML=`<div class="msg">${L('กำลังอัปโหลด','Uploading')} ${(f.size/1048576).toFixed(1)} MB …</div>`;
  try{
    const r=await fetch('/api/fg/import-accdb?name='+encodeURIComponent(f.name),{method:'POST',body:await f.arrayBuffer(),
      headers:{'Content-Type':'application/octet-stream'},credentials:'same-origin'});
    const d=await r.json().catch(()=>({}));
    if(!r.ok)throw new Error((d.detail&&d.detail.msg)||d.detail||('HTTP '+r.status));
    R.innerHTML=`<div class="msg m-ok"><b>${L('นำเข้าแล้ว','Imported')}</b><br>${L('เพิ่ม','Added')}: ${Object.entries(d.added||{}).map(([k,v])=>esc(k)+' +'+n0(v)).join(' · ')}
      <br><span class="muted">${L('อ่านจากไฟล์','Read from file')}: ${Object.entries(d.read||{}).map(([k,v])=>esc(k)+' '+n0(v)).join(' · ')}</span></div>`;
  }catch(e){R.innerHTML=`<div class="msg m-bad">${esc(e.message||e)}</div>`;}
  b.disabled=false;b.textContent='⬆ '+L('อัปโหลดและนำเข้า','Upload & import');
}
async function pgUsers(){
  let d;try{d=await api('/api/fg/users');}catch(e){$('#app').innerHTML=err(e);return;}
  const rl=r=>r?L(ROLE[r][0],ROLE[r][1]):'—';
  $('#app').innerHTML=`<h1>${L('ผู้ใช้งาน FG','FG users & roles')}</h1><p class="sub">${L('บัญชีเดียวกับ CMMS · “เฉพาะ FG” = เข้าแอป FG ทันทีหลังล็อกอิน','Same accounts as the CMMS · “FG only” = goes straight to this app after sign-in')}</p>
   <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-bottom:16px">${Object.keys(ROLE).map(k=>`<div style="background:#fff;border:1px solid var(--line);border-radius:10px;padding:10px 14px"><div style="display:flex;align-items:center;gap:8px;font-weight:600"><i style="width:10px;height:10px;border-radius:5px;background:${ROLE[k][2]};display:inline-block"></i>${esc(rl(k))}</div><div class="muted" style="margin-top:2px">${esc({admin:L('ผู้ใช้ สินค้า ลูกค้า ทุกหน้า','users, masters, every page'),packing:L('PC แพคกิ้ง: ทำใบพาเลท QR พิมพ์ A6','packing PC: make + print A6 QR slips'),packcheck:L('PC / มือถือ: สแกน QR ใบพาเลท → ตรวจ → อนุมัติ','PC (USB scanner) or phone: scan slip QR → verify → approve'),receiver:L('มือถือ: สแกน → เช็คลิสต์ → อนุมัติ/ไม่อนุมัติ','phone: scan → checklist → approve/reject'),issuer:L('มือถือ: สแกน → จ่ายออก','phone: scan → issue'),checker:L('PC: ยืนยันลงสต็อก รายงาน','PC: confirm to stock, reports')}[k])}</div></div>`).join('')}</div>
   <div class="card" style="margin-bottom:14px"><h2>${L('เพิ่มผู้ใช้ FG ใหม่ (เฉพาะ FG)','New FG-only login')}</h2><div class="bar" style="border:0;padding:0;margin:0">
    <label class="f">Username<input class="in" id="nuU"></label><label class="f">${L('ชื่อ','Name')}<input class="in" id="nuN"></label><label class="f">${L('รหัสผ่าน','Password')}<input class="in" id="nuP" type="password"></label>
    <div style="display:flex;flex-direction:column;gap:4px"><span style="font-size:12.5px;font-weight:500;color:#475569">${L('งาน','Functions')}</span><div style="display:flex;flex-wrap:wrap;gap:6px">${FNR.map(r=>`<label style="display:flex;gap:6px;align-items:center;border:1px solid #CBD5E1;border-radius:8px;height:40px;padding:0 10px;font-size:13.5px;cursor:pointer"><input type="checkbox" class="nuR" value="${r}" style="width:16px;height:16px"> ${esc(rl(r))}</label>`).join('')}</div></div>
    <button class="btn pri" onclick="nuAdd()">${L('เพิ่ม','Add')}</button></div><div id="nuE"></div></div>
   <p class="muted" style="margin:0 0 8px">${L('ติ๊กได้หลายงาน · ★ = เปิดก่อนหลังล็อกอิน · คนที่มีมากกว่า 1 งานสลับงานได้ที่ปุ่ม แอป (▦)','Tick several functions · ★ = opens first after login · people with 2+ functions switch with the Apps (▦) button')}</p>
   <div class="tw"><table><thead><tr><th>Username</th><th>${L('ชื่อ','Name')}</th><th>${L('สิทธิ์ CMMS','CMMS role')}</th>${FNR.map(r=>`<th style="text-align:center">${esc(rl(r))}</th>`).join('')}<th>${L('เปิดก่อน ★','Opens first ★')}</th><th style="text-align:center">${L('เฉพาะ FG','FG only')}</th></tr></thead><tbody>
   ${d.users.map(u=>{const rs=(u.fg_roles||u.fg_role||'').split(',').filter(Boolean);
     if(u.role==='admin')return `<tr><td class="mono">${esc(u.username)}</td><td>${esc(u.name)}</td><td class="muted">admin</td><td colspan="${FNR.length+2}"><b>${L('ผู้ดูแล — ทุกงาน','Admin — every function')}</b></td></tr>`;
     const opts=(u.fg_only?[]:['cmms']).concat(rs);
     return `<tr id="ur-${u.id}"><td class="mono">${esc(u.username)}</td><td>${esc(u.name)}</td><td class="muted">${esc(u.role)}</td>
      ${FNR.map(r=>`<td style="text-align:center"><input type="checkbox" class="ufr" value="${r}" ${rs.includes(r)?'checked':''} onchange="usSave(${u.id})" aria-label="${esc(r)}" style="width:17px;height:17px"></td>`).join('')}
      <td><select class="in sm ufd" style="width:150px" onchange="usSave(${u.id})">${opts.map(o=>`<option value="${o}" ${(u.fg_default||'cmms')===o?'selected':''}>${o==='cmms'?'CMMS':esc(rl(o))}</option>`).join('')}</select></td>
      <td style="text-align:center"><input type="checkbox" class="ufo" ${u.fg_only?'checked':''} onchange="usSave(${u.id})" aria-label="FG only" style="width:17px;height:17px"></td></tr>`;}).join('')}</tbody></table></div>`;
}
const FNR=['packing','packcheck','receiver','issuer','checker'];
async function usSave(id){
  const tr=$('#ur-'+id),rs=[...tr.querySelectorAll('.ufr:checked')].map(x=>x.value);
  try{await post('/api/fg/users/'+id,{fg_roles:rs,fg_default:tr.querySelector('.ufd').value,fg_only:tr.querySelector('.ufo').checked});pgUsers();}catch(e){alert(e.message);}
}
async function nuAdd(){
  const rs=[...document.querySelectorAll('.nuR:checked')].map(x=>x.value);
  try{await post('/api/fg/users',{username:$('#nuU').value.trim(),name:$('#nuN').value.trim(),password:$('#nuP').value,fg_roles:rs});pgUsers();}catch(e){$('#nuE').innerHTML=err(e);}
}

/* ════════ Start ════════ */
function hdr(){
  $('#langBtn').textContent=TH()?'EN':'ไทย';
  if(!ME)return;
  $('#fac').textContent=ME.factory_code;$('#who').innerHTML=esc(ME.name);
  const r=null;const c=$('#rchip');
  if(r){c.textContent=L(r[0],r[1]);c.style.background=r[2];c.classList.remove('hidden');}
  // b473: no switch bar — Apps button opens the function tiles when the person has 2+
  $('#appsBtn').classList.toggle('hidden',FnBar.list(ME).length<2);
}
async function start(){
  try{ME=await api('/api/fg/me');}
  catch(e){if(e.status===401){location.href='/';return;}
    hdr();$('#app').innerHTML=`<div class="card" style="max-width:520px;margin:40px auto"><h1>${L('ยังไม่มีสิทธิ์ใช้ FG Stock','No FG Stock access yet')}</h1><p>${esc(e.message)}</p><button class="btn" onclick="location.href='/?fn=cmms'">CMMS</button></div>`;return;}
  FN=FnBar.current(ME);
  if(FN==='cmms'){location.href='/?fn=cmms';return;}
  await refreshCounts();hdr();buildNav();
  const start=(location.hash||'').slice(1)||fnStart();
  go(start,true);
  setInterval(()=>{if(PAGE==='queue'&&!Object.values(QSEL).some(Boolean)&&!$('#dlg'))qLoad();else refreshCounts();},30000);
}
function fnStart(){return FN==='checker'?(isAdmin()?'home':'queue'):(fnPages()[0]||'home');}
function switchFn(f){
  FN=f;try{sessionStorage.setItem('bflfp_fn',f)}catch(e){}
  history.replaceState(null,'','/fg.html?fn='+f);
  hdr();buildNav();go(fnStart());
}
window.addEventListener('hashchange',()=>{const p=(location.hash||'#home').slice(1);if(p!==PAGE&&ME)go(p,true);});
start();
</script>
</body>
</html>
