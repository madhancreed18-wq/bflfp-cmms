# ---------------------------------------------------------------- packing (stand-in)
@router.get("/packing")
async def packing_list(req: Request, status: str = "", q: str = ""):
    u, fac, _ = ctx(req, "check")
    conds, args = ["factory_id=?"], [fac]
    if status:
        conds.append("status=?")
        args.append(status)
    if q:
        conds.append("(lot_no LIKE ? OR product_code LIKE ? OR product_name LIKE ?)")
        args += ["%" + q + "%"] * 3
    with closing(conn()) as c:
        _assign_codes(c)
        c.commit()
        rows = [dict(r) for r in c.execute(
            f"SELECT * FROM fg_packing WHERE {' AND '.join(conds)} ORDER BY id DESC LIMIT 500", tuple(args))]
    return {"rows": rows}


@router.post("/packing")
async def packing_add(req: Request):
    """Admin: key a packing record by hand (for testing until the packing DB is linked).
    Returns the slip QR text so a test label can be printed."""
    u, fac, _ = ctx(req, "master")
    b = await req.json()
    lot, pal, code = (b.get("lot_no") or "").strip(), str(b.get("pallet_no") or "").strip(), (b.get("product_code") or "").strip()
    if not lot or not pal or not code:
        raise HTTPException(400, {"msg": "lot, pallet and product are required"})
    with closing(conn()) as c:
        p = _product(c, fac, code)
        if not p:
            raise HTTPException(400, {"msg": "ไม่พบรหัสสินค้า (unknown product code)"})
        qr = json.dumps({"Product_code": code, "Product_Name": p["name"], "Lot_No": lot, "No": str(int(_num(b.get("qty")))),
                         "weight": _n(p["weight"]) + " kg", "Station": b.get("station") or "", "Pallet": pal,
                         "Operator": b.get("operator") or ""}, ensure_ascii=False)
        slip = parse_qr(qr)
        if c.execute("SELECT 1 FROM fg_packing WHERE factory_id=? AND pkey=?", (fac, slip["pkey"])).fetchone():
            raise HTTPException(409, {"msg": "มีพาเลทนี้แล้ว (this lot + pallet already exists)"})
        pk = packing_lookup(c, fac, slip, _who(u))
        c.execute("UPDATE fg_packing SET src='manual' WHERE id=?", (pk["id"],))
        c.commit()
    sc = c2 = None
    with closing(conn()) as c2:
        _assign_codes(c2)
        c2.commit()
        sc = (c2.execute("SELECT scode FROM fg_packing WHERE id=?", (pk["id"],)).fetchone() or {"scode": ""})["scode"]
    return {"ok": True, "id": pk["id"], "qr": sc or qr, "qr_full": qr}



# ================================================================ packing room: A6 QR pallet slips
def bag_kg(text):
    """'20' -> 20 ; '1*20' -> 20 (1 kg x 20 packs in one bag) — same rule as the old app."""
    t = str(text or "").replace("x", "*").replace("X", "*")
    if "*" in t:
        a, _, b = t.partition("*")
        return _num(a) * _num(b)
    return _num(t)


def slip_qr(pk):
    """The text inside the slip QR. Same keys the FG receiver (and the WMS app) already read."""
    return json.dumps({"Id": pk["id"], "Product_code": pk["product_code"], "Product_Name": pk["product_name"],
                       "Lot_No": pk["lot_no"], "Pallet": str(pk["pallet_no"]), "No": _n(pk["qty"]),
                       "weight": _n(pk["weight_unit"]) + " kg", "MFG": pk.get("mfg", ""), "EXP": pk.get("exp", ""),
                       "Station": pk.get("pack_machine") or pk.get("station", ""), "Operator": pk.get("operator", ""),
                       **({"Run": int(pk["lot_run"])} if (pk.get("lot_run") or 1) > 1 else {}),
                       **({"EXP_note": pk["exp_sfx"]} if pk.get("exp_sfx") else {})},
                      ensure_ascii=False, separators=(",", ":"))


def _slip_out(r):
    d = dict(r)
    d["qr_full"] = slip_qr(d)          # the long JSON — kept as the reference
    d["code"] = d.get("scode") or ""
    d["qr"] = d["code"]                 # what is printed in the QR (fast to scan)
    return d


def _lot_run(c, fac, product, lot):
    """Current run of a lot + its status ('open' / 'paused' / 'closed')."""
    r = c.execute("SELECT run,status,last_slip,finished_at,finished_by FROM fg_lot WHERE factory_id=? AND product_code=? AND lot_no=? ORDER BY run DESC LIMIT 1",
                  (fac, product, lot)).fetchone()
    return dict(r) if r else {"run": 1, "status": "open", "last_slip": 0, "finished_at": "", "finished_by": ""}


def _next_slip(c, fac, product, lot, run=None):
    if run is None:
        run = _lot_run(c, fac, product, lot)["run"]
    w = "factory_id=? AND product_code=? AND lot_no=? AND COALESCE(lot_run,1)=?"
    r = c.execute(f"SELECT MAX(slip_no) m FROM fg_packing WHERE {w}", (fac, product, lot, run)).fetchone()
    m = r["m"] if r and r["m"] else 0
    # pallets that came in by QR only (no slip_no) still hold their pallet numbers
    for x in c.execute(f"SELECT pallet_no FROM fg_packing WHERE {w}", (fac, product, lot, run)):
        try:
            m = max(m, int(x["pallet_no"]))
        except (TypeError, ValueError):
            pass
    return m + 1


def _slip_form_code():
    from .config import SLIP_FORM_CODE
    return SLIP_FORM_CODE


def _slip_fields(c, fac, b):
    code = (b.get("product_code") or "").strip()
    lot = (b.get("lot_no") or "").strip().upper()
    p = _product(c, fac, code)
    if not p:
        raise HTTPException(400, {"msg": "ไม่พบรหัสสินค้า (unknown product code) — add it in Products first"})
    if not lot:
        raise HTTPException(400, {"msg": "ใส่เลขล็อต (lot number required)"})
    bags = _num(b.get("bags"))
    if bags <= 0:
        raise HTTPException(400, {"msg": "ใส่จำนวนถุง (total bags required)"})
    bw = (str(b.get("bag_weight") or "").strip()) or _n(p.get("weight"))
    wu = bag_kg(bw)
    if wu <= 0:
        raise HTTPException(400, {"msg": "น้ำหนักต่อถุงไม่ถูกต้อง (bad bag weight)"})
    mfg = (b.get("mfg") or "").strip() or mfg_from_lot(lot)
    exp = (b.get("exp") or "").strip() or exp_for(mfg, p.get("shelf_life_days"))
    for d in (mfg, exp):
        if d:
            try:
                datetime.date.fromisoformat(d)
            except ValueError:
                raise HTTPException(400, {"msg": f"วันที่ไม่ถูกต้อง (bad date) {d}"})
    if not exp:
        raise HTTPException(400, {"msg": "ใส่วันหมดอายุ (expiry date required — no shelf life set for this product)"})
    pt = b.get("pack_type") or PACK_TYPES[0]
    return {"product_code": code, "product_name": p["name"], "packaging": p.get("packaging", ""), "lot_no": lot,
            "qty": bags, "unit": "กระสอบ", "weight_unit": wu, "bag_weight": bw, "total_weight": wu * bags,
            "mfg": mfg, "exp": exp, "exp_sfx": "B." if (b.get("exp_sfx") or "").strip().upper() in ("B", "B.") else "",
            "exp_fmt": b.get("exp_fmt") if b.get("exp_fmt") in ("dd/mm/yy", "dd/mm/yyyy", "yy/mm/dd", "mm/yyyy", "yyyy/mm/dd", "dd mm yyyy") else "",
            "doc_no": _slip_form_code(),   # b503: fixed Document Control number, not typed
            "pack_machine": (b.get("pack_machine") or "").strip()[:60], "pd_line": (b.get("pd_line") or "").strip()[:60],
            "pack_type": pt if pt in PACK_TYPES else PACK_TYPES[0], "staff_name": (b.get("staff_name") or "").strip()[:60]}


@router.get("/lists")
async def lists(req: Request):
    u, fac, _ = ctx(req, "view")
    with closing(conn()) as c:
        rows = [dict(r) for r in c.execute(
            "SELECT * FROM fg_lists WHERE factory_id IN (0,?) ORDER BY kind, sort, name", (fac,))]
    return {"rows": rows, "pack_types": PACK_TYPES}


@router.post("/lists")
async def list_save(req: Request):
    u, fac, _ = ctx(req, "master")
    b = await req.json()
    kind, name = b.get("kind"), (b.get("name") or "").strip()
    if kind not in DEFAULT_LISTS or not name:
        raise HTTPException(400, {"msg": "kind and name required"})
    with closing(conn()) as c:
        r = c.execute("SELECT id FROM fg_lists WHERE factory_id IN (0,?) AND kind=? AND name=?", (fac, kind, name)).fetchone()
        if r:
            c.execute("UPDATE fg_lists SET active=? WHERE id=?", (1 if b.get("active", True) else 0, r["id"]))
        else:
            n = c.execute("SELECT COALESCE(MAX(sort),0)+1 FROM fg_lists WHERE kind=?", (kind,)).fetchone()[0]
            c.execute("INSERT INTO fg_lists(factory_id,kind,name,sort,active) VALUES(?,?,?,?,1)", (fac, kind, name, n))
        c.commit()
    return {"ok": True}


@router.get("/slips-next")
async def slip_next(req: Request, product: str = "", lot: str = ""):
    """Next pallet / slip number for this product + lot (shown on the form before saving)."""
    u, fac, _ = ctx(req, "pack")
    with closing(conn()) as c:
        if not (product and lot):
            return {"next": 1, "run": 1, "status": "open"}
        p, l = product.strip(), lot.strip().upper()
        st = _lot_run(c, fac, p, l)
        return dict(st, next=_next_slip(c, fac, p, l, st["run"]), machines=_lot_machines(c, fac, p, l, st["run"]))


@router.post("/slips")
async def slip_new(req: Request):
    """Packing: save one or more pallet slips (copies = pallets of the same lot) — returns them
    with their QR text for printing. Slip numbers run per product + lot: 1, 2, 3 …"""
    u, fac, _ = ctx(req, "pack")
    b = await req.json()
    copies = max(1, min(int(_num(b.get("copies") or 1)), 50))
    who = _who(u)
    out = []
    with closing(conn()) as c:
        f = _slip_fields(c, fac, b)
        f["staff_name"] = f["staff_name"] or who
        st = _lot_run(c, fac, f["product_code"], f["lot_no"])
        run = st["run"]
        if st["status"] == "closed":
            raise HTTPException(409, {"msg": "lot_closed", "last_slip": st["last_slip"], "run": run})
        if st["status"] == "paused":
            c.execute("UPDATE fg_lot SET status='open' WHERE factory_id=? AND product_code=? AND lot_no=? AND run=?",
                      (fac, f["product_code"], f["lot_no"], run))
        # this machine is packing the lot (again) -> no longer "finished"
        c.execute("DELETE FROM fg_lot_mc WHERE factory_id=? AND product_code=? AND lot_no=? AND run=? AND machine=?",
                  (fac, f["product_code"], f["lot_no"], run, f["pack_machine"]))
        for _ in range(copies):
            sn = _next_slip(c, fac, f["product_code"], f["lot_no"], run)
            t = now()
            pid = c.insert_id("""INSERT INTO fg_packing(factory_id,pkey,lot_no,pallet_no,slip_no,product_code,product_name,
                packaging,qty,unit,weight_unit,bag_weight,total_weight,mfg,exp,doc_no,pack_machine,pd_line,pack_type,
                station,operator,staff_name,raw_qr,packed_at,src,status,status_at,pc_status,created_by,lot_run)
                VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,'',?,'slip','packed',?,'pending',?,?)""",
                (fac, pkey_of(f["product_code"], f["lot_no"], sn, run), f["lot_no"], str(sn), sn, f["product_code"],
                 f["product_name"], f["packaging"], f["qty"], f["unit"], f["weight_unit"], f["bag_weight"],
                 f["total_weight"], f["mfg"], f["exp"], f["doc_no"], f["pack_machine"], f["pd_line"], f["pack_type"],
                 f["pack_machine"], f["staff_name"], f["staff_name"], t, t, who, run))
            c.execute("UPDATE fg_packing SET exp_sfx=?,exp_fmt=? WHERE id=?", (f["exp_sfx"], f["exp_fmt"], pid))   # b538/b539: "B." + date format
            r = c.execute("SELECT * FROM fg_packing WHERE id=?", (pid,)).fetchone()
            c.execute("UPDATE fg_packing SET raw_qr=? WHERE id=?", (slip_qr(dict(r)), pid))
            _assign_codes(c)
            _log(c, fac, "packing", pid, "slip_created", f'{f["lot_no"]} #{sn}' + (f" (run {run})" if run > 1 else ""), who)
            out.append(_slip_out(c.execute("SELECT * FROM fg_packing WHERE id=?", (pid,)).fetchone()))
        c.commit()
    return {"ok": True, "slips": out}


# ---------------------------------------------------------------- Access history -> QR slips (b488)
_NW_RE = re.compile(r"MFG\s*(\d{1,2})\D(\d{1,2})\D(\d{4}).*?EXP\s*(\d{1,2})\D(\d{1,2})\D(\d{4})", re.S | re.I)


def _nw_dates(nw):
    """Access 'Net weight' text: 'MFG 14 10 2026\r\nEXP 14 10 2028 B' -> ('2026-10-14', '2028-10-14')."""
    m = _NW_RE.search(nw or "")
    if not m:
        return "", ""
    try:
        a = datetime.date(int(m.group(3)), int(m.group(2)), int(m.group(1))).isoformat()
        b = datetime.date(int(m.group(6)), int(m.group(5)), int(m.group(4))).isoformat()
        return a, b
    except ValueError:
        return "", ""


def access_to_slips(c, fac, who):
    """One QR pallet slip per pallet received in the old Access system. The slips are packing-approved
    and 'moved to FG' (the Access history counts as approved); the receive row is linked to its slip
    (pkey / pallet_no / packing_id), so scanning it shows the received record and the loader can load
    that pallet. Pallets are numbered 1, 2, 3 … per product + lot in receive order, after any slip
    numbers that lot already has. Stock does not change. Safe to run again: only unlinked rows."""
    rows = c.execute("""SELECT * FROM fg_receive WHERE factory_id=? AND src='access' AND COALESCE(packing_id,0)=0
                        ORDER BY product_id, lot_no, receive_date, receive_time, id""", (fac,)).fetchall()
    prods = {r["code"]: dict(r) for r in c.execute("SELECT code,name,packaging,weight,shelf_life_days FROM fg_products WHERE factory_id=?", (fac,))}
    nxt, made, t = {}, 0, now()
    for r in rows:
        r = dict(r)
        key = (r["product_id"], r["lot_no"])
        if key not in nxt:
            m = c.execute("SELECT MAX(CAST(pallet_no AS INTEGER)) m, MAX(slip_no) s FROM fg_packing WHERE factory_id=? AND product_code=? AND lot_no=?",
                          (fac, key[0], key[1])).fetchone()
            nxt[key] = max(int(m["m"] or 0), int(m["s"] or 0))
        nxt[key] += 1
        pal = nxt[key]
        pkey = pkey_of(key[0], key[1], str(pal))
        while c.execute("SELECT 1 FROM fg_packing WHERE factory_id=? AND pkey=?", (fac, pkey)).fetchone():
            nxt[key] += 1
            pal = nxt[key]
            pkey = pkey_of(key[0], key[1], str(pal))
        p = prods.get(key[0]) or {}
        mfg, exp = (r.get("mfg") or "", r.get("exp") or "")
        if not mfg or not exp:
            a, b = _nw_dates(r.get("net_weight"))
            mfg, exp = mfg or a or mfg_from_lot(key[1]), exp or b or exp_for(mfg or a or mfg_from_lot(key[1]), p.get("shelf_life_days"))
        wu = _num(r.get("weight_unit")) or _num(p.get("weight"))
        at = (r.get("receive_date") or "")[:10] + " " + ((r.get("receive_time") or "")[:8] or "00:00")
        pid = c.insert_id("""INSERT INTO fg_packing(factory_id,pkey,lot_no,pallet_no,slip_no,product_code,product_name,packaging,qty,unit,
            weight_unit,bag_weight,total_weight,mfg,exp,station,operator,staff_name,raw_qr,packed_at,src,status,status_at,status_by,
            pc_status,pc_by,pc_at,pack_type,note,created_by)
            VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,'',?,?,'',?,'access','moved_to_fg',?,?,'approved','Access',?,'Finished Goods',?,?)""",
            (fac, pkey, key[1], str(pal), pal, key[0], r.get("product_name") or p.get("name", ""), r.get("packaging") or p.get("packaging", ""),
             _num(r["qty"]), r.get("unit") or "กระสอบ", wu, _n(wu), _num(r.get("total_kg")) or _num(r["qty"]) * wu, mfg, exp,
             r.get("receive_man") or "", r.get("receive_man") or "", at, t, who, at,
             "Access receive #" + str(r.get("access_id") or r["id"]), who))
        c.execute("UPDATE fg_receive SET pkey=?, pallet_no=?, packing_id=?, mfg=CASE WHEN mfg='' THEN ? ELSE mfg END, exp=CASE WHEN exp='' THEN ? ELSE exp END WHERE id=?",
                  (pkey, str(pal), pid, mfg, exp, r["id"]))
        _pk = c.execute("SELECT * FROM fg_packing WHERE id=?", (pid,)).fetchone()      # b503: a real QR, not a blank one
        if _pk:
            c.execute("UPDATE fg_packing SET raw_qr=? WHERE id=?", (slip_qr(dict(_pk)), pid))
        _log(c, fac, "packing", pid, "slip_from_access", f'{key[1]} #{pal} · Access receive {r.get("receive_date", "")[:10]}', who)
        made += 1
    return made


@router.get("/access-slips")
async def access_slips_info(req: Request):
    u, fac, _ = ctx(req, "admin")
    with closing(conn()) as c:
        a = c.execute("SELECT COUNT(*) FROM fg_receive WHERE factory_id=? AND src='access' AND COALESCE(packing_id,0)=0", (fac,)).fetchone()[0]
        b = c.execute("SELECT COUNT(*) FROM fg_packing WHERE factory_id=? AND src='access'", (fac,)).fetchone()[0]
    return {"missing": a, "made": b}


@router.post("/access-slips")
async def access_slips_make(req: Request):
    import asyncio
    u, fac, _ = ctx(req, "admin")

    def run():
        with closing(conn()) as c:
            n = access_to_slips(c, fac, _who(u))
            c.commit()
            return n
    return {"ok": True, "made": await asyncio.to_thread(run)}


@router.get("/slips")
async def slip_list(req: Request, d1: str = "", d2: str = "", q: str = "", pc: str = "", status: str = "",
                    ids: str = "", limit: int = 500, datef: str = "", by: str = ""):
    u, fac, fr = ctx(req, "view")
    if not ({"pack", "check", "packcheck"} & can_set(roles_of(u))):
        raise HTTPException(403, {"msg": "ไม่มีสิทธิ์ (no permission)"})
    conds, args = ["factory_id=?"], [fac]
    if ids:
        idl = [int(x) for x in ids.split(",") if x.strip().isdigit()][:200]
        conds.append("id IN (" + ",".join("?" * len(idl)) + ")")
        args += idl
    else:
        dcol = "pc_at" if datef == "pc" else "packed_at"     # b497: approved list filters on approval time
        if d1 and (not status or datef):
            conds.append(dcol + ">=?")
            args.append(d1)
        if d2 and (not status or datef):
            conds.append(dcol + "<=?")
            args.append(d2 + " 23:59:59")
        if by:
            conds.append("pc_by=?")
            args.append(_who(u) if by == "me" else by)
        if pc:
            conds.append("pc_status=?")
            args.append(pc)
        if status:
            conds.append("status=?")
            args.append(status)
        if q:
            conds.append("(lot_no LIKE ? OR product_code LIKE ? OR product_name LIKE ? OR doc_no LIKE ?)")
            args += ["%" + q + "%"] * 4
    limit = max(1, min(int(limit or 500), 3000))
    with closing(conn()) as c:
        _assign_codes(c)
        c.commit()
        rows = [_slip_out(r) for r in c.execute(
            f"SELECT * FROM fg_packing WHERE {' AND '.join(conds)} ORDER BY {'pc_at' if datef == 'pc' else 'packed_at'} DESC, id DESC LIMIT {limit}", tuple(args))]
        cnt = {r["pc_status"]: r["n"] for r in c.execute(
            "SELECT pc_status, COUNT(*) n FROM fg_packing WHERE factory_id=? AND status='packed' GROUP BY pc_status", (fac,))}
        cnt["fg_rejected"] = c.execute("SELECT COUNT(*) FROM fg_packing WHERE factory_id=? AND status='rejected_by_fg'", (fac,)).fetchone()[0]
    return {"rows": rows, "counts": cnt}


@router.post("/slips/{sid}")
async def slip_edit(req: Request, sid: int):
    """Fix a slip before FG has received it. It goes back to the packing checker."""
    u, fac, _ = ctx(req, "pack")
    b = await req.json()
    who = _who(u)
    with closing(conn()) as c:
        r = c.execute("SELECT * FROM fg_packing WHERE id=? AND factory_id=?", (sid, fac)).fetchone()
        if not r:
            raise HTTPException(404, {"msg": "not found"})
        r = dict(r)
        if r["status"] not in ("packed", "rejected_by_fg"):
            raise HTTPException(409, {"msg": "แก้ไขไม่ได้ — FG รับไปแล้วหรือยกเลิกแล้ว (FG already has it, or it is cancelled)"})
        was_fg_reject = r["status"] == "rejected_by_fg"
        f = _slip_fields(c, fac, dict(b, product_code=b.get("product_code") or r["product_code"], lot_no=b.get("lot_no") or r["lot_no"]))
        sn = r["slip_no"] or r["pallet_no"]
        run = r.get("lot_run") or 1
        if (f["product_code"], f["lot_no"]) != (r["product_code"], r["lot_no"]):
            run = _lot_run(c, fac, f["product_code"], f["lot_no"])["run"]
            sn = _next_slip(c, fac, f["product_code"], f["lot_no"], run)
        c.execute("""UPDATE fg_packing SET lot_run=?,pkey=?,lot_no=?,pallet_no=?,slip_no=?,product_code=?,product_name=?,packaging=?,
            qty=?,weight_unit=?,bag_weight=?,total_weight=?,mfg=?,exp=?,doc_no=?,pack_machine=?,pd_line=?,pack_type=?,
            station=?,operator=?,staff_name=?,pc_status='pending',pc_by='',pc_at='',edited_by=?,edited_at=? WHERE id=?""",
            (run, pkey_of(f["product_code"], f["lot_no"], sn, run), f["lot_no"], str(sn), int(_num(sn)), f["product_code"],
             f["product_name"], f["packaging"], f["qty"], f["weight_unit"], f["bag_weight"], f["total_weight"], f["mfg"],
             f["exp"], f["doc_no"], f["pack_machine"], f["pd_line"], f["pack_type"], f["pack_machine"],
             f["staff_name"] or r["staff_name"], f["staff_name"] or r["staff_name"], who, now(), sid))
        if (f["product_code"], f["lot_no"], str(sn)) != (r["product_code"], r["lot_no"], str(r["slip_no"] or r["pallet_no"])):
            _assign_codes(c, [sid])          # lot / slip no. changed -> new code (old paper stops scanning)
        c.execute("UPDATE fg_packing SET exp_sfx=?,exp_fmt=? WHERE id=?", (f["exp_sfx"], f["exp_fmt"], sid))
        nr = dict(c.execute("SELECT * FROM fg_packing WHERE id=?", (sid,)).fetchone())
        c.execute("UPDATE fg_packing SET raw_qr=? WHERE id=?", (slip_qr(nr), sid))
        if was_fg_reject:
            c.execute("UPDATE fg_packing SET status='packed', status_at=?, status_by=?, fixed_at=? WHERE id=?", (now(), who, now(), sid))
        _log(c, fac, "packing", sid, "slip_fixed_after_fg_reject" if was_fg_reject else "slip_edited", "", who)
        c.commit()
        return {"ok": True, "slip": _slip_out(c.execute("SELECT * FROM fg_packing WHERE id=?", (sid,)).fetchone())}


def _ip(req):
    h = req.headers
    return (h.get("cf-connecting-ip") or (h.get("x-forwarded-for") or "").split(",")[0].strip()
            or (req.client.host if req.client else ""))[:60]


def _last_prints(c, fac, ids):
    """b497: {packing_id: {print_count, last_by, last_at}} for slips that were printed before."""
    out = {}
    for i in ids:
        r = c.execute("SELECT id,lot_no,pallet_no,product_code,product_name,COALESCE(print_count,0) n,printed_at FROM fg_packing WHERE id=? AND factory_id=?",
                      (i, fac)).fetchone()
        if not r or not r["n"]:
            continue
        l = c.execute("SELECT user_name,printed_at FROM fg_print_log WHERE factory_id=? AND packing_id=? ORDER BY id DESC LIMIT 1",
                      (fac, i)).fetchone()
        if not l:   # printed before b497: only fg_log knows who
            l = c.execute("SELECT user_name, created_at printed_at FROM fg_log WHERE factory_id=? AND kind='packing' AND ref_id=? AND action IN ('printed','reprinted') ORDER BY id DESC LIMIT 1",
                          (fac, i)).fetchone()
        out[i] = {"id": i, "lot_no": r["lot_no"], "pallet_no": r["pallet_no"], "product_code": r["product_code"],
                  "product_name": r["product_name"], "print_count": r["n"],
                  "last_by": (l["user_name"] if l else ""), "last_at": (l["printed_at"] if l else r["printed_at"] or "")}
    return out


@router.post("/slips-print-check")
async def slips_print_check(req: Request):
    """b497: asked before the print window opens — which of these slips were already printed (and by whom)."""
    u, fac, _ = ctx(req, "pack")
    b = await req.json()
    ids = [int(x) for x in (b.get("ids") or [])][:200]
    with closing(conn()) as c:
        return {"printed": list(_last_prints(c, fac, ids).values())}


@router.post("/slips-printed")
async def slips_printed(req: Request):
    """The print window opened for these slips. b497: one fg_print_log row per slip (copy no, user, ip);
    a second or later copy is a REPRINT and must carry a reason — written to the audit trail."""
    u, fac, _ = ctx(req, "pack")
    b = await req.json()
    ids = [int(x) for x in (b.get("ids") or [])][:200]
    reason = (b.get("reason") or "").strip()[:300]
    who, uid, ip, t = _who(u), int(u.get("id") or 0), _ip(req), now()
    with closing(conn()) as c:
        for i in ids:
            r = c.execute("SELECT COALESCE(print_count,0) n, src FROM fg_packing WHERE id=? AND factory_id=?", (i, fac)).fetchone()
            if not r or r["src"] == "access":      # b515: Access-made slips are not real pallets — never printed
                continue
            copy = int(r["n"] or 0) + 1
            re_ = copy > 1
            c.execute("UPDATE fg_packing SET print_count=?, printed_at=? WHERE id=? AND factory_id=?", (copy, t, i, fac))
            c.execute("""INSERT INTO fg_print_log(factory_id,packing_id,copy_no,reprint,reason,user_id,user_name,ip,printed_at)
                         VALUES(?,?,?,?,?,?,?,?,?)""", (fac, i, copy, 1 if re_ else 0, reason if re_ else "", uid, who, ip, t))
            _log(c, fac, "packing", i, "reprinted" if re_ else "printed",
                 (f"copy {copy} · " + (reason or "no reason given")) if re_ else "copy 1", who)
        c.commit()
    return {"ok": True}


# ---------------------------------------------------------------- b497 packing checker: scan the printed slip
_TH_KEYS = dict(zip(
    "_ๅ/-ภถุึคตจขชๆไำพะัีรนยบลฃฟหกดเ้่าสวงผปแอิืทมใฝ%+๑๒๓๔ู฿๕๖๗๘๙๐\"ฎฑธํ๊ณฯญฐ,ฅฤฆฏโฌ็๋ษศซ.()ฉฮฺ์?ฒฬฦ",
    "`1234567890-=qwertyuiop[]\\asdfghjkl;'zxcvbnm,./~!@#$%^&*()_+QWERTYUIOP{}|ASDFGHJKL:\"ZXCVBNM<>?"))
_THAI_RE = re.compile("[\u0e00-\u0e7f]")


def untai(t):
    """A USB scanner 'types' the QR. With the Thai keyboard layout on, {"Id":12 arrives as ฐ.ณก.ซๅ/ —
    put the keys back as the English layout would have typed them."""
    return "".join(_TH_KEYS.get(ch, ch) for ch in t)


def find_slip(c, fac, text):
    i = short_id(text)
    if i is not None:
        return c.execute("SELECT * FROM fg_packing WHERE scode=? AND factory_id=?", (i, fac)).fetchone()
    if looks_short(text):          # FG… but not a whole code -> mixed / mis-read
        return None
    t = fix_scan(text)
    # b523: a QR that is not COMPLETE JSON is refused, not guessed at. With several USB
    # scanners on one PC, two scans at the same instant can mix their characters; reading
    # just the "Id" out of such text could open the WRONG pallet.
    if t.startswith("{"):
        try:
            d = json.loads(t)
            if not isinstance(d, dict):
                return None
        except Exception:
            return None
        k = {str(a).strip().lower(): str(b).strip() for a, b in d.items() if b is not None}
        if k.get("id", "").isdigit():
            r = c.execute("SELECT * FROM fg_packing WHERE id=? AND factory_id=?", (int(k["id"]), fac)).fetchone()
            # the lot on the QR must be the lot of that slip
            if r and (not k.get("lot_no") or (r["lot_no"] or "").strip().upper() == k["lot_no"].upper()):
                return r
            if r:
                return None
    tries = [t]
    if _THAI_RE.search(t) and not re.search(r'"Id"\s*:', t, re.I):
        tries.append(untai(t))
    for s in tries:
        m = re.search(r'"Id"\s*:\s*"?(\d+)', s, re.I)
        if m:
            r = c.execute("SELECT * FROM fg_packing WHERE id=? AND factory_id=?", (int(m.group(1)), fac)).fetchone()
            if r:
                return r
        g = lambda k: (re.search(r'"' + k + r'"\s*:\s*"([^"]*)"', s, re.I) or [None, ""])[1]
        code, lot, pal = g("Product_code"), g("Lot_No"), g("Pallet")
        mr = re.search(r'"Run"\s*:\s*"?(\d+)', s, re.I)
        if code and lot and pal:
            r = c.execute("SELECT * FROM fg_packing WHERE factory_id=? AND pkey=?", (fac, pkey_of(code, lot, pal, int(mr.group(1)) if mr else 1))).fetchone()
            if r:
                return r
        if re.fullmatch(r"\d{8,14}", s):   # old VB slip barcode
            r = c.execute("SELECT * FROM fg_packing WHERE factory_id=? AND legacy_code=?", (fac, s)).fetchone()
            if r:
                return r
    return None


@router.post("/slips-scan")
async def slips_scan(req: Request):
    u, fac, _ = ctx(req, "packcheck")
    b = await req.json()
    via = (b.get("via") or "").strip()[:20]
    auto = bool(b.get("approve"))
    dup, approved_now = False, False
    with closing(conn()) as c:
        r = find_slip(c, fac, b.get("text"))
        if not r:
            # b527: failed scans are history too (all devices see them). A short plain text is a
            # lot number typed to look something up, kept as a look-up, not as a failed scan.
            t = fix_scan(b.get("text") or "").strip()
            if t.startswith("{") or len(t) > 20 or looks_short(t):
                bad = "incomplete"
                if t.startswith("{"):
                    try:
                        json.loads(t)
                        bad = "notfound"
                    except Exception:
                        pass
                else:
                    bad = "incomplete" if looks_short(t) and short_id(t) is None else "notfound"
                _log(c, fac, "packing", 0, "checker_scan_failed", f"{bad}|{via}|{t[:160]}", _who(u))
            elif t:
                _log(c, fac, "packing", 0, "checker_lookup", f"{via}|{t[:40]}", _who(u))
            c.commit()
            raise HTTPException(404, {"msg": "ไม่พบใบพาเลทนี้ (pallet slip not found) — สแกนใหม่ (scan again)"})
        # b524: scanning the slip on the pallet IS the check — approved at once, in the same
        # write, so two scanners (or a phone and a PC) can never approve it twice.
        # A slip scanned before — on this device or any other — is a DUPLICATE: alarm.
        rv = c.execute("SELECT MAX(id) FROM fg_log WHERE factory_id=? AND kind='packing' AND ref_id=? AND action='revived'",
                       (fac, r["id"])).fetchone()[0] or 0          # b531: a revived slip starts fresh
        seen = c.execute("SELECT 1 FROM fg_log WHERE factory_id=? AND kind='packing' AND ref_id=? AND action='checker_scanned' AND id>? LIMIT 1",
                         (fac, r["id"], rv)).fetchone()
        dup = bool(seen) or r["pc_status"] == "approved" or r["status"] != "packed"
        if auto and not dup and r["status"] == "packed" and r["pc_status"] in ("pending", "rejected"):
            blk = _interlock(c, fac, r, u, bool(b.get("offline_at")))     # b553: in order + 2 minutes
            if blk:
                _log(c, fac, "packing", r["id"], "checker_blocked", f"{blk['kind']}|{via}|{blk['msg_en']}", _who(u))
                c.commit()
                raise HTTPException(409, {"msg": blk["msg"], "block": blk, "slip": _slip_out(r)})
        if auto and r["status"] == "packed" and r["pc_status"] in ("pending", "rejected"):
            n = c.execute("UPDATE fg_packing SET pc_status='approved',pc_by=?,pc_at=?,pc_note='' WHERE id=? AND factory_id=?"
                          " AND status='packed' AND pc_status IN ('pending','rejected')", (_who(u), now(), r["id"], fac)).rowcount
            if n:
                approved_now = True
                _log(c, fac, "packing", r["id"], "pack_approve", f"verified by scan ({via})", _who(u))
        off = str(b.get("offline_at") or "")[:40]          # b552: scanned while offline, sent later
        if off:
            try:
                off = datetime.datetime.fromisoformat(off.replace("Z", "+00:00")).astimezone().strftime("%Y-%m-%d %H:%M:%S")
            except Exception:
                off = off[:19]
        _log(c, fac, "packing", r["id"], "checker_scanned", via + (" · DUPLICATE" if dup else "") + (f" · offline scan {off}" if off else ""), _who(u))
        c.commit()
        r = c.execute("SELECT * FROM fg_packing WHERE id=?", (r["id"],)).fetchone()
        log = [dict(x) for x in c.execute(
            "SELECT action,note,user_name,created_at FROM fg_log WHERE factory_id=? AND kind='packing' AND ref_id=? ORDER BY id DESC",
            (fac, r["id"]))]
        prints = [dict(x) for x in c.execute(
            "SELECT copy_no,reprint,reason,user_name,printed_at FROM fg_print_log WHERE factory_id=? AND packing_id=? ORDER BY id DESC",
            (fac, r["id"]))]
        return {"slip": _slip_out(r), "log": log, "prints": prints, "dup": dup, "approved_now": approved_now}


@router.get("/scans")
async def scans_day(req: Request, d: str = ""):
    """b526: the pack checker's scan history for one day, from the server — every PC and phone
    (and admin) sees the same list. One row per slip: last scan time, how many times, who, how."""
    u, fac, _ = ctx(req, "view")
    if not ({"admin", "packcheck", "pack"} & can_set(roles_of(u))):
        raise HTTPException(403, {"msg": "ไม่มีสิทธิ์ (no permission)"})
    d = (d or _today())[:10]
    with closing(conn()) as c:
        ev = c.execute("""SELECT ref_id, MIN(created_at) first_at, MAX(created_at) last_at, COUNT(*) n,
                GROUP_CONCAT(DISTINCT user_name) users, MAX(id) mid FROM fg_log
                WHERE factory_id=? AND kind='packing' AND action='checker_scanned' AND created_at>=? AND created_at<=?
                GROUP BY ref_id ORDER BY last_at DESC LIMIT 2000""", (fac, d, d + " 23:59:59")).fetchall()
        out = []
        for e in ev:
            p = c.execute("SELECT * FROM fg_packing WHERE id=? AND factory_id=?", (e["ref_id"], fac)).fetchone()
            if not p:
                continue
            last = c.execute("SELECT note,user_name FROM fg_log WHERE id=?", (e["mid"],)).fetchone()
            before = c.execute("SELECT 1 FROM fg_log WHERE factory_id=? AND kind='packing' AND ref_id=? AND action='checker_scanned' AND created_at<? LIMIT 1",
                               (fac, e["ref_id"], d)).fetchone()
            out.append({"slip": _slip_out(p), "at": e["last_at"], "first_at": e["first_at"],
                        "n": e["n"] + (1 if before else 0), "users": e["users"] or "",
                        "by": last["user_name"] if last else "", "via": ((last["note"] if last else "") or "").split(" ")[0]})
        ev2 = [dict(x) for x in c.execute(
            """SELECT action,note,user_name,created_at FROM fg_log WHERE factory_id=? AND kind='packing'
               AND action IN ('checker_scan_failed','checker_lookup') AND created_at>=? AND created_at<=? ORDER BY id DESC LIMIT 500""",
            (fac, d, d + " 23:59:59"))]
    other = []
    for e in ev2:
        parts = (e["note"] or "").split("|")
        if e["action"] == "checker_scan_failed":
            other.append({"kind": "failed", "why": parts[0], "via": parts[1] if len(parts) > 1 else "",
                          "text": "|".join(parts[2:]), "by": e["user_name"], "at": e["created_at"]})
        else:
            other.append({"kind": "lookup", "via": parts[0], "text": "|".join(parts[1:]), "by": e["user_name"], "at": e["created_at"]})
    return {"d": d, "rows": out, "other": other}


@router.post("/scans-approve")
async def scans_approve(req: Request):
    """b527: slips that WERE scanned but are still waiting (scanned before scan = approve was
    switched on) are approved here — only slips that really have a scan on record."""
    u, fac, _ = ctx(req, "packcheck")
    b = await req.json()
    ids = [int(i) for i in (b.get("ids") or []) if str(i).isdigit()][:2000]
    who, t, n = _who(u), now(), 0
    with closing(conn()) as c:
        for i in ids:
            if not c.execute("SELECT 1 FROM fg_log WHERE factory_id=? AND kind='packing' AND ref_id=? AND action='checker_scanned' LIMIT 1", (fac, i)).fetchone():
                continue
            k = c.execute("UPDATE fg_packing SET pc_status='approved',pc_by=?,pc_at=?,pc_note='' WHERE id=? AND factory_id=?"
                          " AND status='packed' AND pc_status IN ('pending','rejected')", (who, t, i, fac)).rowcount
            if k:
                n += 1
                _log(c, fac, "packing", i, "pack_approve", "verified by scan (approved from scan history)", who)
        c.commit()
    return {"ok": True, "approved": n}


@router.get("/packing-audit")
async def packing_audit(req: Request, d1: str = "", d2: str = "", user: str = "", action: str = "", q: str = ""):
    """b497: who printed / reprinted / scanned / approved / rejected which pallet slip — per user."""
    u, fac, _ = ctx(req, "view")
    if not ({"admin", "packcheck", "master"} & can_set(roles_of(u))):
        raise HTTPException(403, {"msg": "ไม่มีสิทธิ์ (no permission)"})
    d1, d2 = d1 or _today(), d2 or _today()
    conds, args = ["l.factory_id=?", "l.kind='packing'", "l.created_at>=?", "l.created_at<=?"], [fac, d1, d2 + " 23:59:59"]
    if user:
        conds.append("l.user_name=?")
        args.append(user)
    if action:
        conds.append("l.action=?")
        args.append(action)
    if q:
        conds.append("(p.lot_no LIKE ? OR p.product_code LIKE ? OR p.product_name LIKE ?)")
        args += ["%" + q + "%"] * 3
    w = " AND ".join(conds)
    with closing(conn()) as c:
        rows = [dict(r) for r in c.execute(
            f"""SELECT l.id,l.ref_id,l.action,l.note,l.user_name,l.created_at,p.lot_no,p.pallet_no,p.product_code,p.product_name,
                       COALESCE(p.print_count,0) print_count,p.pc_status,p.status FROM fg_log l LEFT JOIN fg_packing p ON p.id=l.ref_id
                WHERE {w} ORDER BY l.id DESC LIMIT 3000""", tuple(args))]
        summ = [dict(r) for r in c.execute(
            f"""SELECT l.user_name, l.action, COUNT(*) n FROM fg_log l LEFT JOIN fg_packing p ON p.id=l.ref_id
                WHERE {w} GROUP BY l.user_name, l.action""", tuple(args))]
        users = [r["user_name"] for r in c.execute(
            "SELECT DISTINCT user_name FROM fg_log WHERE factory_id=? AND kind='packing' AND user_name<>'' ORDER BY user_name", (fac,))]
    return {"rows": rows, "summary": summ, "users": users, "d1": d1, "d2": d2}


@router.post("/slips/{sid}/cancel")
async def slip_cancel(req: Request, sid: int):
    # b531: only the PACKING page deletes (voids) a slip — the pack checker no longer can.
    # The slip stays in the register, greyed out with the reason, and can be revived.
    u, fac, _ = ctx(req, "view")
    if not ({"pack", "admin"} & can_set(roles_of(u))):
        raise HTTPException(403, {"msg": "ไม่มีสิทธิ์ (no permission)"})
    b = await req.json()
    why = (b.get("note") or "").strip()
    if not why:
        raise HTTPException(400, {"msg": "ใส่เหตุผล (give a reason)"})
    with closing(conn()) as c:
        r = c.execute("SELECT status FROM fg_packing WHERE id=? AND factory_id=?", (sid, fac)).fetchone()
        if not r or r["status"] != "packed":
            raise HTTPException(409, {"msg": "ยกเลิกไม่ได้ — FG รับไปแล้ว (FG already has this pallet)"})
        packing_mark(c, fac, sid, "cancelled", _who(u), why)
        c.commit()
    return {"ok": True}


@router.post("/slips-void")
async def slips_void(req: Request):
    """b531 — Packing page: delete = void. The slip stays (greyed out, "Deleted: reason"),
    is left out of every total, and can be revived later. Not once FG has received it."""
    u, fac, _ = ctx(req, "view")
    if not ({"pack", "admin"} & can_set(roles_of(u))):
        raise HTTPException(403, {"msg": "ไม่มีสิทธิ์ (no permission)"})
    b = await req.json()
    ids = [int(x) for x in (b.get("ids") or []) if str(x).isdigit()][:500]
    why = (b.get("note") or "").strip()[:300]
    if not why:
        raise HTTPException(400, {"msg": "ใส่เหตุผล (give a reason)"})
    done, refused = [], []
    with closing(conn()) as c:
        for i in ids:
            r = c.execute("SELECT status,lot_no,pallet_no FROM fg_packing WHERE id=? AND factory_id=?", (i, fac)).fetchone()
            if not r or r["status"] not in ("packed", "rejected_by_fg"):
                refused.append(f'{r["lot_no"]} #{r["pallet_no"]}' if r else str(i))
                continue
            packing_mark(c, fac, i, "cancelled", _who(u), "ลบแล้ว (Deleted): " + why)
            done.append(i)
        c.commit()
    return {"ok": True, "deleted": done, "refused": refused}


@router.post("/slips/{sid}/revive")
async def slip_revive(req: Request, sid: int):
    """b531 — undo a delete: the slip comes back with the SAME slip number and code, waiting for
    the packing check again (print it again and scan it)."""
    u, fac, _ = ctx(req, "view")
    if not ({"pack", "admin"} & can_set(roles_of(u))):
        raise HTTPException(403, {"msg": "ไม่มีสิทธิ์ (no permission)"})
    with closing(conn()) as c:
        r = c.execute("SELECT * FROM fg_packing WHERE id=? AND factory_id=?", (sid, fac)).fetchone()
        # b5xx: a slip FG rejected can be revived too (rejected by mistake) — back to Packed,
        # same number and code, waiting for the packing check again
        if not r or r["status"] not in ("cancelled", "rejected_by_fg"):
            raise HTTPException(409, {"msg": "ใบนี้ไม่ได้ถูกลบหรือถูก FG ไม่รับ (this slip is not deleted or rejected by FG)"})
        was_fg_reject = r["status"] == "rejected_by_fg"
        if not was_fg_reject and _interlock_on(c, fac):          # b553: a later slip of the lot already passed -> stays deleted
            later = c.execute("""SELECT pallet_no FROM fg_packing WHERE factory_id=? AND product_code=? AND lot_no=?
                AND COALESCE(lot_run,1)=? AND COALESCE(pack_machine,'')=? AND pc_status='approved' AND status<>'cancelled'
                AND CAST(pallet_no AS INTEGER)>? ORDER BY CAST(pallet_no AS INTEGER) LIMIT 1""",
                              (fac, r["product_code"], r["lot_no"], r["lot_run"] or 1, r["pack_machine"] or "", _pint(r["pallet_no"]))).fetchone()
            if later:
                raise HTTPException(409, {"msg": f"กู้คืนไม่ได้ — สแกน #{later['pallet_no']} ไปแล้ว (cannot revive: #{later['pallet_no']} was already scanned)"})
        c.execute("UPDATE fg_packing SET status='packed',status_at=?,status_by=?,note='',pc_status='pending',pc_by='',pc_at='',pc_note='' WHERE id=?",
                  (now(), _who(u), sid))
        _log(c, fac, "packing", sid, "revived",
             "กู้คืนจาก FG ไม่รับ (revived after FG reject)" if was_fg_reject else "กู้คืน (revived)", _who(u))
        c.commit()
        return {"ok": True, "slip": _slip_out(c.execute("SELECT * FROM fg_packing WHERE id=?", (sid,)).fetchone())}


@router.post("/slips-delete")
async def slips_delete(req: Request):
    """b522 — admin only: remove pallet slips for good (test slips, mistakes). A slip FG has
    already received cannot go — its stock record would be left pointing at nothing. Each
    deletion is written to the log with what the slip was, by whom and why."""
    u, fac, _ = ctx(req, "view")
    if "admin" not in roles_of(u):
        raise HTTPException(403, {"msg": "ลบได้เฉพาะผู้ดูแลระบบ (admin only)"})
    b = await req.json()
    ids = [int(x) for x in (b.get("ids") or []) if str(x).isdigit()][:500]
    why = (b.get("note") or "").strip()[:300]
    if not ids:
        raise HTTPException(400, {"msg": "ไม่ได้เลือกใบพาเลท (no slip selected)"})
    if not why:
        raise HTTPException(400, {"msg": "ใส่เหตุผล (give a reason)"})
    done, refused = [], []
    with closing(conn()) as c:
        for sid in ids:
            r = c.execute("SELECT * FROM fg_packing WHERE id=? AND factory_id=?", (sid, fac)).fetchone()
            if not r:
                continue
            r = dict(r)
            name = f"{r.get('lot_no') or ''} #{r.get('pallet_no') or ''}"
            rcv = c.execute("SELECT 1 FROM fg_receive WHERE factory_id=? AND pkey=? AND COALESCE(status,'')"
                            " NOT IN ('cancelled','rejected')", (fac, r.get("pkey") or "")).fetchone() if r.get("pkey") else None
            if r.get("status") == "moved_to_fg" or rcv:
                refused.append(name + " — FG รับแล้ว (already received by FG)")
                continue
            c.execute("DELETE FROM fg_print_log WHERE factory_id=? AND packing_id=?", (fac, sid))
            c.execute("DELETE FROM fg_packing WHERE id=? AND factory_id=?", (sid, fac))
            _log(c, fac, "packing", sid, "deleted",
                 f"{why} · {r.get('product_code') or ''} {name} · {int(_num(r.get('qty')))} bags", _who(u))
            done.append(name)
        c.commit()
    return {"ok": True, "deleted": done, "refused": refused}


@router.post("/slips-check")
async def slip_check(req: Request):
    """Packing-room checker: approve slips (FG may then receive them) or reject with a reason."""
    u, fac, _ = ctx(req, "packcheck")
    b = await req.json()
    ids, action = [int(x) for x in (b.get("ids") or [])], b.get("action")
    note = (b.get("note") or "").strip()[:300]
    via = (b.get("via") or "").strip()[:20]     # b497: 'usb' / 'camera' / 'typed' = verified by scanning the slip
    if action not in ("approve", "reject") or not ids:
        raise HTTPException(400, {"msg": "nothing selected"})
    if action == "reject" and not note:
        raise HTTPException(400, {"msg": "ใส่เหตุผลที่ไม่อนุมัติ (give a reason)"})
    who, done = _who(u), 0
    with closing(conn()) as c:
        for i in ids:
            r = c.execute("SELECT id FROM fg_packing WHERE id=? AND factory_id=? AND status='packed' AND pc_status IN ('pending','rejected')",
                          (i, fac)).fetchone()
            if not r:
                continue
            c.execute("UPDATE fg_packing SET pc_status=?,pc_by=?,pc_at=?,pc_note=? WHERE id=?",
                      ("approved" if action == "approve" else "rejected", who, now(), note, i))
            _log(c, fac, "packing", i, "pack_" + action, (f"verified by scan ({via})" + (" · " + note if note else "")) if via else note, who)
            done += 1
        c.commit()
    return {"ok": True, "done": done}


# ---------------------------------------------------------------- old PalletSlip (VB app) import
def import_palletslip(c, fac, pallet_rows, warehouse_rows, log=print):
    """Copy PalletForm rows of the old VB packing app (SQL Server PalletSlip) into fg_packing.
    Keyed on the old 12-digit Bar_Code, so it can be re-run. A slip that is also in
    WarehouseData counts as already moved to FG; Approved/Rejected keep the packing check."""
    ensure(c)
    moved = {str(r.get("Bar_Code") or "").strip() for r in warehouse_rows}
    have = {r[0] for r in c.execute("SELECT legacy_code FROM fg_packing WHERE factory_id=? AND legacy_code<>''", (fac,))}
    k = skipped = 0
    for r in pallet_rows:
        bc = str(r.get("Bar_Code") or "").strip()
        if not bc or bc in have:
            skipped += 1
            continue
        code, lot, sn = (r.get("Formula_Code") or "").strip(), (r.get("Lot_No") or "").strip(), str(r.get("Slip_No") or "").strip()
        bags = _num(r.get("Total_Bag_No"))
        wu = bag_kg(r.get("Bag_Weight"))
        pc = "approved" if str(r.get("Approved", "")).lower() == "yes" else ("rejected" if str(r.get("Rejected", "")).lower() == "yes" else "pending")
        st = "moved_to_fg" if bc in moved else "packed"
        d = _d(r.get("Date"))
        t = _t(r.get("Time"))
        pkey = pkey_of(code, lot, sn)
        if c.execute("SELECT 1 FROM fg_packing WHERE factory_id=? AND pkey=?", (fac, pkey)).fetchone():
            pkey = pkey + "|" + bc                      # an old duplicate slip number — keep both
        c.execute("""INSERT INTO fg_packing(factory_id,pkey,lot_no,pallet_no,slip_no,product_code,product_name,qty,unit,
            weight_unit,bag_weight,total_weight,mfg,exp,doc_no,pack_machine,pd_line,pack_type,station,operator,staff_name,
            raw_qr,packed_at,src,status,status_at,status_by,pc_status,pc_by,pc_at,legacy_code,created_by)
            VALUES(?,?,?,?,?,?,?,?,'กระสอบ',?,?,?,?,?,?,?,?,?,?,?,?,'',?,'palletslip',?,?,?,?,?,?,?,'PalletSlip')""",
            (fac, pkey, lot, sn, int(_num(sn)), code, r.get("Formula_Name", ""), bags, wu, r.get("Bag_Weight", ""),
             _num(r.get("TotalWeight")) or wu * bags, _any_date(r.get("MFG_Date")), _any_date(r.get("Expiry_Date")),
             r.get("Document_No", ""), r.get("Pack_No", ""), r.get("PD_Line", ""), r.get("Pack_Type", ""), r.get("Pack_No", ""),
             r.get("Staff_Name", ""), r.get("Staff_Name", ""), (d + " " + t).strip(), st,
             (d + " " + t).strip() if st == "moved_to_fg" else "", "old system" if st == "moved_to_fg" else "",
             pc, r.get("Approved_by") or r.get("Rejected_by") or "", r.get("Approved_DT") or r.get("Rejected_DT") or "", bc))
        have.add(bc)
        k += 1
    c.commit()
    log(f"[fg] PalletSlip import into plant {fac}: +{k} slips ({skipped} skipped, {len(moved)} in WarehouseData)")
    return {"added": k, "skipped": skipped}


def _any_date(s):
    """Old slips typed dates by hand: 14/10/2026, 14 10 2026, 2026-10-14, 10/14/2026 …"""
    s = (s or "").strip()
    if not s:
        return ""
    m = re.match(r"^(\d{4})[-/ .](\d{1,2})[-/ .](\d{1,2})", s)
    if m:
        y, mo, d = int(m.group(1)), int(m.group(2)), int(m.group(3))
    else:
        m = re.match(r"^(\d{1,2})[-/ .](\d{1,2})[-/ .](\d{2,4})", s)
        if not m:
            return ""
        d, mo, y = int(m.group(1)), int(m.group(2)), int(m.group(3))
        if mo > 12 and d <= 12:
            d, mo = mo, d
    if y < 100:
        y += 2000
    if y > 2400:
        y -= 543                                          # Thai Buddhist year
    try:
        return datetime.date(y, mo, d).isoformat()
    except ValueError:
        return ""

