# Cloudflare credentials for deploy/start_tunnel.py
# Copy this file to  secrets.env  in the same folder and put your token in it.
# secrets.env is in .gitignore - it never goes into git.
#
# Account API tokens start with cfat_ , user API tokens with cfut_ . Either works.
# No quotes, no spaces around the = sign.

CF_API_TOKEN=cfat_paste_your_token_here

# Optional - only if these ever change:
# CF_ACCOUNT_ID=
# CF_KV_NAMESPACE_ID=
# CF_WORKER_URL=https://cmms.bflgroup.workers.dev
# CF_PROTOCOL=http2
