<?xml version="1.0" encoding="UTF-8"?>
<!--
  BFL Smart Factory (CMMS) - IIS front door for https://cmms.bluefalo.co.th
  Put this file as web.config in the CMMS IIS site folder (e.g. C:\inetpub\cmms\web.config).
  Needs: IIS URL Rewrite 2.1 + Application Request Routing (ARR) 3.0, proxy enabled.
  CHANGE 192.168.1.50 below to the LAN IP of the PC that runs the CMMS (python run.py, port 8000).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1. Anything on http:// goes to https:// (Let's Encrypt renewal path is left alone) -->
        <rule name="CMMS http to https" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/acme-challenge/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- 2. Everything else is passed to the CMMS server -->
        <rule name="CMMS reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/\.well-known/acme-challenge/" negate="true" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://192.168.1.50:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- photos, Excel imports, PDFs: allow up to 100 MB per request -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
